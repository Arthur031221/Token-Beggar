+class FootnoteReorderingProcessor(Treeprocessor):
+    """ Reorder and renumber footnotes by the order in which they are referenced. """
+
+    def __init__(self, footnotes: FootnoteExtension):
+        self.footnotes = footnotes
+
+    def find_refs(self, elements, hrefs: dict[str, str]) -> list[str]:
+        """ Return the footnote ids referenced by the footnote links among `elements`, in order. """
+        refs = []
+        for el in elements:
+            if el.tag == 'a' and el.get('class') == 'footnote-ref' and el.get('href') in hrefs:
+                refs.append(hrefs[el.get('href')])
+        return refs
+
+    def run(self, root: etree.Element) -> None:
+        if self.footnotes.getConfig("USE_DEFINITION_ORDER") or not self.footnotes.footnotes:
+            return
+
+        div = None
+        for el in root.iter('div'):
+            if el.get('class', '') == 'footnote':
+                div = el
+                break
+        if div is None:
+            return
+        ol = div.find('ol')
+        if ol is None:
+            return
+
+        ids = list(self.footnotes.footnotes.keys())
+        hrefs = {'#' + self.footnotes.makeFootnoteId(id): id for id in ids}
+        items = {li.get('id'): li for li in ol.findall('li')}
+
+        # Footnotes ordered in previous runs (without a `reset`) keep their place.
+        order = [id for id in self.footnotes.footnote_order if id in self.footnotes.footnotes]
+        seen = set(order)
+
+        def add(refs: list[str]) -> None:
+            for id in refs:
+                if id not in seen:
+                    seen.add(id)
+                    order.append(id)
+
+        # References in the document body, in document order.
+        in_div = set(div.iter())
+        add(self.find_refs((el for el in root.iter() if el not in in_div), hrefs))
+        # References which only occur within other footnotes, in the order those footnotes appear.
+        i = 0
+        while i < len(order):
+            li = items.get(self.footnotes.makeFootnoteId(order[i]))
+            if li is not None:
+                add(self.find_refs(li.iter(), hrefs))
+            i += 1
+        # Footnotes which are never referenced, in definition order.
+        add(ids)
+        self.footnotes.footnote_order = order
+
+        numbers = {id: index for index, id in enumerate(order, start=1)}
+
+        # Renumber the references.
+        superscript_text = self.footnotes.getConfig("SUPERSCRIPT_TEXT")
+        for el in root.iter('a'):
+            if el.get('class') == 'footnote-ref' and el.get('href') in hrefs:
+                el.text = superscript_text.format(numbers[hrefs[el.get('href')]])
+
+        # Reorder and renumber the footnote definitions.
+        backlink_title = self.footnotes.getConfig("BACKLINK_TITLE").replace("%d", "{}")
+        for li in list(ol):
+            ol.remove(li)
+        for id in order:
+            li = items.get(self.footnotes.makeFootnoteId(id))
+            if li is None:
+                continue
+            for link in li.iter('a'):
+                if link.get('class') == 'footnote-backref':
+                    link.set('title', backlink_title.format(numbers[id]))
+            ol.append(li)
+
+
 class FootnoteTreeprocessor(Treeprocessor):
     """ Build and append footnote div to end of document. """
 

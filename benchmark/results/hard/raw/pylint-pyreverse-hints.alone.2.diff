+def test_class_diagram_type_hints():
+    module = astroid.parse(
+        """
+        class Other:
+            pass
+
+        class C:
+            klass_attr: int = 3
+
+            def __init__(self, c: Other, d, a: str = None, b: Other = None, e=1):
+                self.a = a
+                self.b = b
+                self.c = c
+                self.d: "Other" = d
+                self.e = e
+        """,
+        module_name="typed",
+    )
+    project = Project("typed")
+    project.add_module(module)
+    linker = Linker(project)
+    handler = DiadefsHandler(Config())
+    (diagram,) = DefaultDiadefGenerator(linker, handler).visit(project)
+    diagram.extract_relationships()
+    klass = diagram.classe("C")
+    # Annotations resolving to a class of the diagram are drawn as associations
+    # instead of being written in the attribute label
+    assert klass.attrs == [
+        "a : Optional[str]",
+        "b : Optional[Other]",
+        "c",
+        "d",
+        "e : int",
+        "klass_attr : int",
+    ]
+    associations = {
+        (rel.from_object.title, rel.to_object.title, rel.name)
+        for rel in diagram.relationships["association"]
+    }
+    assert associations == {("Other", "C", "c"), ("Other", "C", "d")}

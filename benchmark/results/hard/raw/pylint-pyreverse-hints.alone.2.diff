 RCFILE = ".pyreverserc"
 
@@ -213,3 +216,135 @@ class LocalsVisitor(ASTWalker):
         if methods[1] is not None:
             return methods[1](node)
         return None
+
+
+# Type annotations ############################################################
+
+_OPTIONAL_NAMES = {"Optional", "typing.Optional"}
+_UNION_NAMES = {"Union", "typing.Union"}
+
+
+def _is_none(node) -> bool:
+    return isinstance(node, astroid.Const) and node.value is None
+
+
+def _is_optional(annotation) -> bool:
+    """Return True if the annotation already accepts ``None``"""
+    if _is_none(annotation):
+        return True
+    if isinstance(annotation, astroid.Subscript):
+        base = annotation.value.as_string()
+        if base in _OPTIONAL_NAMES:
+            return True
+        if base in _UNION_NAMES:
+            elements = annotation.slice
+            if isinstance(elements, astroid.Index):  # Python < 3.9
+                elements = elements.value
+            if isinstance(elements, astroid.Tuple):
+                return any(_is_optional(elt) for elt in elements.elts)
+            return _is_optional(elements)
+    if isinstance(annotation, astroid.BinOp) and annotation.op == "|":
+        return _is_optional(annotation.left) or _is_optional(annotation.right)
+    return False
+
+
+def get_annotation_label(annotation) -> str:
+    """Return a printable label for the given annotation node"""
+    if isinstance(annotation, astroid.Const) and isinstance(annotation.value, str):
+        # Forward reference, e.g. ``x: "MyClass"``
+        return annotation.value
+    return annotation.as_string()
+
+
+def _get_argument_annotation(function: astroid.FunctionDef, name: str):
+    """Return the (annotation, default value) of the argument ``name`` of ``function``
+
+    Either value is None if the argument is not annotated or has no default.
+    """
+    args = function.args
+    annotated_args = list(zip(args.posonlyargs, args.posonlyargs_annotations))
+    annotated_args += zip(args.args or [], args.annotations)
+    annotated_args += zip(args.kwonlyargs, args.kwonlyargs_annotations)
+    for arg, annotation in annotated_args:
+        if arg.name != name:
+            continue
+        try:
+            default = args.default_value(name)
+        except astroid.NoDefault:
+            default = None
+        return annotation, default
+    return None, None
+
+
+def _get_raw_annotation(node: Union[astroid.AssignAttr, astroid.AssignName]):
+    """Return the (annotation, assigned value) for an assignment target, if any"""
+    assign = node.parent
+    if isinstance(assign, astroid.AnnAssign):
+        # x: int = 3  /  self.x: int = 3
+        return assign.annotation, assign.value
+    if isinstance(assign, astroid.Assign) and isinstance(assign.value, astroid.Name):
+        # self.x = x, where ``x`` is an annotated argument of the current function
+        value = assign.value
+        function = node.frame()
+        if not isinstance(function, astroid.FunctionDef):
+            return None, None
+        _, assignments = value.lookup(value.name)
+        if not any(
+            assignment.parent is function.args
+            for assignment in assignments
+            if isinstance(assignment, astroid.AssignName)
+        ):
+            return None, None
+        return _get_argument_annotation(function, value.name)
+    return None, None
+
+
+def get_annotation(
+    node: Union[astroid.AssignAttr, astroid.AssignName, astroid.NodeNG]
+) -> Optional[astroid.Name]:
+    """Return the type annotation of the given assignment, as a ``Name`` node
+    whose name is the printable annotation label.
+
+    ``node`` is an assignment target (or the value of an annotated
+    assignment). The annotation is either an explicit one
+    (``self.x: int = 0``) or the annotation of the function argument the
+    target is assigned from (``def __init__(self, x: int): self.x = x``).
+    When the default value is ``None`` and the annotation does not already
+    allow it, the label is wrapped in ``Optional[...]``.
+    Returns None if no annotation is found.
+    """
+    annotation, default = _get_raw_annotation(node)
+    if annotation is None:
+        return None
+    label = get_annotation_label(annotation)
+    if _is_none(default) and not _is_optional(annotation):
+        label = f"Optional[{label}]"
+    return astroid.Name(
+        name=label,
+        lineno=annotation.lineno,
+        col_offset=annotation.col_offset,
+        parent=annotation.parent,
+    )
+
+
+def get_annotation_classes(annotation: astroid.Name) -> List[astroid.ClassDef]:
+    """Return the classes an annotation label returned by ``get_annotation``
+    refers to, if it can be resolved (e.g. ``MyClass`` but not ``List[MyClass]``)"""
+    try:
+        return [
+            klass for klass in annotation.infer() if isinstance(klass, astroid.ClassDef)
+        ]
+    except astroid.InferenceError:
+        return []
+
+
+def infer_node(node: Union[astroid.AssignAttr, astroid.AssignName]) -> Set:
+    """Return a set containing the type annotation of the node if it exists,
+    otherwise the set of values inferred for it."""
+    annotation = get_annotation(node)
+    if annotation is not None:
+        return {annotation}
+    try:
+        return set(node.infer())
+    except astroid.InferenceError:
+        return set()

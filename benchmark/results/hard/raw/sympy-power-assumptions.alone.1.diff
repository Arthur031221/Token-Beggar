+
+def test_integer_implies_finite():
+    for kw in ['integer', 'even', 'odd', 'prime', 'composite']:
+        x = Symbol('x', **{kw: True})
+        assert x.is_finite is True
+        assert x.is_infinite is False
+    # an infinite symbol cannot be an integer
+    i = Symbol('i', infinite=True)
+    assert i.is_integer is False
+    assert i.is_even is False
+    assert i.is_odd is False
+    assert i.is_prime is False
+    f = Symbol('f', finite=False)
+    assert f.is_integer is False

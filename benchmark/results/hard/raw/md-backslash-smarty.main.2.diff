+class TestUnescapePostprocessorDeprecation(unittest.TestCase):
+    """ Test that `UnescapePostprocessor` is deprecated but still functional. """
+
+    def test_deprecation_warning(self):
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter('always')
+            processor = markdown.postprocessors.UnescapePostprocessor()
+        self.assertEqual(len(w), 1)
+        self.assertTrue(issubclass(w[-1].category, DeprecationWarning))
+        self.assertEqual(processor.run('a\u000234\u0003b'), 'a"b')
+
+    def test_not_registered_by_default(self):
+        md = markdown.Markdown()
+        self.assertNotIn('unescape', md.postprocessors)
+        self.assertIn('unescape', md.treeprocessors)

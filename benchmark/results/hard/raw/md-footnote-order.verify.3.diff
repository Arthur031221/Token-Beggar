+    def reorder_footnotes(self, root: etree.Element, ol: etree.Element) -> None:
+        """ Number and order footnotes by first reference; unreferenced footnotes follow in definition order. """
+        ids = {self.footnotes.makeFootnoteId(id): id for id in self.footnotes.footnotes}
+        # The inline processor may not visit references in document order, so fix the order here.
+        order: list[str] = []
+        refs = []
+        for link in root.iter('a'):
+            if link.attrib.get('class', '') == 'footnote-ref':
+                id = ids.get(link.attrib.get('href', '')[1:])
+                if id is not None:
+                    if id not in order:
+                        order.append(id)
+                    refs.append((link, id))
+        superscript = self.footnotes.getConfig("SUPERSCRIPT_TEXT")
+        for link, id in refs:
+            link.text = superscript.format(order.index(id) + 1)
+        positions = {self.footnotes.makeFootnoteId(id): index for index, id in enumerate(order)}
+        items = sorted(list(ol), key=lambda li: positions.get(li.attrib.get('id', ''), len(order)))
+        # Backward compatibility with old '%d' placeholder
+        backlink_title = self.footnotes.getConfig("BACKLINK_TITLE").replace("%d", "{}")
+        for index, li in enumerate(items, start=1):
+            for link in li.iter('a'):
+                if link.attrib.get('class', '') == 'footnote-backref':
+                    link.attrib['title'] = backlink_title.format(index)
+                    break
+        ol[:] = items
+
     def get_num_duplicates(self, li: etree.Element) -> int:
         """ Get the number of duplicate refs of the footnote. """
         fn, rest = li.attrib.get('id', '').split(self.footnotes.get_separator(), 1)

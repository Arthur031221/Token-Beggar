@@ -336,3 +336,73 @@ class TestFootnotes(TestCase):
             '</div>',
             extension_configs={'footnotes': {'SUPERSCRIPT_TEXT': '[{}]'}}
         )
+
+    def test_reference_order(self):
+        """Test footnotes are ordered by first reference by default."""
+
+        self.assertMarkdownRenders(
+            'Defined[^second] then occurrence[^first].\n\n[^first]: blah\n[^second]: blurb',
+            '<p>Defined<sup id="fnref:second"><a class="footnote-ref" href="#fn:second">1</a></sup>'
+            ' then occurrence<sup id="fnref:first"><a class="footnote-ref" href="#fn:first">2</a></sup>.</p>\n'
+            '<div class="footnote">\n'
+            '<hr />\n'
+            '<ol>\n'
+            '<li id="fn:second">\n'
+            '<p>blurb&#160;<a class="footnote-backref" href="#fnref:second"'
+            ' title="Jump back to footnote 1 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '<li id="fn:first">\n'
+            '<p>blah&#160;<a class="footnote-backref" href="#fnref:first"'
+            ' title="Jump back to footnote 2 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '</ol>\n'
+            '</div>'
+        )
+
+    def test_definition_order(self):
+        """Test `USE_DEFINITION_ORDER` restores definition order."""
+
+        self.assertMarkdownRenders(
+            'Defined[^second] then occurrence[^first].\n\n[^first]: blah\n[^second]: blurb',
+            '<p>Defined<sup id="fnref:second"><a class="footnote-ref" href="#fn:second">2</a></sup>'
+            ' then occurrence<sup id="fnref:first"><a class="footnote-ref" href="#fn:first">1</a></sup>.</p>\n'
+            '<div class="footnote">\n'
+            '<hr />\n'
+            '<ol>\n'
+            '<li id="fn:first">\n'
+            '<p>blah&#160;<a class="footnote-backref" href="#fnref:first"'
+            ' title="Jump back to footnote 1 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '<li id="fn:second">\n'
+            '<p>blurb&#160;<a class="footnote-backref" href="#fnref:second"'
+            ' title="Jump back to footnote 2 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '</ol>\n'
+            '</div>',
+            extension_configs={'footnotes': {'USE_DEFINITION_ORDER': True}}
+        )
+
+    def test_reference_order_unreferenced(self):
+        """Test unreferenced footnotes are listed last in definition order."""
+
+        self.assertMarkdownRenders(
+            'Text[^c]\n\n[^a]: A\n[^b]: B\n[^c]: C',
+            '<p>Text<sup id="fnref:c"><a class="footnote-ref" href="#fn:c">1</a></sup></p>\n'
+            '<div class="footnote">\n'
+            '<hr />\n'
+            '<ol>\n'
+            '<li id="fn:c">\n'
+            '<p>C&#160;<a class="footnote-backref" href="#fnref:c"'
+            ' title="Jump back to footnote 1 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '<li id="fn:a">\n'
+            '<p>A&#160;<a class="footnote-backref" href="#fnref:a"'

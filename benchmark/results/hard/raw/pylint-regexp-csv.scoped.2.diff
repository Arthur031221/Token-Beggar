 from typing import (
     TYPE_CHECKING,
@@ -253,6 +253,45 @@ def _check_csv(value: list[str] | tuple[str] | str) -> Sequence[str]:
     return _splitstrip(value)
 
 
+def _check_regexp_csv(value: list[str] | tuple[str] | str) -> Iterable[str]:
+    r"""Split a comma separated string of regular expressions.
+
+    Commas inside ``{...}`` (quantifiers) and escaped commas (``\,``, which is
+    a valid regex for a literal comma and is kept as is) do not split.
+
+    >>> list(_check_regexp_csv("foo{1,3}, bar"))
+    ['foo{1,3}', 'bar']
+    """
+    if isinstance(value, (list, tuple)):
+        yield from value
+        return
+    current: list[str] = []
+    depth = 0
+    i = 0
+    while i < len(value):
+        char = value[i]
+        if char == "\\" and i + 1 < len(value):
+            current.append(value[i : i + 2])
+            i += 2
+            continue
+        if char == "{":
+            depth += 1
+        elif char == "}" and depth:
+            depth -= 1
+        elif char == "," and depth == 0:
+            word = "".join(current).strip()
+            if word:
+                yield word
+            current = []
+            i += 1
+            continue
+        current.append(char)
+        i += 1
+    word = "".join(current).strip()
+    if word:
+        yield word
+
+
 def _comment(string: str) -> str:
     """Return string as a comment."""
     lines = [line.strip() for line in string.splitlines()]

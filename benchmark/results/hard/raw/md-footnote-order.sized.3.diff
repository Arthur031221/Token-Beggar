+class FootnoteReorderingProcessor(Treeprocessor):
+    """ Number and order footnotes by the order of their first reference in the document. """
+
+    def __init__(self, footnotes: FootnoteExtension):
+        self.footnotes = footnotes
+
+    def iter_refs(self, element: etree.Element, skip: etree.Element | None = None) -> Iterator[etree.Element]:
+        """ Yield footnote reference links in document order, ignoring the `skip` subtree. """
+        for child in element:
+            if child is skip:
+                continue
+            if child.tag == 'a' and child.attrib.get('class', '') == 'footnote-ref':
+                yield child
+            yield from self.iter_refs(child, skip)
+
+    def find_footnotes_div(self, root: etree.Element) -> etree.Element | None:
+        """ Return the footnote `div` if present. """
+        for div in root.iter('div'):
+            if div.attrib.get('class', '') == 'footnote':
+                return div
+        return None
+
+    def run(self, root: etree.Element) -> None:
+        if self.footnotes.getConfig("USE_DEFINITION_ORDER") or not self.footnotes.footnotes:
+            return
+        div = self.find_footnotes_div(root)
+        if div is None:
+            return
+        ol = div.find('ol')
+        if ol is None:
+            return
+
+        ids = {self.footnotes.makeFootnoteId(id): id for id in self.footnotes.footnotes}
+        items = {ids[li.attrib['id']]: li for li in ol if li.attrib.get('id') in ids}
+
+        order: list[str] = []
+        seen: set[str] = set()
+
+        def add_refs(element: etree.Element, skip: etree.Element | None = None) -> None:
+            for link in self.iter_refs(element, skip):
+                id = ids.get(link.attrib.get('href', '')[1:])
+                if id is not None and id not in seen:
+                    seen.add(id)
+                    order.append(id)
+
+        # References in the body of the document come first, in document order.
+        add_refs(root, skip=div)
+        # Then any footnotes referenced only from within other footnotes, in order of
+        # appearance within the already ordered footnotes. Footnotes which are never
+        # referenced are placed last in the order in which they are defined.
+        index = 0
+        definitions = iter(self.footnotes.footnotes)
+        while True:
+            while index < len(order):
+                if order[index] in items:
+                    add_refs(items[order[index]])
+                index += 1
+            id = next((id for id in definitions if id not in seen), None)
+            if id is None:
+                break
+            seen.add(id)
+            order.append(id)
+
+        numbers = {id: num for num, id in enumerate(order, start=1)}
+
+        # Renumber all references, including those within footnotes.
+        for link in self.iter_refs(root):
+            id = ids.get(link.attrib.get('href', '')[1:])
+            if id is not None:
+                link.text = self.footnotes.getConfig("SUPERSCRIPT_TEXT").format(numbers[id])
+
+        # Reorder the footnotes and update the titles of their backlinks.
+        backlink_title = self.footnotes.getConfig("BACKLINK_TITLE").replace("%d", "{}")
+        for li in items.values():
+            ol.remove(li)
+        for id in order:
+            li = items.get(id)
+            if li is None:
+                continue
+            ol.append(li)
+            for link in li.iter('a'):
+                if link.attrib.get('class', '') == 'footnote-backref':
+                    link.set('title', backlink_title.format(numbers[id]))
+
+

+    def test_pep_751_set_markers(self, variable, marker_string, environment, expected):
+        env = None if environment is None else {variable: environment}
+        marker = Marker(marker_string.format(variable))
+        assert marker.evaluate(env, context="lock_file") is expected
+
+    def test_pep_751_extras_and_dependency_groups(self):
+        marker = Marker('"test" in dependency_groups and "cli" in extras')
+        assert str(marker) == '"test" in dependency_groups and "cli" in extras'
+        assert marker.evaluate(
+            {"extras": {"cli"}, "dependency_groups": {"test"}}, context="lock_file"
+        )
+        assert not marker.evaluate(
+            {"extras": {"test"}, "dependency_groups": {"cli"}}, context="lock_file"
+        )
+

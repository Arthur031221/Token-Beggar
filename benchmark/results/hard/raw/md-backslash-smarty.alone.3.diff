+Started by Manfred Stienstra (http://www.dwerg.net/).
+Maintained for a few years by Yuri Takhteyev (http://www.freewisdom.org).
+Currently maintained by Waylan Limberg (https://github.com/waylan),
+Dmitry Shachnev (https://github.com/mitya57) and Isaac Muse (https://github.com/facelessuser).
+
+Copyright 2007-2022 The Python Markdown Project (v. 1.7 and later)
+Copyright 2004, 2005, 2006 Yuri Takhteyev (v. 0.2-1.6b)
+Copyright 2004 Manfred Stienstra (the original version)
+
+License: BSD (see LICENSE.md for details).
+"""
+
+from markdown.test_tools import TestCase
+
+
+class TestSmarty(TestCase):
+
+    default_kwargs = {'extensions': ['smarty']}
+
+    def test_escaped_double_quote_in_text(self):
+        self.assertMarkdownRenders(
+            r'x\"x',
+            '<p>x"x</p>'
+        )
+
+    def test_escaped_single_quote_in_text(self):
+        self.assertMarkdownRenders(
+            r"x\'x",
+            "<p>x'x</p>"
+        )
+
+    def test_unescaped_double_quote_in_image_alt(self):
+        self.assertMarkdownRenders(
+            '![x"x](x)',
+            '<p><img alt="x&quot;x" src="x" /></p>'
+        )
+
+    def test_escaped_double_quote_in_image_alt(self):
+        self.assertMarkdownRenders(
+            r'![x\"x](x)',
+            '<p><img alt="x&quot;x" src="x" /></p>'
+        )
+
+    def test_escaped_single_quote_in_image_alt(self):
+        self.assertMarkdownRenders(
+            r"![x\'x](x)",
+            '<p><img alt="x\'x" src="x" /></p>'
+        )
+
+    def test_escaped_double_quote_in_image_title(self):
+        self.assertMarkdownRenders(
+            r'![x](x "x\"x")',
+            '<p><img alt="x" src="x" title="x&quot;x" /></p>'
+        )
+
+    def test_escaped_double_quote_in_link(self):
+        self.assertMarkdownRenders(
+            r'[x\"x](x\"x "x\"x")',
+            '<p><a href="x&quot;x" title="x&quot;x">x"x</a></p>'
+        )
+
+    def test_escaped_double_quote_in_attr_list(self):
+        self.assertMarkdownRenders(
+            'x\n{: title="x\\"x" }',
+            '<p title="x&quot;x">x</p>',
+            extensions=['smarty', 'attr_list']
+        )

@@ -0,0 +1,155 @@
+# Licensed under the GPL: https://www.gnu.org/licenses/old-licenses/gpl-2.0.html
+# For details: https://github.com/PyCQA/pylint/blob/master/LICENSE
+
+"""Tests for the use of type hints by pyreverse"""
+
+import astroid
+import pytest
+
+from pylint.pyreverse.diagrams import ClassDiagram
+from pylint.pyreverse.inspector import Linker
+from pylint.pyreverse.utils import get_annotation, get_type_label, infer_node
+from pylint.pyreverse.writer import DotWriter
+
+
+@pytest.mark.parametrize(
+    "assign, label",
+    [
+        ("a: str = None", "Optional[str]"),
+        ("a: str = 'mystr'", "str"),
+        ("a: str", "str"),
+        ("a: 'MyClass' = None", "Optional[MyClass]"),
+        ("a: Optional[str] = 'str'", "Optional[str]"),
+        ("a: Optional[str] = None", "Optional[str]"),
+        ("a: typing.Optional[str] = None", "typing.Optional[str]"),
+        ("a: Union[str, None] = None", "Union[str, None]"),
+        ("a: List[int] = None", "Optional[List[int]]"),
+    ],
+)
+def test_get_type_label_annassign(assign, label):
+    node = astroid.extract_node(assign)
+    assert isinstance(node, astroid.AnnAssign)
+    assert get_annotation(node.target) is node.annotation
+    assert get_type_label(node.target) == label
+
+
+@pytest.mark.parametrize(
+    "init_method, label",
+    [
+        ("def __init__(self, x: str):                   self.x = x", "str"),
+        ("def __init__(self, x: str = 'str'):           self.x = x", "str"),
+        ("def __init__(self, x: str = None):            self.x = x", "Optional[str]"),
+        ("def __init__(self, x: Optional[str]):         self.x = x", "Optional[str]"),
+        ("def __init__(self, x: Optional[str] = None):  self.x = x", "Optional[str]"),
+        ("def __init__(self, x: Optional[str] = 'str'): self.x = x", "Optional[str]"),
+        ("def __init__(self, *, x: int = None):         self.x = x", "Optional[int]"),
+        ("def __init__(self, x: str = None):            self.x: int = x", "int"),
+        ("def __init__(self, x):                        self.x = x", None),
+        ("def __init__(self, x: str):                   self.x = x.upper()", None),
+    ],
+)
+def test_get_type_label_assignattr(init_method, label):
+    klass = astroid.extract_node(
+        f"""
+        class A:
+            {init_method}
+        """
+    )
+    (assign_attr,) = klass.instance_attrs["x"]
+    assert isinstance(assign_attr, astroid.AssignAttr)
+    assert get_type_label(assign_attr) == label
+
+
+def test_get_type_label_reassigned_argument():
+    """the type hint of an argument is not used once it has been reassigned"""
+    klass = astroid.extract_node(
+        """
+        class A:
+            def __init__(self, x: str):
+                x = 42
+                self.x = x
+        """
+    )
+    (assign_attr,) = klass.instance_attrs["x"]
+    assert get_annotation(assign_attr) is None
+    assert get_type_label(assign_attr) is None
+
+
+def test_infer_node_uses_type_hint():
+    klass = astroid.extract_node(
+        """
+        class Foo:
+            pass
+
+        class A:
+            def __init__(self, foo: Foo = None):
+                self.foo = foo
+                self.other: Foo = Foo()
+        """
+    )
+    (foo,) = klass.instance_attrs["foo"]
+    inferred = infer_node(foo)
+    assert any(
+        isinstance(value, astroid.Instance) and value.name == "Foo"
+        for value in inferred
+    )
+    # The instance inferred from the value is not duplicated by the type hint
+    (other,) = klass.instance_attrs["other"]
+    assert [value.name for value in infer_node(other)] == ["Foo"]
+
+
+def _class_diagram(code):
+    module = astroid.parse(code)
+    Linker(module).visit(module)
+    diagram = ClassDiagram("test", "ALL")
+    klass = module["C"]
+    diagram.add_object(klass.name, klass)
+    diagram.extract_relationships()
+    return diagram.objects[0]
+
+
+def test_class_diagram_attributes_use_type_hints():
+    obj = _class_diagram(
+        """
+        class C(object):
+            cls_attr: int = None
+            untyped = 1
+
+            def __init__(self, a: str = None, b: "C" = None, c=None):
+                self.a = a
+                self.b = b
+                self.c = c
+
+            @property
+            def prop(self) -> float:
+                return 1.0
+
+            @property
+            def untyped_prop(self):
+                return 1.0
+        """
+    )
+    assert obj.attrs == [
+        "a : Optional[str]",
+        "b : Optional[C]",
+        "c : NoneType",
+        "cls_attr : Optional[int]",
+        "prop : float",
+        "untyped : int",
+        "untyped_prop",
+    ]
+
+
+def test_dot_writer_method_arguments_use_type_hints():
+    obj = _class_diagram(
+        """
+        class C(object):
+            def method(self, a: int, b, c: "C" = None):
+                pass
+        """
+    )
+    assert DotWriter._get_method_arguments(obj.methods[0]) == [
+        "a: int",
+        "b",
+        "c: C",
+    ]

+def _get_argument_annotation(func, name):
+    """return the annotation and the default value of the argument ``name``
+    of the function ``func``, as a ``(annotation, default)`` tuple
+    """
+    arguments = func.args
+    if arguments.args is None:  # function built from a living object
+        return None, None
+    for args, annotations in (
+        (arguments.posonlyargs, arguments.posonlyargs_annotations),
+        (arguments.args, arguments.annotations),
+        (arguments.kwonlyargs, arguments.kwonlyargs_annotations),
+    ):
+        for arg, annotation in zip(args, annotations):
+            if arg.name != name:
+                continue
+            try:
+                default = arguments.default_value(name)
+            except astroid.NoDefault:
+                default = None
+            return annotation, default
+    return None, None
+
+
+def _get_annotation_and_value(
+    node: Union[astroid.AssignAttr, astroid.AssignName]
+) -> tuple:
+    """return the annotation of an assignment target and the node of the
+    value it is assigned (or its default value when the assigned value is an
+    annotated argument), as a ``(annotation, value)`` tuple
+    """
+    parent = node.parent
+    if isinstance(parent, astroid.AnnAssign) and parent.target is node:
+        return parent.annotation, parent.value
+    if (
+        isinstance(node, astroid.AssignAttr)
+        and isinstance(parent, astroid.Assign)
+        and isinstance(parent.value, astroid.Name)
+    ):
+        # self.attr = arg, where ``arg`` is an annotated argument of the method
+        func = node.scope()
+        if not isinstance(func, astroid.FunctionDef):
+            return None, None
+        _, assignments = parent.value.lookup(parent.value.name)
+        if len(assignments) == 1 and assignments[0].parent is func.args:
+            return _get_argument_annotation(func, parent.value.name)
+    return None, None
+
+
+def get_annotation(
+    node: Union[astroid.AssignAttr, astroid.AssignName]
+) -> Optional[astroid.node_classes.NodeNG]:
+    """return the type annotation node of an assignment target, if any
+
+    The annotation is either the one of an annotated assignment
+    (``x: int = 0`` or ``self.x: int = 0``), or the one of the annotated
+    argument assigned to an instance attribute (``self.x = x``).
+    """
+    return _get_annotation_and_value(node)[0]
+
+
+def _is_none(node) -> bool:
+    return isinstance(node, astroid.Const) and node.value is None
+
+
+def get_annotation_label(ann: astroid.node_classes.NodeNG) -> str:
+    """return the string to display for the annotation node ``ann``"""
+    if isinstance(ann, astroid.Const) and isinstance(ann.value, str):
+        # forward reference, e.g. ``x: "MyClass"``
+        return ann.value
+    return ann.as_string()
+
+
+def get_type_label(
+    node: Union[astroid.AssignAttr, astroid.AssignName]
+) -> Optional[str]:
+    """return the label of the type annotation of an assignment target, or
+    None if it has no annotation
+
+    An annotation whose assigned or default value is ``None`` is displayed as
+    ``Optional[...]``, unless it already allows ``None``.
+    """
+    ann, value = _get_annotation_and_value(node)
+    if ann is None:
+        return None
+    label = get_annotation_label(ann)
+    if (
+        _is_none(value)
+        and not any(_is_none(const) for const in ann.nodes_of_class(astroid.Const))
+        and not re.match(r"^(typing\.)?Optional\[", label)
+    ):
+        label = f"Optional[{label}]"
+    return label
+
+
+def infer_node(node: Union[astroid.AssignAttr, astroid.AssignName]) -> Set:
+    """return the set of values inferred for an assignment target
+
+    If the target is annotated with a class, an instance of this class is
+    included in the result.
+    """
+    try:
+        values = set(node.infer())
+    except astroid.InferenceError:
+        values = set()
+    ann = get_annotation(node)
+    if isinstance(ann, (astroid.Name, astroid.Attribute)):
+        try:
+            for inferred in ann.infer():
+                if isinstance(inferred, astroid.ClassDef) and not any(
+                    isinstance(value, astroid.Instance) and value._proxied is inferred
+                    for value in values
+                ):
+                    values.add(inferred.instantiate_class())
+        except astroid.InferenceError:
+            pass
+    return values
+
+

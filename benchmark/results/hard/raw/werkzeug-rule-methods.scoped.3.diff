     __hash__ = None  # type: ignore
 
+    def _is_duplicate(self, other: Rule) -> bool:
+        """Whether this rule and *other* can match the same request. They must
+        have equal parts and websocket mode, and overlapping methods. ``None``
+        methods match any method.
+        """
+        if self != other:
+            return False
+

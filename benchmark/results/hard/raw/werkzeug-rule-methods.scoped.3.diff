+@pytest.mark.parametrize(
+    ("a", "b"),
+    [
+        ({"methods": ["GET"]}, {"methods": ["POST"]}),
+        ({"methods": ["POST"]}, {"methods": ["PUT", "DELETE"]}),
+        ({}, {"websocket": True}),
+        ({"methods": ["GET"]}, {"methods": ["GET"], "websocket": True}),
+    ],
+)
+def test_no_duplicate_disjoint(a: dict[str, t.Any], b: dict[str, t.Any]) -> None:
+    """Rules with disjoint methods or different websocket mode are not
+    duplicates.
+    """
+    r.Map([r.Rule("/a", endpoint="a", **a), r.Rule("/a", endpoint="b", **b)])
+
+
+@pytest.mark.parametrize(
+    ("a", "b"),
+    [
+        (["GET", "POST"], ["POST"]),
+        (None, ["GET"]),
+        (["GET"], None),
+        (None, None),
+        (["GET"], ["HEAD"]),
+        (["GET"], ["GET"]),
+    ],
+)
+def test_duplicate_overlapping_methods(
+    a: list[str] | None, b: list[str] | None
+) -> None:
+    """Rules with overlapping methods are duplicates. ``None`` matches any
+    method, and ``GET`` implies ``HEAD``.
+    """
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/a", endpoint="a", methods=a),
+                r.Rule("/a", endpoint="b", methods=b),
+            ]
+        )
+
+
+@pytest.mark.parametrize("strict_slashes", [True, False])
+def test_no_duplicate_trailing_slash(strict_slashes: bool) -> None:
+    """A trailing slash makes a different path, and both rules are reachable
+    regardless of ``strict_slashes``.
+    """
+    m = r.Map(
+        [
+            r.Rule("/a", endpoint="leaf"),
+            r.Rule("/a/", endpoint="branch", strict_slashes=strict_slashes),
+        ]
+    )
+    a = m.bind("localhost")
+    assert a.match("/a") == ("leaf", {})
+    assert a.match("/a/") == ("branch", {})
+
+
+def test_duplicate_strict_slashes() -> None:
+    """``strict_slashes`` doesn't affect what the same path matches."""
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/a/", endpoint="a"),
+                r.Rule("/a/", endpoint="b", strict_slashes=False),
+            ]
+        )
+
+
+def test_duplicate_merge_slashes() -> None:
+    """With ``merge_slashes``, consecutive slashes are merged in the rule, so it
+    matches the same as a rule with a single slash.
+    """
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/a//b", endpoint="a", merge_slashes=True),
+                r.Rule("/a/b", endpoint="b"),
+            ]
+        )
+
+
+def test_no_duplicate_merge_slashes_disabled() -> None:
+    """Without ``merge_slashes``, consecutive slashes are a different path."""
+    m = r.Map(
+        [
+            r.Rule("/a//b", endpoint="a", merge_slashes=False),
+            r.Rule("/a/b", endpoint="b"),
+        ]
+    )
+    a = m.bind("localhost")
+    assert a.match("/a//b") == ("a", {})
+    assert a.match("/a/b") == ("b", {})
+
+

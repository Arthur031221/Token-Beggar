diff --git a/tests/aggregation/tests.py b/tests/aggregation/tests.py
index 39c8a45707..7aad31841c 100644
--- a/tests/aggregation/tests.py
+++ b/tests/aggregation/tests.py
@@ -2084,3 +2084,73 @@ class AggregateTestCase(TestCase):
             exists=Exists(Author.objects.extra(where=["1=0"])),
         )
         self.assertEqual(len(qs), 6)
+
+    def test_unreferenced_aggregate_annotation_pruned(self):
+        with CaptureQueriesContext(connection) as ctx:
+            count = Book.objects.annotate(authors_count=Count("authors")).count()
+        self.assertEqual(count, Book.objects.count())
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertEqual(sql.count("select"), 2, "Subquery wrapping required")
+        self.assertNotIn("authors_count", sql)
+
+    def test_non_aggregate_annotation_inlined(self):
+        with CaptureQueriesContext(connection) as ctx:
+            count = Book.objects.annotate(double_pages=F("pages") * 2).count()
+        self.assertEqual(count, 6)
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertEqual(sql.count("select"), 1, "No subquery wrapping required")
+        self.assertNotIn("double_pages", sql)
+
+    def test_aggregate_over_inlined_annotation(self):
+        with CaptureQueriesContext(connection) as ctx:
+            aggregate = Book.objects.annotate(double_pages=F("pages") * 2).aggregate(
+                Sum("double_pages")
+            )
+        self.assertEqual(aggregate, {"double_pages__sum": 7406})
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertEqual(sql.count("select"), 1, "No subquery wrapping required")
+
+    def test_unreferenced_aggregate_annotations_pruned(self):
+        with CaptureQueriesContext(connection) as ctx:
+            count = Book.objects.annotate(
+                authors_count=Count("authors"), contacts_count=Count("contact")
+            ).count()
+        self.assertEqual(count, 6)
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertEqual(sql.count("select"), 2, "Subquery wrapping required")
+        self.assertNotIn("authors_count", sql)
+        self.assertNotIn("contacts_count", sql)
+
+    def test_referenced_aggregate_annotation_kept(self):
+        with CaptureQueriesContext(connection) as ctx:
+            aggregate = Book.objects.annotate(
+                authors_count=Count("authors"), contacts_count=Count("contact")
+            ).aggregate(Avg("authors_count"))
+        self.assertAlmostEqual(aggregate["authors_count__avg"], 1.66, places=1)
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertEqual(sql.count("select"), 2, "Subquery wrapping required")
+        self.assertIn("authors_count", sql)
+        self.assertNotIn("contacts_count", sql)
+
+    def test_count_filtered_aggregate_alias(self):
+        # Filtering against an aliased aggregate requires grouping.
+        qs = Book.objects.alias(authors_count=Count("authors")).filter(
+            authors_count__gt=1
+        )
+        self.assertEqual(qs.count(), 3)
+
+    def test_count_values_annotation_group_by(self):
+        qs = (
+            Book.objects.annotate(publisher_name=F("publisher__name"))
+            .values("publisher_name")
+            .annotate(books=Count("pk"))
+            .order_by()
+        )
+        self.assertEqual(qs.count(), len(qs))
+        qs = (
+            Book.objects.annotate(rating_x=F("rating") * 2)
+            .values("rating_x")
+            .annotate(books=Count("pk"))
+            .order_by()
+        )
+        self.assertEqual(qs.count(), len(qs))

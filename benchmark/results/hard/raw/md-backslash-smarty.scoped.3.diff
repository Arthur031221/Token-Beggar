+class TestUnescapeTreeprocessor(unittest.TestCase):
+    """ Tests for the UnescapeTreeprocessor. """
+
+    def testUnescapeTextTailAndAttributes(self):
+        stx, etx = markdown.util.STX, markdown.util.ETX
+        esc = '{}{}{}'.format(stx, ord('"'), etx)
+        root = etree.Element('div')
+        p = etree.SubElement(root, 'p', {'title': 'a' + esc + 'b'})
+        p.text = 'a' + esc + 'b'
+        p.tail = 'a' + esc + 'b'
+        code = etree.SubElement(root, 'code')
+        code.text = 'a' + esc + 'b'
+        markdown.treeprocessors.UnescapeTreeprocessor().run(root)
+        self.assertEqual(p.get('title'), 'a"b')
+        self.assertEqual(p.text, 'a"b')
+        self.assertEqual(p.tail, 'a"b')
+        # Text of code elements is left as-is.
+        self.assertEqual(code.text, 'a' + esc + 'b')
+
+

+@skipUnlessDBFeature("supports_over_clause")
+class PrefetchLimitTests(TestDataMixin, TestCase):
+    slices = [slice(1, None), slice(1, 3), slice(None, 1)]
+
+    def test_m2m_forward(self):
+        for s in self.slices:
+            with self.subTest(slice=s):
+                with self.assertNumQueries(2):
+                    books = list(
+                        Book.objects.prefetch_related(
+                            Prefetch(
+                                "authors",
+                                Author.objects.order_by("-name")[s],
+                                to_attr="authors_sliced",
+                            )
+                        )
+                    )
+                for book in books:
+                    expected = list(book.authors.order_by("-name")[s])
+                    self.assertEqual(book.authors_sliced, expected)
+
+    def test_m2m_reverse(self):
+        for s in self.slices:
+            with self.subTest(slice=s):
+                with self.assertNumQueries(2):
+                    authors = list(
+                        Author.objects.prefetch_related(
+                            Prefetch("books", Book.objects.order_by("-title")[s])
+                        )
+                    )
+                for author in authors:
+                    expected = list(author.books.order_by("-title")[s])
+                    self.assertEqual(list(author.books.all()), expected)
+
+    def test_reverse_foreign_key(self):
+        for s in self.slices:
+            with self.subTest(slice=s):
+                with self.assertNumQueries(2):
+                    books = list(
+                        Book.objects.prefetch_related(
+                            Prefetch(
+                                "first_time_authors",
+                                Author.objects.order_by("name")[s],
+                            )
+                        )
+                    )
+                for book in books:
+                    expected = list(book.first_time_authors.order_by("name")[s])
+                    self.assertEqual(list(book.first_time_authors.all()), expected)
+
+    def test_to_attr_reverse_foreign_key(self):
+        books = Book.objects.prefetch_related(
+            Prefetch(
+                "first_time_authors",
+                Author.objects.order_by("name")[:2],
+                to_attr="first_two",
+            )
+        )
+        by_id = {b.id: b for b in books}

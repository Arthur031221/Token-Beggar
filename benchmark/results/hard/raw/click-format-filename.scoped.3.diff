+@pytest.mark.skipif(
+    sys.getfilesystemencodeerrors() != "surrogateescape",
+    reason="filesystem encoding does not use surrogateescape",
+)
+def test_format_filename_surrogates():
+    name = os.fsdecode(b"foo\xe9")
+    assert click.format_filename(name) == "foo�"
+    assert click.format_filename(b"foo\xe9") == "foo�"
+    assert click.format_filename(os.path.join("dir", name), shorten=True) == "foo�"
+    assert click.format_filename(pathlib.Path(name)) == "foo�"
+    assert click.format_filename(pathlib.Path("a") / name, shorten=True) == "foo�"
+
+
+@pytest.mark.skipif(
+    sys.getfilesystemencodeerrors() != "surrogateescape",
+    reason="filesystem encoding does not use surrogateescape",
+)
+def test_file_error_surrogates():
+    err = click.FileError(os.fsdecode(b"foo\xe9"), hint="bad")
+    assert err.ui_filename == "foo�"

diff --git a/tests/test_core_tags.py b/tests/test_core_tags.py
index 4bb95e0..6747a5d 100644
--- a/tests/test_core_tags.py
+++ b/tests/test_core_tags.py
@@ -488,6 +488,41 @@ class TestSet:
         exc_info = pytest.raises(TemplateRuntimeError, tmpl.render, foo={})
         assert "non-namespace object" in exc_info.value.message
 
+    def test_namespace_tuple_swap(self, env_trim):
+        tmpl = env_trim.from_string(
+            "{% set ns = namespace(a=1, b=2) %}"
+            "{% set ns.a, ns.b = ns.b, ns.a %}{{ ns.a }}{{ ns.b }}"
+        )
+        assert tmpl.render() == "21"
+
+    def test_namespace_tuple_mixed(self, env_trim):
+        tmpl = env_trim.from_string(
+            "{% set ns = namespace(a=0) %}"
+            "{% set ns.a, x = 1, 2 %}{{ ns.a }}{{ x }}"
+            "{% set y, ns.a = 3, 4 %}{{ y }}{{ ns.a }}"
+        )
+        assert tmpl.render() == "1234"
+
+    def test_namespace_tuple_loop(self, env_trim):
+        tmpl = env_trim.from_string(
+            "{% set ns = namespace(a=0, b=0) %}"
+            "{% for i in range(3) %}{% set ns.a, ns.b = ns.b + i, ns.a + 1 %}"
+            "{% endfor %}{{ ns.a }},{{ ns.b }}"
+        )
+        assert tmpl.render() == "3,3"
+
+    def test_namespace_tuple_non_namespace(self, env_trim):
+        tmpl = env_trim.from_string("{% set foo.bar, x = 1, 2 %}")
+        exc_info = pytest.raises(TemplateRuntimeError, tmpl.render, foo={})
+        assert "non-namespace object" in exc_info.value.message
+
+    def test_namespace_tuple_not_in_for(self, env_trim):
+        pytest.raises(
+            TemplateSyntaxError,
+            env_trim.from_string,
+            "{% set ns = namespace() %}{% for ns.a, b in [(1, 2)] %}{% endfor %}",
+        )
+
     def test_namespace_redefined(self, env_trim):
         tmpl = env_trim.from_string("{% set ns = namespace() %}{% set ns.bar = 'hi' %}")
         exc_info = pytest.raises(TemplateRuntimeError, tmpl.render, namespace=dict)

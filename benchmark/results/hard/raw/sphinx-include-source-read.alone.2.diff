index 19f7c0a8d..2b50bcd6e 100644
--- a/sphinx/directives/other.py
+++ b/sphinx/directives/other.py
@@ -8,6 +8,7 @@ from docutils.parsers.rst import directives
 from docutils.parsers.rst.directives.admonitions import BaseAdmonition
 from docutils.parsers.rst.directives.misc import Class
 from docutils.parsers.rst.directives.misc import Include as BaseInclude
+from docutils.statemachine import StateMachine
 
 from sphinx import addnodes
 from sphinx.domains.changeset import VersionChange  # noqa: F401  # for compatibility
@@ -376,7 +377,39 @@ class Include(BaseInclude, SphinxDirective):
         rel_filename, filename = self.env.relfn2path(self.arguments[0])
         self.arguments[0] = filename
         self.env.note_included(filename)
-        return super().run()
+
+        # Only intercept the included text if anyone listens to "source-read".
+        if not self.env.events.listeners.get('source-read'):
+            return super().run()
+
+        # docutils inserts the included reST text directly into the state
+        # machine, bypassing Sphinx's reader (and thus the "source-read"
+        # event).  Temporarily patch ``insert_input()`` on the instance so
+        # that the included text is passed through "source-read" as well.
+        state_machine = self.state_machine
+
+        def _insert_input(include_lines: list[str], source: str) -> None:
+            # docutils appends a blank line and an end-of-inclusion marker
+            # comment; keep them out of the text sent with the event.
+            if (len(include_lines) >= 2 and include_lines[-2] == ''
+                    and include_lines[-1].startswith('.. end of inclusion from')):
+                lines, markers = include_lines[:-2], include_lines[-2:]
+            else:
+                lines, markers = include_lines, []
+
+            # The included file may or may not be a document itself.
+            docname = self.env.path2doc(source) or self.env.docname
+            arg = ['\n'.join(lines)]
+            self.env.events.emit('source-read', docname, arg)
+            include_lines = arg[0].splitlines() + markers
+
+            StateMachine.insert_input(state_machine, include_lines, source)
+
+        state_machine.insert_input = _insert_input  # type: ignore[method-assign]
+        try:
+            return super().run()
+        finally:
+            del state_machine.insert_input
 
 

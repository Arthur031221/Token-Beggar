diff --git a/tests/unittest_pyreverse_utils.py b/tests/unittest_pyreverse_utils.py
new file mode 100644
index 00000000..1bbcc2fc
--- /dev/null
+++ b/tests/unittest_pyreverse_utils.py
@@ -0,0 +1,51 @@
+"""Tests for pylint.pyreverse.utils annotation helpers"""
+import astroid
+
+from pylint.pyreverse.utils import get_annotation, get_annotation_label, infer_node
+
+
+def _first(code, cls):
+    return next(astroid.extract_node(code).nodes_of_class(cls))
+
+
+def test_annassign():
+    node = _first("class C:\n    x: int = 1\n", astroid.AssignName)
+    ann = get_annotation(node)
+    assert get_annotation_label(ann) == "int"
+    assert infer_node(node) == {ann}
+
+
+def test_init_arg_annotation_with_none_default():
+    node = _first(
+        "class C:\n    def __init__(self, a: str = None):\n        self.a = a\n",
+        astroid.AssignAttr,
+    )
+    assert get_annotation(node).name == "Optional[str]"
+
+
+def test_init_arg_annotation_no_default():
+    node = _first(
+        "class C:\n    def __init__(self, a: str):\n        self.a = a\n",
+        astroid.AssignAttr,
+    )
+    assert get_annotation(node).name == "str"
+
+
+def test_subscript_annotation():
+    node = _first(
+        "class C:\n    def __init__(self):\n        self.x: List[int] = []\n",
+        astroid.AssignAttr,
+    )
+    ann = get_annotation(node)
+    assert isinstance(ann, astroid.Subscript)
+    assert get_annotation_label(ann) == "List[int]"
+
+
+def test_no_annotation_fallback():
+    node = _first(
+        "class C:\n    def __init__(self, a):\n        self.a = a\n",
+        astroid.AssignAttr,
+    )
+    assert get_annotation(node) is None
+    assert get_annotation_label(None) == ""
+    assert infer_node(node) == set(node.infer())

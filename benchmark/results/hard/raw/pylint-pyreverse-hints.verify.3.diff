diff --git a/pylint/pyreverse/utils.py b/pylint/pyreverse/utils.py
index a24d227e..c8441cef 100644
--- a/pylint/pyreverse/utils.py
+++ b/pylint/pyreverse/utils.py
@@ -19,6 +19,9 @@
 import os
 import re
 import sys
+from typing import Optional, Union
+
+import astroid
 
 RCFILE = ".pyreverserc"
 
@@ -213,3 +216,59 @@ class LocalsVisitor(ASTWalker):
         if methods[1] is not None:
             return methods[1](node)
         return None
+
+
+def get_annotation_label(ann: Union[astroid.Name, astroid.Subscript]) -> str:
+    """return a printable label for an annotation node"""
+    label = ""
+    if isinstance(ann, astroid.Subscript):
+        label = ann.as_string()
+    elif isinstance(ann, astroid.Name):
+        label = ann.name
+    return label
+
+
+def get_annotation(
+    node: Union[astroid.AssignAttr, astroid.AssignName]
+) -> Optional[Union[astroid.Name, astroid.Subscript]]:
+    """return the annotation for `node`, if any"""
+    ann = None
+    if isinstance(node.parent, astroid.AnnAssign):
+        ann = node.parent.annotation
+    elif isinstance(node, astroid.AssignAttr):
+        init_method = node.parent.parent
+        try:
+            arguments = init_method.args.args
+            annotations = init_method.args.annotations
+            annotations = dict(zip((a.name for a in arguments), annotations))
+            ann = annotations.get(node.parent.value.name)
+        except AttributeError:
+            pass
+
+    try:
+        default, *_ = node.infer()
+    except astroid.InferenceError:
+        default = ""
+
+    label = get_annotation_label(ann)
+    if (
+        ann
+        and isinstance(default, astroid.Const)
+        and default.value is None
+        and not label.startswith("Optional")
+    ):
+        label = "Optional[{}]".format(label)
+    if label and ann:
+        ann.name = label
+    return ann
+
+
+def infer_node(node: Union[astroid.AssignAttr, astroid.AssignName]) -> set:
+    """return the set of inferred values, or the annotation if present"""
+    ann = get_annotation(node)
+    if ann:
+        return {ann}
+    try:
+        return set(node.infer())
+    except astroid.InferenceError:
+        return set()

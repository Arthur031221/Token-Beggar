+
+
+class TestPEP751Markers:
+    @pytest.mark.parametrize("s", ["'a' in extras", "'dev' not in dependency_groups"])
+    def test_parse(self, s):
+        Marker(s)
+
+    def test_lock_file_defaults(self):
+        assert not Marker("'a' in extras").evaluate(context="lock_file")
+        assert Marker("'a' not in extras").evaluate(context="lock_file")
+        assert Marker("'a' not in dependency_groups").evaluate(context="lock_file")
+
+    def test_environment(self):
+        env = {"extras": {"a"}}
+        assert Marker("'a' in extras").evaluate(env, context="lock_file")
+        assert not Marker("'a' not in extras").evaluate(env, context="lock_file")
+
+    def test_normalization(self):
+        assert Marker("'Foo_Bar' in extras").evaluate(
+            {"extras": {"foo-bar"}}, context="lock_file"
+        )
+        assert Marker("'Dev.X' in dependency_groups").evaluate(
+            {"dependency_groups": {"dev-x"}}, context="lock_file"
+        )
+
+    def test_combined(self):
+        m = Marker("'a' in extras and 'd' not in dependency_groups or os_name == 'x'")
+        assert m.evaluate({"extras": {"a"}}, context="lock_file")
+        assert not m.evaluate({"extras": set()}, context="lock_file")
+
+    @pytest.mark.parametrize(
+        "s", ["'a' == extras", "'a' < dependency_groups", "extras in 'a'"]
+    )
+    def test_bad_operator_on_set(self, s):
+        with pytest.raises(UndefinedComparison):
+            Marker(s).evaluate(context="lock_file")
+
+    @pytest.mark.parametrize("context", ["metadata", "requirement"])
+    def test_no_set_default_outside_lock_file(self, context):
+        with pytest.raises(UndefinedEnvironmentName):
+            Marker("'a' in extras").evaluate(context=context)
+
+    def test_requirement_context_has_no_extra_default(self):
+        with pytest.raises(UndefinedEnvironmentName):
+            Marker("extra == 'a'").evaluate(context="requirement")
+        assert Marker("extra == 'a'").evaluate({"extra": "a"}, context="requirement")
+
+    def test_extra_unchanged(self):
+        assert Marker("extra == 'Foo_Bar'").evaluate({"extra": "foo-bar"})
+        assert Marker("extra == ''").evaluate()

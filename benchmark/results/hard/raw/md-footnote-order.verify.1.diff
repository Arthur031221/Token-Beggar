+class FootnoteOrderTreeprocessor(Treeprocessor):
+    """ Order and number footnotes by their first reference in the document. """
+
+    def __init__(self, footnotes: FootnoteExtension):
+        self.footnotes = footnotes
+
+    def find_refs(self, element: etree.Element, ids: dict[str, str], order: list[str]) -> None:
+        """ Append ids of footnotes referenced within `element` to `order` in document order. """
+        for sup in element.iter('sup'):
+            for a in sup.iter('a'):
+                if a.attrib.get('class', '') == 'footnote-ref':
+                    id = ids.get(a.attrib.get('href', '')[1:])
+                    if id is not None and id not in order:
+                        order.append(id)
+
+    def run(self, root: etree.Element) -> None:
+        if self.footnotes.getConfig('USE_DEFINITION_ORDER'):
+            return
+        ids = {self.footnotes.makeFootnoteId(id): id for id in self.footnotes.footnotes}
+        for div in root.iter('div'):
+            if div.attrib.get('class', '') == 'footnote':
+                break
+        else:
+            return
+        ol = div.find('ol')
+        if ol is None:
+            return
+        lis = {ids.get(li.attrib.get('id', '')): li for li in ol}
+
+        # Find references in the document body (outside the footnote div) first.
+        order: list[str] = []
+        stack = [root]
+        while stack:
+            el = stack.pop()
+            if el is div:
+                continue
+            if el.tag == 'sup':
+                self.find_refs(el, ids, order)
+            else:
+                stack.extend(reversed(list(el)))
+        # Then references within footnotes, in the order the footnotes are now listed.
+        index = 0
+        while index < len(order):
+            if order[index] in lis:
+                self.find_refs(lis[order[index]], ids, order)
+            index += 1
+        # Unreferenced footnotes stay at the end in definition order.
+        order.extend(id for id in self.footnotes.footnotes if id not in order)
+
+        numbers = {id: n for n, id in enumerate(order, start=1)}
+        backlink_title = self.footnotes.getConfig("BACKLINK_TITLE").replace("%d", "{}")
+        for sup in root.iter('sup'):
+            for a in sup.iter('a'):
+                id = ids.get(a.attrib.get('href', '')[1:])
+                if a.attrib.get('class', '') == 'footnote-ref' and id is not None:
+                    a.text = self.footnotes.getConfig("SUPERSCRIPT_TEXT").format(numbers[id])
+        for li in list(ol):
+            ol.remove(li)
+        for id in order:
+            li = lis.get(id)
+            if li is not None:
+                ol.append(li)
+                for a in li.iter('a'):
+                    if a.attrib.get('class', '') == 'footnote-backref':
+                        a.set('title', backlink_title.format(numbers[id]))
+
+

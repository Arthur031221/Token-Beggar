+    def test_reference_order(self):
+        """Test footnotes are numbered and listed in order of first reference."""
+
+        text = 'first[^b] second[^a]\n\n[^a]: Footnote A\n[^b]: Footnote B'
+        self.assertMarkdownRenders(
+            text,
+            '<p>first<sup id="fnref:b"><a class="footnote-ref" href="#fn:b">1</a></sup> '
+            'second<sup id="fnref:a"><a class="footnote-ref" href="#fn:a">2</a></sup></p>\n'
+            '<div class="footnote">\n'
+            '<hr />\n'
+            '<ol>\n'
+            '<li id="fn:b">\n'
+            '<p>Footnote B&#160;<a class="footnote-backref" href="#fnref:b"'
+            ' title="Jump back to footnote 1 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '<li id="fn:a">\n'
+            '<p>Footnote A&#160;<a class="footnote-backref" href="#fnref:a"'
+            ' title="Jump back to footnote 2 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '</ol>\n'
+            '</div>'
+        )
+
+    def test_use_definition_order(self):

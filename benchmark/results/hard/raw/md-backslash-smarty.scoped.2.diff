diff --git a/tests/test_syntax/extensions/test_smarty.py b/tests/test_syntax/extensions/test_smarty.py
new file mode 100644
index 0000000..e5df51a
--- /dev/null
+++ b/tests/test_syntax/extensions/test_smarty.py
@@ -0,0 +1,66 @@
+"""
+Python Markdown
+
+A Python implementation of John Gruber's Markdown.
+
+Documentation: https://python-markdown.github.io/
+GitHub: https://github.com/Python-Markdown/markdown/
+PyPI: https://pypi.org/project/Markdown/
+
+License: BSD (see LICENSE.md for details).
+"""
+
+from markdown.test_tools import TestCase
+
+
+class TestSmarty(TestCase):
+
+    default_kwargs = {'extensions': ['smarty']}
+
+    def test_escaped_quote_in_img_alt(self):
+        self.assertMarkdownRenders(
+            r'![x\"x](x)',
+            '<p><img alt="x&quot;x" src="x" /></p>'
+        )
+
+    def test_quote_in_img_alt(self):
+        self.assertMarkdownRenders(
+            '![x"x](x)',
+            '<p><img alt="x&quot;x" src="x" /></p>'
+        )
+
+    def test_escaped_quote_in_img_title(self):
+        self.assertMarkdownRenders(
+            r'![x](x "a\"b")',
+            '<p><img alt="x" src="x" title="a&quot;b" /></p>'
+        )
+
+    def test_escaped_quote_in_link_title(self):
+        self.assertMarkdownRenders(
+            r'[a](x "t\"t")',
+            '<p><a href="x" title="t&quot;t">a</a></p>'
+        )
+
+    def test_escaped_quote_in_href(self):
+        self.assertMarkdownRenders(
+            r'[a](x\"y)',
+            '<p><a href="x&quot;y">a</a></p>'
+        )
+
+    def test_escaped_quote_in_text(self):
+        self.assertMarkdownRenders(
+            r'a\"b',
+            '<p>a"b</p>'
+        )
+
+    def test_escaped_single_quote_in_img_alt(self):
+        self.assertMarkdownRenders(
+            r"![x\'x](x)",
+            "<p><img alt=\"x'x\" src=\"x\" /></p>"
+        )
+
+    def test_escaped_amp_in_img_alt(self):
+        self.assertMarkdownRenders(
+            r'![x\&x](x)',
+            '<p><img alt="x\\&amp;x" src="x" /></p>'
+        )

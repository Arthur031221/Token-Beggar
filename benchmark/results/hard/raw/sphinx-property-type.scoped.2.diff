diff --git a/sphinx/util/inspect.py b/sphinx/util/inspect.py
index 23dd9e930..410e581cf 100644
--- a/sphinx/util/inspect.py
+++ b/sphinx/util/inspect.py
@@ -393,6 +393,24 @@ def isproperty(obj: Any) -> bool:
     return isinstance(obj, property)
 
 
+def getclassproperty(cls: Any, name: str) -> Any:
+    """Get the property wrapped by a classmethod (``@classmethod @property``,
+    available since py3.9) from the class or its base classes.
+
+    Returns None if the attribute is not such a class property.
+    """
+    placeholder = object()
+    for basecls in getmro(cls):
+        obj = safe_getattr(basecls, '__dict__', {}).get(name, placeholder)
+        if obj is not placeholder:
+            if isinstance(obj, classmethod) and isproperty(obj.__func__):
+                return obj.__func__
+            else:
+                return None
+
+    return None
+
+

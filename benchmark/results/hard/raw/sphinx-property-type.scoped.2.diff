+@pytest.mark.skipif(sys.version_info < (3, 9), reason='python 3.9+ is required.')
+def test_getclassproperty():
+    class Base:
+        @classmethod
+        @property
+        def classprop(cls):
+            """docstring"""
+
+        @property
+        def prop(self):
+            pass
+
+        @classmethod
+        def classmeth(cls):
+            pass
+
+    class Inherited(Base):
+        pass
+
+    class Overridden(Base):
+        classprop = None
+
+    assert isinstance(inspect.getclassproperty(Base, 'classprop'), property)
+    assert inspect.getclassproperty(Base, 'classprop').__doc__ == 'docstring'
+    assert inspect.getclassproperty(Inherited, 'classprop') is Base.__dict__['classprop'].__func__
+    assert inspect.getclassproperty(Overridden, 'classprop') is None
+    assert inspect.getclassproperty(Base, 'prop') is None
+    assert inspect.getclassproperty(Base, 'classmeth') is None
+    assert inspect.getclassproperty(Base, 'unknown') is None
+
+

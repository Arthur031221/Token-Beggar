@@ -8,6 +8,7 @@ from docutils.parsers.rst import directives
 from docutils.parsers.rst.directives.admonitions import BaseAdmonition
 from docutils.parsers.rst.directives.misc import Class
 from docutils.parsers.rst.directives.misc import Include as BaseInclude
+from docutils.statemachine import StateMachine
 
 from sphinx import addnodes
 from sphinx.domains.changeset import VersionChange  # noqa: F401  # for compatibility
@@ -369,6 +370,18 @@ class Include(BaseInclude, SphinxDirective):
     """
 
     def run(self) -> list[Node]:
+        # To emit "source-read" events for included reST text, we temporarily
+        # patch ``StateMachine.insert_input()`` on this state machine instance,
+        # which docutils' Include directive uses to insert the included lines.
+        if self.env.app.events.listeners.get('source-read'):
+            self.state_machine.insert_input = self._insert_input  # type: ignore[method-assign]
+            try:
+                return self._run()
+            finally:
+                del self.state_machine.insert_input
+        return self._run()
+
+    def _run(self) -> list[Node]:
         if self.arguments[0].startswith('<') and \
            self.arguments[0].endswith('>'):
             # docutils "standard" includes, do not do path processing
@@ -378,6 +391,21 @@ class Include(BaseInclude, SphinxDirective):
         self.env.note_included(filename)
         return super().run()
 
+    def _insert_input(self, include_lines: list[str], source: str) -> None:
+        # docutils appends two marker lines to the included content
+        # (cf. docutils.parsers.rst.directives.misc.Include.run());
+        # keep them out of the "source-read" event.
+        text = '\n'.join(include_lines[:-2])
+
+        docname = self.env.path2doc(source)
+        arg = [text]
+        self.env.events.emit('source-read', docname, arg)
+        text = arg[0]
+
+        include_lines = text.splitlines() + include_lines[-2:]
+        # call the class method, not the patched instance attribute
+        StateMachine.insert_input(self.state_machine, include_lines, source)
+
 

+def test_strip_control_codes_length():
+    text = Text("foo\r\nbar")
+    assert text.plain == "foo\nbar"
+    assert len(text) == 7
+
+
+def test_render_styled_text_with_carriage_returns():
+    text = Text("foo\r\nbar\r\n\r\nbaz")
+    text.stylize("bold", 0, len(text))
+    console = Console(width=20, file=StringIO(), color_system=None, legacy_windows=False)
+    console.print(text)
+    assert console.file.getvalue() == "foo\nbar\n\nbaz\n"
+
+

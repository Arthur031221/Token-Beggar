+
+
+def test_inspect_module_with_crlf_docstring():
+    def function():
+        pass
+
+    function.__doc__ = "Hello\r\nWorld"
+
+    module = ModuleType("my_module")
+    module.function = function
+
+    expected = (
+        "╭─── <module 'my_module'> ───╮\n"
+        "│ function = def function(): │\n"
+        "│            Hello           │\n"
+        "│            World           │\n"
+        "╰────────────────────────────╯\n"
+    )
+    assert render(module, methods=True) == expected

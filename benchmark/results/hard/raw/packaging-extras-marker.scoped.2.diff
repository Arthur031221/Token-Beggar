     def test_python_full_version_untagged(self):
         with mock.patch("platform.python_version", return_value="3.11.1+"):
             assert Marker("python_full_version < '3.12'").evaluate()
+
+
+class TestPep751Markers:
+    @pytest.mark.parametrize(
+        "text",
+        [
+            '"a" in extras',
+            '"dev" not in dependency_groups',
+            'extra == "a" and "b" in extras',
+        ],
+    )
+    def test_parse_roundtrip(self, text):
+        assert str(Marker(text)) == text
+
+    def test_lock_file_defaults(self):
+        m = Marker('"a" in extras')
+        assert m.evaluate(context="lock_file") is False
+        n = Marker('"dev" not in dependency_groups')
+        assert n.evaluate(context="lock_file") is True
+
+    def test_environment_sets(self):
+        assert Marker('"a" in extras').evaluate({"extras": {"a"}}, "lock_file")
+        assert not Marker('"a" not in extras').evaluate({"extras": {"a"}}, "lock_file")
+
+    def test_normalization(self):
+        env = {"extras": {"foo-bar"}}
+        assert Marker('"Foo_Bar" in extras').evaluate(env, "lock_file")
+        env = {"dependency_groups": {"Foo_Bar"}}
+        assert Marker('"foo-bar" in dependency_groups').evaluate(env, "lock_file")
+
+    def test_extras_undefined_in_metadata(self):
+        with pytest.raises(KeyError):
+            Marker('"a" in extras').evaluate()
+
+    def test_requirement_context_no_extra(self):
+        with pytest.raises(KeyError):
+            Marker('extra == "x"').evaluate(context="requirement")
+        assert Marker('extra == "x"').evaluate({"extra": "X"}, "requirement")
+
+    def test_lock_file_has_no_extra(self):
+        with pytest.raises(KeyError):
+            Marker('extra == "x"').evaluate(context="lock_file")
+
+    def test_metadata_default_unchanged(self):
+        assert Marker('extra == ""').evaluate()
+        assert Marker('extra == ""').evaluate({"extra": None})
+
+    def test_set_with_other_operator(self):
+        with pytest.raises(UndefinedComparison):
+            Marker('"a" ~= extras').evaluate({"extras": {"a"}}, "lock_file")
+
+    def test_requirement_marker(self):
+        from packaging.requirements import Requirement
+
+        r = Requirement('foo; "a" in extras')
+        assert r.marker.evaluate({"extras": {"a"}}, "lock_file")

+class TestSetMarkers:
+    @pytest.mark.parametrize(
+        "marker_string",
+        [
+            '"a" in extras',
+            '"a" not in extras',
+            '"dev" in dependency_groups',
+            '"dev" not in dependency_groups',
+            'extras == "a"',
+            'dependency_groups == "a"',
+        ],
+    )
+    def test_parse_and_str(self, marker_string):
+        assert str(Marker(marker_string)) == marker_string
+
+    @pytest.mark.parametrize(
+        ("marker_string", "environment", "expected"),
+        [
+            ('"a" in extras', {"extras": {"a", "b"}}, True),
+            ('"c" in extras', {"extras": {"a", "b"}}, False),
+            ('"c" not in extras', {"extras": {"a", "b"}}, True),
+            ('"a" not in extras', {"extras": {"a", "b"}}, False),
+            ('"foo-bar" in extras', {"extras": {"Foo_Bar"}}, True),
+            ('"Foo_Bar" in extras', {"extras": {"foo-bar"}}, True),
+            ('"dev" in dependency_groups', {"dependency_groups": {"dev"}}, True),
+            ('"Dev_1" in dependency_groups', {"dependency_groups": {"dev-1"}}, True),
+            ('"test" not in dependency_groups', {"dependency_groups": {"dev"}}, True),
+            ('"a" in extras', {}, False),
+            ('"a" not in extras', {}, True),
+            ('"dev" in dependency_groups', {}, False),
+            ('"dev" not in dependency_groups', {}, True),
+        ],
+    )
+    def test_lock_file_context(self, marker_string, environment, expected):
+        assert Marker(marker_string).evaluate(environment, context="lock_file") is (
+            expected
+        )
+
+    @pytest.mark.parametrize("name", ["extras", "dependency_groups"])
+    def test_undefined_in_metadata_context(self, name):
+        with pytest.raises(UndefinedEnvironmentName):
+            Marker(f'"a" in {name}').evaluate()
+
+    @pytest.mark.parametrize("context", ["lock_file", "requirement"])
+    def test_extra_undefined_outside_metadata(self, context):
+        if context == "lock_file":
+            with pytest.raises(UndefinedEnvironmentName):
+                Marker('extra == "a"').evaluate(context=context)
+        with pytest.raises(UndefinedEnvironmentName):
+            Marker('extra == "a"').evaluate(context="requirement")
+
+    def test_requirement_context_with_provided_values(self):
+        assert Marker('extra == "a"').evaluate({"extra": "A"}, context="requirement")
+        assert Marker('"a" in extras').evaluate(
+            {"extras": {"a"}}, context="requirement"
+        )
+
+    def test_metadata_context_default_extra(self):
+        assert Marker('extra == ""').evaluate()

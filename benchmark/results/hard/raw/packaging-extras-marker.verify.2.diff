diff --git a/tests/test_markers.py b/tests/test_markers.py
index faf0d13..64f158d 100644
--- a/tests/test_markers.py
+++ b/tests/test_markers.py
@@ -394,3 +394,46 @@ class TestMarker:
     def test_python_full_version_untagged(self):
         with mock.patch("platform.python_version", return_value="3.11.1+"):
             assert Marker("python_full_version < '3.12'").evaluate()
+
+
+class TestSetMarkers:
+    @pytest.mark.parametrize("var", ["extras", "dependency_groups"])
+    @pytest.mark.parametrize(
+        ("expr", "value", "expected"),
+        [
+            ('"tests" in {var}', {"tests"}, True),
+            ('"tests" in {var}', {"other"}, False),
+            ('"Tests_X" in {var}', {"tests-x"}, True),
+            ('"tests-x" in {var}', {"Tests_X"}, True),
+            ('"tests" not in {var}', {"tests"}, False),
+            ('"tests" not in {var}', {"other"}, True),
+            ('"Tests_X" not in {var}', {"tests-x"}, False),
+            ('"tests" in {var}', frozenset(), False),
+        ],
+    )
+    def test_evaluate(self, var, expr, value, expected):
+        marker = Marker(expr.format(var=var))
+        assert marker.evaluate({var: value}, "lock_file") is expected
+
+    @pytest.mark.parametrize("var", ["extras", "dependency_groups"])
+    def test_lock_file_defaults_empty(self, var):
+        assert Marker(f'"a" in {var}').evaluate(context="lock_file") is False
+        assert Marker(f'"a" not in {var}').evaluate(context="lock_file") is True
+
+    @pytest.mark.parametrize("var", ["extras", "dependency_groups"])
+    def test_str_roundtrip(self, var):
+        m = Marker(f'"a" in {var} and "b" not in {var}')
+        assert str(m) == f'"a" in {var} and "b" not in {var}'
+        assert Marker(str(m)) == m
+
+    def test_metadata_context_extra(self):
+        assert Marker('extra == "x"').evaluate({"extra": "X"}) is True
+        assert Marker('extra == "x"').evaluate() is False
+
+    def test_requirement_context_has_no_extra(self):
+        with pytest.raises(KeyError):
+            Marker('extra == "x"').evaluate(context="requirement")
+
+    def test_metadata_context_has_no_extras(self):
+        with pytest.raises(KeyError):
+            Marker('"x" in extras').evaluate()

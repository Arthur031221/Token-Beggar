+- `structlog.tracebacks.extract()` now returns a `Trace` without stacks instead of raising an `AttributeError` if there is no exception – for example, when `exception()` is called outside of an exception handler.
+
 
 ## [24.4.0](https://github.com/hynek/structlog/compare/24.3.0...24.4.0) - 2024-07-17
 
diff --git a/src/structlog/tracebacks.py b/src/structlog/tracebacks.py
index b5c4b43..0fbf156 100644
--- a/src/structlog/tracebacks.py
+++ b/src/structlog/tracebacks.py
@@ -218,14 +218,21 @@ def extract(
 
     Returns:
         A Trace instance with structured information about all exceptions.
+        If there is no exception (*exc_type* is ``None``), the trace has no
+        stacks.
 
     .. versionadded:: 22.1.0
     .. versionchanged:: 24.3.0
        Added *locals_max_length*, *locals_hide_sunder*, *locals_hide_dunder*
        and *use_rich* arguments.
+    .. versionchanged:: 25.1.0
+       Missing exceptions -- ``(None, None, None)`` -- are handled.
     """
 
     stacks: list[Stack] = []
+
+    if exc_type is None:
+        return Trace(stacks=stacks)
     is_cause = False
 
     while True:

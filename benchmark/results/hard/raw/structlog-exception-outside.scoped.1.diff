diff --git a/tests/test_tracebacks.py b/tests/test_tracebacks.py
index f8d0f1e..2703f8a 100644
--- a/tests/test_tracebacks.py
+++ b/tests/test_tracebacks.py
@@ -781,3 +781,14 @@ def test_exception_dict_transformer_missing_exc_info():
     result = transformer(exc_info=(None, None, None))
 
     assert [] == result
+
+
+def test_extract_missing_exc_info():
+    """
+    extract returns a trace without stacks if exc_info is missing, e.g. when
+    logging an exception outside of an exception handler.
+    """
+    assert tracebacks.Trace(stacks=[]) == tracebacks.extract(
+        *sys.exc_info()
+    )
+    assert tracebacks.Trace(stacks=[]) == tracebacks.extract(None, None, None)

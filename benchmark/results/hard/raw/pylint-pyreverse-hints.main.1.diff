+def get_annotation_label(ann: astroid.node_classes.NodeNG) -> str:
+    """Return the string representation of an annotation node."""
+    return ann.as_string()
+
+
+def get_annotation(
+    node: Union[astroid.AssignAttr, astroid.AssignName]
+) -> Optional[astroid.node_classes.NodeNG]:
+    """Return the annotation node for an attribute/name, if any.
+
+    The default value ``None`` turns ``T`` into ``Optional[T]``.
+    """
+    ann = None
+    default = None
+    if isinstance(node.parent, astroid.AnnAssign):
+        ann = node.parent.annotation
+        default = node.parent.value
+    elif (
+        isinstance(node, astroid.AssignAttr)
+        and isinstance(node.parent, astroid.Assign)
+        and isinstance(node.parent.value, astroid.Name)
+    ):
+        func = node.frame()
+        if isinstance(func, astroid.FunctionDef):
+            name = node.parent.value.name
+            args = func.args
+            groups = (
+                (args.posonlyargs, args.posonlyargs_annotations),
+                (args.args, args.annotations),
+                (args.kwonlyargs, args.kwonlyargs_annotations),
+            )
+            for arguments, annotations in groups:
+                for arg, arg_ann in zip(arguments or [], annotations or []):
+                    if arg.name == name:
+                        ann = arg_ann
+            try:
+                default = args.default_value(name)
+            except astroid.NoDefault:
+                default = None
+    if ann is None:
+        return None
+    label = get_annotation_label(ann)
+    if (
+        isinstance(default, astroid.Const)
+        and default.value is None
+        and not label.startswith("Optional")
+    ):
+        return astroid.extract_node(f"Optional[{label}]")
+    return ann
+
+
+def infer_node(node: Union[astroid.AssignAttr, astroid.AssignName]) -> set:
+    """Return the set of inferred values, preferring type annotations."""
+    ann = get_annotation(node)
+    if ann:
+        return {ann}
+    try:
+        return set(node.infer())
+    except astroid.InferenceError:
+        return set()
diff --git a/tests/unittest_pyreverse_utils.py b/tests/unittest_pyreverse_utils.py
new file mode 100644
index 00000000..8b0a8b74
--- /dev/null
+++ b/tests/unittest_pyreverse_utils.py
@@ -0,0 +1,106 @@
+"""Tests for type hint support in pyreverse."""
+import astroid
+import pytest
+
+from pylint.pyreverse.diadefslib import DefaultDiadefGenerator, DiadefsHandler
+from pylint.pyreverse.inspector import Linker, Project
+from pylint.pyreverse.utils import get_annotation, get_annotation_label, infer_node
+
+
+def _label(ann):
+    return get_annotation_label(ann) if ann is not None else None
+
+
+@pytest.mark.parametrize(
+    "code, expected",
+    [
+        ("a: str = None", "Optional[str]"),
+        ("a: Optional[str] = None", "Optional[str]"),
+        ("a: int = 1", "int"),
+        ("a: int", "int"),
+        ("a = 1", None),
+    ],
+)
+def test_get_annotation_annassign(code, expected):
+    stmt = astroid.extract_node(f"{code}  #@")
+    node = stmt.target if isinstance(stmt, astroid.AnnAssign) else stmt.targets[0]
+    assert _label(get_annotation(node)) == expected
+
+
+@pytest.mark.parametrize(
+    "args, expected",
+    [
+        ("a: str = None", "Optional[str]"),
+        ("a: Optional[str] = None", "Optional[str]"),
+        ("a: int", "int"),
+        ("*, a: str = None", "Optional[str]"),
+        ("*, a: int", "int"),
+        ("a: int = 3", "int"),
+        ("a", None),
+    ],
+)
+def test_get_annotation_argument(args, expected):
+    func = astroid.extract_node(
+        f"""
+    class C:
+        def __init__(self, {args}):
+            self.x = a  #@
+    """
+    )
+    assert _label(get_annotation(func.targets[0])) == expected
+
+
+def test_get_annotation_does_not_mutate():
+    stmt = astroid.extract_node("a: str = None #@")
+    get_annotation(stmt.target)
+    assert stmt.annotation.as_string() == "str"
+
+
+def test_infer_node_falls_back_to_inference():
+    func = astroid.extract_node(
+        """
+    class C:
+        def __init__(self, a):
+            self.x = 1  #@
+    """
+    )
+    result = infer_node(func.targets[0])
+    assert [n.value for n in result] == [1]
+
+
+def test_infer_node_annotation():
+    stmt = astroid.extract_node("a: str = None #@")
+    assert {n.as_string() for n in infer_node(stmt.target)} == {"Optional[str]"}
+
+
+def test_class_diagram_attrs():
+    module = astroid.parse(
+        """
+    class C:
+        def __init__(self, a: str = None):
+            self.a = a
+    """,
+        module_name="m",
+    )
+    project = Project("p")
+    project.add_module(module)
+    project.path = module.file
+    linker = Linker(project)
+
+    class Config:
+        def __init__(self):
+            self.classes = []
+            self.mode = "PUB_ONLY"
+            self.all_ancestors = None
+            self.all_associated = None
+            self.show_ancestors = None
+            self.show_associated = None
+            self.module_names = None
+            self.output_format = "dot"
+            self.show_builtin = False
+            self.only_classnames = False
+
+    diagrams = DefaultDiadefGenerator(linker, DiadefsHandler(Config())).visit(project)
+    diagram = [d for d in diagrams if d.TYPE == "class"][0]
+    diagram.extract_relationships()
+    assert diagram.classe("C").attrs == ["a : Optional[str]"]

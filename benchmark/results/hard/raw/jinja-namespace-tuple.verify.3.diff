+    def check_namespace_targets(self, target: nodes.Expr, frame: Frame) -> None:
+        """Emit runtime checks that all namespace references in an
+        assignment target refer to a namespace object.
+        """
+        targets = [target, *target.find_all(nodes.NSRef)]
+        for ref_node in targets:
+            if not isinstance(ref_node, nodes.NSRef):
+                continue
+            ref = frame.symbols.ref(ref_node.name)
+            self.writeline(f"if not isinstance({ref}, Namespace):")
+            self.indent()
+            self.writeline(
+                "raise TemplateRuntimeError"
+                '("cannot assign attribute on non-namespace object")'
+            )
+            self.outdent()
+
     def visit_Assign(self, node: nodes.Assign, frame: Frame) -> None:
         self.push_assign_tracking()
+        self.check_namespace_targets(node.target, frame)
         self.newline(node)
         self.visit(node.target, frame)
         self.write(" = ")

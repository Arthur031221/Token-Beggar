+    def test_namespace_tuple(self, env_trim):
+        tmpl = env_trim.from_string(
+            "{% set ns = namespace(a=0, b=0) %}"
+            "{% set ns.a, ns.b = 1, 2 %}{{ ns.a }}{{ ns.b }}"
+        )
+        assert tmpl.render() == "12"
+
+    def test_namespace_tuple_mixed(self, env_trim):
+        tmpl = env_trim.from_string(
+            "{% set ns = namespace(a=0) %}"
+            "{% set ns.a, x = 1, 2 %}{{ ns.a }}{{ x }}"
+        )
+        assert tmpl.render() == "12"
+
+    def test_namespace_tuple_swap_loop(self, env_trim):
+        tmpl = env_trim.from_string(
+            "{% set ns = namespace(prev='', cur='') %}"
+            "{% for x in ['a', 'b', 'c'] %}"
+            "{% set ns.prev, ns.cur = ns.cur, ns.cur + '/' + x %}"
+            "{% endfor %}{{ ns.prev }}|{{ ns.cur }}"
+        )
+        assert tmpl.render() == "/a/b|/a/b/c"
+
+    def test_namespace_tuple_non_namespace(self, env_trim):
+        tmpl = env_trim.from_string("{% set d = {} %}{% set d.a, x = 1, 2 %}")
+        exc_info = pytest.raises(TemplateRuntimeError, tmpl.render)
+        assert "non-namespace object" in exc_info.value.message
+

index 4f31037c..df06ba82 100644
--- a/tests/test_routing.py
+++ b/tests/test_routing.py
@@ -320,6 +320,82 @@ def test_no_duplicate_different_converters() -> None:
     )
 
 
+def test_no_duplicate_different_methods() -> None:
+    """Rules with disjoint methods are not duplicates."""
+    m = r.Map(
+        [
+            r.Rule("/", endpoint="get", methods=["GET"]),
+            r.Rule("/", endpoint="post", methods=["POST"]),
+        ]
+    )
+    a = m.bind("localhost")
+    assert a.match("/", method="POST") == ("post", {})
+
+
+def test_duplicate_shared_method() -> None:
+    """Rules that share any method are duplicates."""
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/", endpoint="a", methods=["GET", "POST"]),
+                r.Rule("/", endpoint="b", methods=["POST"]),
+            ]
+        )
+
+
+def test_duplicate_no_methods() -> None:
+    """A rule without methods duplicates any rule with the same path."""
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/", endpoint="a"),
+                r.Rule("/", endpoint="b", methods=["POST"]),
+            ]
+        )
+
+
+def test_duplicate_implied_head() -> None:
+    """``HEAD`` is implied by ``GET``, so they are duplicates."""
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/", endpoint="a", methods=["GET"]),
+                r.Rule("/", endpoint="b", methods=["HEAD"]),
+            ]
+        )
+
+
+def test_duplicate_merge_slashes() -> None:
+    """Consecutive slashes are merged before comparing if enabled."""
+    with pytest.raises(DuplicateRuleError):
+        r.Map([r.Rule("/a//b", endpoint="a"), r.Rule("/a/b", endpoint="b")])
+
+    r.Map(
+        [r.Rule("/a//b", endpoint="a"), r.Rule("/a/b", endpoint="b")],
+        merge_slashes=False,
+    )
+
+
+def test_no_duplicate_strict_slashes() -> None:
+    """Branch and leaf rules are not duplicates without strict slashes."""
+    r.Map(
+        [r.Rule("/a", endpoint="a"), r.Rule("/a/", endpoint="b")],
+        strict_slashes=False,
+    )
+
+
+def test_eq_ignores_methods() -> None:
+    """``==`` does not consider methods."""
+    m = r.Map(
+        [
+            r.Rule("/", endpoint="get", methods=["GET"]),
+            r.Rule("/", endpoint="post", methods=["POST"]),
+        ]
+    )
+    a, b = m._rules
+    assert a == b
+
+

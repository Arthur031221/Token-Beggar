diff --git a/src/werkzeug/routing/rules.py b/src/werkzeug/routing/rules.py
index 18cfba1b..07b6cf60 100644
--- a/src/werkzeug/routing/rules.py
+++ b/src/werkzeug/routing/rules.py
@@ -914,6 +914,22 @@ class Rule(RuleFactory):
 
     __hash__ = None  # type: ignore
 
+    def _is_duplicate(self, other: Rule) -> bool:
+        """Check if this rule would match the same requests as another rule, in
+        which case the later rule could never be matched. Unlike ``==``, this
+        considers methods, and any overlap is a duplicate.
+
+        :internal:
+        """
+        if self._parts != other._parts or self.websocket != other.websocket:
+            return False
+
+        # A rule without methods matches any method.
+        if self.methods is None or other.methods is None:
+            return True
+
+        return not self.methods.isdisjoint(other.methods)
+
     def __str__(self) -> str:
         out = self.rule
 

 import tokenize
 import warnings
-from collections.abc import Sequence
+from collections import deque
+from collections.abc import Iterable, Sequence
 from io import BufferedReader, BytesIO
 from typing import (
     TYPE_CHECKING,
@@ -253,6 +254,34 @@ def _check_csv(value: list[str] | tuple[str] | str) -> Sequence[str]:
     return _splitstrip(value)
 
 
+def _check_regexp_csv(value: list[str] | tuple[str] | str) -> Iterable[str]:
+    r"""Split a comma-separated string of regexes, ignoring commas inside braces.
+
+    See: https://github.com/pylint-dev/pylint/issues/7229.
+    """
+    if isinstance(value, (list, tuple)):
+        yield from value
+    else:
+        columns = deque(value)
+        current: list[str] = []
+        depth = 0
+        for char in columns:
+            if char == "{":
+                depth += 1
+            elif char == "}" and depth > 0:
+                depth -= 1
+            if char == "," and depth == 0:
+                item = "".join(current).strip()
+                if item:
+                    yield item
+                current = []
+            else:
+                current.append(char)
+        item = "".join(current).strip()
+        if item:
+            yield item
+
+
 def _comment(string: str) -> str:
     """Return string as a comment."""
     lines = [line.strip() for line in string.splitlines()]

@@ -393,6 +393,29 @@ def isproperty(obj: Any) -> bool:
     return isinstance(obj, property)
 
 
+def getclassproperty(cls: Any, name: str) -> Optional[Any]:
+    """Get the property wrapped by classmethod (class property) from given class.
+
+    Class properties (``@classmethod`` combined with ``@property``) are
+    available since py39.  Accessing them via ``getattr()`` returns the result
+    of the property, so the raw descriptor is looked up via ``__dict__`` of the
+    class and its bases instead.  Return None if *name* is not a class property.
+    """
+    if sys.version_info < (3, 9):
+        return None
+
+    for basecls in getmro(cls):
+        __dict__ = safe_getattr(basecls, '__dict__', {})
+        if name in __dict__:
+            obj = __dict__[name]
+            if isinstance(obj, classmethod) and isproperty(obj.__func__):
+                return obj.__func__
+            else:
+                return None
+
+    return None
+

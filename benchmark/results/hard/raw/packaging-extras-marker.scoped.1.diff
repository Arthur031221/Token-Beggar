diff --git a/tests/test_markers.py b/tests/test_markers.py
index faf0d13..76a86a9 100644
--- a/tests/test_markers.py
+++ b/tests/test_markers.py
@@ -394,3 +394,63 @@ class TestMarker:
     def test_python_full_version_untagged(self):
         with mock.patch("platform.python_version", return_value="3.11.1+"):
             assert Marker("python_full_version < '3.12'").evaluate()
+
+
+class TestPEP751Markers:
+    @pytest.mark.parametrize(
+        "marker_string",
+        [
+            "'a' in extras",
+            '"dev" in dependency_groups',
+            "'a' not in extras",
+            '"dev" not in dependency_groups',
+            "extra == 'a'",
+        ],
+    )
+    def test_parses_and_round_trips(self, marker_string):
+        m = Marker(marker_string)
+        assert Marker(str(m)) == m
+
+    def test_lock_file_defaults(self):
+        assert not Marker("'a' in extras").evaluate(context="lock_file")
+        assert Marker("'a' not in extras").evaluate(context="lock_file")
+        assert not Marker("'a' in dependency_groups").evaluate(context="lock_file")
+        assert Marker("'a' not in dependency_groups").evaluate(context="lock_file")
+
+    def test_extras_normalization(self):
+        env = {"extras": {"Foo_Bar"}}
+        assert Marker("'foo-bar' in extras").evaluate(env, context="lock_file")
+        assert not Marker("'foo-bar' not in extras").evaluate(env, context="lock_file")
+        assert not Marker("'other' in extras").evaluate(env, context="lock_file")
+
+    def test_dependency_groups_normalization(self):
+        env = {"dependency_groups": {"Dev_Tools"}}
+        assert Marker("'dev-tools' in dependency_groups").evaluate(
+            env, context="lock_file"
+        )
+        assert Marker("'x' not in dependency_groups").evaluate(env, context="lock_file")
+
+    def test_metadata_context_extra(self):
+        assert Marker("extra == ''").evaluate()
+        assert Marker("extra == 'a-b'").evaluate({"extra": "A_B"})
+        assert Marker("extra == ''").evaluate({"extra": None})
+
+    def test_requirement_context(self):
+        env = {"extras": frozenset({"a"}), "dependency_groups": frozenset()}
+        assert Marker("'a' in extras").evaluate(env, context="requirement")
+        assert Marker("'dev' not in dependency_groups").evaluate(
+            env, context="requirement"
+        )
+
+    def test_extras_and_dependency_groups_combined(self):
+        env = {"extras": {"a"}, "dependency_groups": {"dev"}}
+        marker = Marker("'a' in extras and 'dev' in dependency_groups")
+        assert marker.evaluate(env, context="lock_file")
+        assert not Marker("'b' in extras or 'test' in dependency_groups").evaluate(
+            env, context="lock_file"
+        )
+
+    def test_extra_and_extras_tokenize_distinctly(self):
+        m = Marker("extra == 'a' or 'a' in extras")
+        assert m._markers[0][0].value == "extra"
+        assert m._markers[2][2].value == "extras"

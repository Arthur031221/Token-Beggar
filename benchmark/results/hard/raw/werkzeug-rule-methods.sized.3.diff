diff --git a/tests/test_routing.py b/tests/test_routing.py
index 4f31037c..f4eb8cd2 100644
--- a/tests/test_routing.py
+++ b/tests/test_routing.py
@@ -320,6 +320,114 @@ def test_no_duplicate_different_converters() -> None:
     )
 
 
+@pytest.mark.parametrize(
+    ("a", "b"),
+    [
+        (["GET"], ["POST"]),
+        (["GET"], ["post", "put"]),
+        # OPTIONS is often added to every rule automatically.
+        (["GET", "OPTIONS"], ["POST", "OPTIONS"]),
+    ],
+)
+def test_no_duplicate_different_methods(a: list[str], b: list[str]) -> None:
+    """Rules that don't share any methods are not duplicates."""
+    m = r.Map(
+        [r.Rule("/", endpoint="a", methods=a), r.Rule("/", endpoint="b", methods=b)]
+    )
+    adapter = m.bind("localhost")
+    assert adapter.match("/", method=a[0].upper()) == ("a", {})
+    assert adapter.match("/", method=b[0].upper()) == ("b", {})
+
+
+@pytest.mark.parametrize(
+    ("a", "b"),
+    [
+        (["GET"], ["GET"]),
+        (["GET", "POST"], ["post", "PUT"]),
+        # HEAD is added automatically if GET is present.
+        (["GET"], ["HEAD"]),
+        # Not specifying methods allows any method.
+        (None, ["POST"]),
+        (["POST"], None),
+        (None, None),
+        # An OPTIONS only rule shadows or is shadowed by the other rule.
+        (["GET", "OPTIONS"], ["OPTIONS"]),
+        (["OPTIONS"], ["OPTIONS"]),
+    ],
+)
+def test_duplicate_shared_methods(a: list[str] | None, b: list[str] | None) -> None:
+    """Rules that share any method are duplicates."""
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [r.Rule("/", endpoint="a", methods=a), r.Rule("/", endpoint="b", methods=b)]
+        )
+
+
+def test_duplicate_websocket_methods() -> None:
+    """Websocket rules with shared methods are duplicates, but not with a
+    non-websocket rule.
+    """
+    m = r.Map(
+        [
+            r.Rule("/", endpoint="http", methods=["GET"]),
+            r.Rule("/", endpoint="ws", methods=["GET"], websocket=True),
+        ]
+    )
+
+    with pytest.raises(DuplicateRuleError):
+        m.add(r.Rule("/", endpoint="ws2", websocket=True))
+
+
+@pytest.mark.parametrize("strict_slashes", [True, False])
+def test_no_duplicate_branch_leaf(strict_slashes: bool) -> None:
+    """A branch and leaf rule are not duplicates, regardless of
+    ``strict_slashes``.
+    """
+    m = r.Map(
+        [r.Rule("/a", endpoint="leaf"), r.Rule("/a/", endpoint="branch")],
+        strict_slashes=strict_slashes,
+    )
+    adapter = m.bind("localhost")
+    assert adapter.match("/a") == ("leaf", {})
+    assert adapter.match("/a/") == ("branch", {})
+
+
+def test_duplicate_merge_slashes() -> None:
+    """Rules that are equal after merging slashes are duplicates."""
+    with pytest.raises(DuplicateRuleError):
+        r.Map([r.Rule("/a/b", endpoint="a"), r.Rule("/a//b", endpoint="b")])
+
+
+@pytest.mark.parametrize(("map_merge", "rule_merge"), [(False, None), (True, False)])
+def test_no_duplicate_merge_slashes_disabled(
+    map_merge: bool, rule_merge: bool | None
+) -> None:
+    """If merging slashes is disabled, rules with different slashes are not
+    duplicates.
+    """
+    m = r.Map(
+        [
+            r.Rule("/a/b", endpoint="a"),
+            r.Rule("/a//b", endpoint="b", merge_slashes=rule_merge),
+        ],
+        merge_slashes=map_merge,
+    )
+    adapter = m.bind("localhost")
+    assert adapter.match("/a/b") == ("a", {})
+    assert adapter.match("/a//b") == ("b", {})
+
+
+def test_rule_eq_unchanged() -> None:
+    """Rule equality compares the path, and is separate from the duplicate
+    check.
+    """
+    a = r.Rule("/", endpoint="a", methods=["GET"])
+    b = r.Rule("/", endpoint="b", methods=["POST"])
+    r.Map([a, b])
+    assert a == b
+    assert not a._is_duplicate(b)
+
+

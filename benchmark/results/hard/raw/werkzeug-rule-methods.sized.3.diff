+    def _is_duplicate(self, other: Rule) -> bool:
+        """Check if this rule would match the same requests as another rule,
+        meaning one of them can't be reached. Both rules must be bound to the
+        same map.
+
+        The parts must be equal, which accounts for the subdomain or host, and
+        ``merge_slashes``. Variable parts are equal if they use the same
+        converter. ``strict_slashes`` doesn't matter, since a branch (trailing
+        slash) and leaf (no trailing slash) are always different parts. The
+        websocket mode must be equal, and the rules must share at least one
+        method.
+
+        :internal:
+        """
+        if self._parts != other._parts or self.websocket != other.websocket:
+            return False
 
-        return self._parts == other._parts and self.websocket == other.websocket
+        # None means the rule allows any method.
+        if self.methods is None or other.methods is None:
+            return True
+
+        shared = self.methods & other.methods
+
+        # OPTIONS is often added to every rule automatically, such as by Flask,
+        # to respond with all the methods allowed by any rule for the path.
+        # Sharing only OPTIONS is not a duplicate, unless a rule is only for
+        # OPTIONS, in which case it can't be reached.
+        if shared == {"OPTIONS"}:
+            return self.methods == shared or other.methods == shared
+
+        return bool(shared)
+
+    def __eq__(self, other: object) -> bool:
+        return isinstance(other, type(self)) and self._trace == other._trace
 

@@ -1,5 +1,6 @@
 from __future__ import annotations
 
+import os
 import re
 from typing import TYPE_CHECKING, Any, cast
 
@@ -8,6 +9,7 @@ from docutils.parsers.rst import directives
 from docutils.parsers.rst.directives.admonitions import BaseAdmonition
 from docutils.parsers.rst.directives.misc import Class
 from docutils.parsers.rst.directives.misc import Include as BaseInclude
+from docutils.statemachine import StateMachine
 
 from sphinx import addnodes
 from sphinx.domains.changeset import VersionChange  # noqa: F401  # for compatibility
@@ -376,7 +378,39 @@ class Include(BaseInclude, SphinxDirective):
         rel_filename, filename = self.env.relfn2path(self.arguments[0])
         self.arguments[0] = filename
         self.env.note_included(filename)
-        return super().run()
+
+        # Only patch the state machine if there are 'source-read' listeners.
+        if not self.env.events.listeners.get('source-read'):
+            return super().run()
+
+        # The docutils Include directive passes the included lines to
+        # ``state_machine.insert_input()`` when including as reST source.
+        # Intercept that call so that the "source-read" event is emitted for
+        # the included content, as it is for regular source files.
+        def _insert_input(include_lines: list[str], source: str) -> None:
+            # The last two lines are markers added by docutils
+            # (cf. parsers.rst.states.Body.comment()); keep them out of the event.
+            text = '\n'.join(include_lines[:-2])
+
+            path = os.path.abspath(source)
+            docname = self.env.path2doc(path)
+            if docname is None:
+                # the included file is not a document (e.g. ``*.inc``)
+                docname = os.path.splitext(os.path.relpath(path, self.env.srcdir))[0]
+                docname = docname.replace(os.path.sep, '/')
+
+            arg = [text]
+            self.env.events.emit('source-read', docname, arg)
+            include_lines = arg[0].splitlines() + include_lines[-2:]
+
+            # Call the class method; only the instance attribute is patched.
+            return StateMachine.insert_input(self.state_machine, include_lines, source)
+
+        self.state_machine.insert_input = _insert_input  # type: ignore[method-assign]
+        try:
+            return super().run()
+        finally:
+            del self.state_machine.insert_input
 
 

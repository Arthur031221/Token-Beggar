diff --git a/tests/test_directive_other.py b/tests/test_directive_other.py
index f221db075..7fe850399 100644
--- a/tests/test_directive_other.py
+++ b/tests/test_directive_other.py
@@ -148,3 +148,30 @@ def test_toctree_twice(app):
     assert_node(doctree[0][0],
                 entries=[(None, 'foo'), (None, 'foo')],
                 includefiles=['foo', 'foo'])
+
+
+@pytest.mark.sphinx(testroot='directive-include')
+def test_include_source_read_event(app):
+    sources_reported = {}
+
+    def source_read_handler(app, doc, source):
+        sources_reported[doc] = source[0]
+
+    app.connect('source-read', source_read_handler)
+    text = ".. include:: baz/baz.inc\n"
+    restructuredtext.parse(app, text, 'index')
+    assert sources_reported['baz/baz'] == 'Baz was here: &REPLACE_ME;'
+
+
+@pytest.mark.sphinx(testroot='directive-include')
+def test_include_source_read_event_modifies_content(app):
+    def source_read_handler(app, doc, source):
+        source[0] = source[0].replace('&REPLACE_ME;', 'REPLACED')
+
+    app.connect('source-read', source_read_handler)
+    app.build()
+
+    content = (app.outdir / 'index.html').read_text(encoding='utf8')
+    assert '&amp;REPLACE_ME;' not in content
+    assert '<p>Baz was here: REPLACED</p>' in content
+    assert content.count('<p>REPLACED</p>') == 2

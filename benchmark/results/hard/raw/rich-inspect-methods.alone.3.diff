+
+
+def test_inspect_method_docstring_with_control_codes():
+    # Control codes in a multi-line docstring used to raise an IndexError
+    class Thing:
+        def method(self):
+            """Hello\x08\r
+            World\x0b\x0c!"""
+
+    result = render(Thing(), methods=True, width=60)
+    print(repr(result))
+    expected = (
+        "╭─ <class 'tests.test_inspect.test_inspect_method_docstrin─╮\n"
+        "│ method = def method():                                   │\n"
+        "│          Hello                                           │\n"
+        "│          World!                                          │\n"
+        "╰──────────────────────────────────────────────────────────╯\n"
+    )
+    assert result == expected

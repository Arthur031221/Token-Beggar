+
+def test_control_codes_with_highlighted_spans():
+    # Length must match the stripped text, or spans overrun it and divide() fails
+    text = Text("Hello\x08\r\nWorld\x0b\x0c!")
+    assert text.plain == "Hello\nWorld!"
+    assert len(text) == len(text.plain)
+    text.stylize("bold")
+    text.append(Text("foo\rbar", style="italic"))
+    assert len(text) == len(text.plain)
+    lines = text.wrap(Console(), 80)
+    assert [line.plain for line in lines] == ["Hello", "World!foobar"]
 
 

diff --git a/docs/releases/4.2.txt b/docs/releases/4.2.txt
index 39cf05f23b..c53a1e060d 100644
--- a/docs/releases/4.2.txt
+++ b/docs/releases/4.2.txt
@@ -239,6 +239,10 @@ Models
 * :class:`F() <django.db.models.F>` expressions that output ``BooleanField``
   can now be negated using ``~F()`` (inversion operator).
 
+* :meth:`.QuerySet.count` and :meth:`.QuerySet.aggregate` now strip
+  annotations that aren't referenced by the requested aggregations, filters,
+  ordering, or grouping from the generated SQL.
+
 * ``Model`` now provides asynchronous versions of some methods that use the
   database, using an ``a`` prefix: :meth:`~.Model.adelete`,
   :meth:`~.Model.arefresh_from_db`, and :meth:`~.Model.asave`.
diff --git a/tests/aggregation/tests.py b/tests/aggregation/tests.py
index 39c8a45707..1a95387b35 100644
--- a/tests/aggregation/tests.py
+++ b/tests/aggregation/tests.py
@@ -2084,3 +2084,101 @@ class AggregateTestCase(TestCase):
             exists=Exists(Author.objects.extra(where=["1=0"])),
         )
         self.assertEqual(len(qs), 6)
+
+    def test_aggregation_unused_annotation_stripped(self):
+        with CaptureQueriesContext(connection) as ctx:
+            self.assertEqual(Book.objects.annotate(Count("authors")).count(), 6)
+        sql = ctx.captured_queries[0]["sql"].lower()
+        # The unused aggregate annotation isn't selected in the subquery but
+        # the subquery is still grouped to preserve the number of rows.
+        self.assertEqual(sql.count("count("), 1)
+        self.assertIn("group by", sql)
+
+    def test_aggregation_unused_non_aggregate_annotation_stripped(self):
+        qs = Book.objects.annotate(double_pages=F("pages") * 2)
+        with CaptureQueriesContext(connection) as ctx:
+            self.assertEqual(qs.count(), 6)
+        sql = ctx.captured_queries[0]["sql"].lower()
+        # No subquery is required as no aggregation is involved.
+        self.assertEqual(sql.count("select"), 1)
+        self.assertNotIn("double_pages", sql)
+        self.assertNotIn("pages", sql)
+
+    def test_aggregation_referenced_annotation_kept(self):
+        qs = Publisher.objects.annotate(
+            double_num_awards=F("num_awards") * 2,
+            unused_num_books=Count("book"),
+            unused_double=F("num_awards") * 2,
+        )
+        with CaptureQueriesContext(connection) as ctx:
+            result = qs.aggregate(Sum("double_num_awards"))
+        self.assertEqual(result, {"double_num_awards__sum": 40})
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertIn("double_num_awards", sql)
+        self.assertNotIn("unused_num_books", sql)
+        self.assertNotIn("unused_double", sql)
+
+    def test_aggregation_non_aggregate_annotation_inlined(self):
+        qs = Publisher.objects.annotate(
+            double_num_awards=F("num_awards") * 2,
+            unused=F("num_awards") + 1,
+        )
+        with CaptureQueriesContext(connection) as ctx:
+            result = qs.aggregate(Sum("double_num_awards"))
+        self.assertEqual(result, {"double_num_awards__sum": 40})
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertEqual(sql.count("select"), 1)
+        self.assertNotIn("unused", sql)
+
+    def test_aggregation_unused_annotation_group_by_preserved(self):
+        qs = Book.objects.values("publisher").annotate(
+            num_books=Count("id"), max_pages=Max("pages")
+        )
+        self.assertEqual(
+            qs.count(),
+            Publisher.objects.filter(book__isnull=False).distinct().count(),
+        )
+        alias_qs = (
+            Book.objects.annotate(double_rating=F("rating") * 2)
+            .values("double_rating")
+            .annotate(num_books=Count("id"))
+        )
+        self.assertEqual(alias_qs.count(), len(alias_qs))
+
+    def test_aggregation_unused_annotation_filtered(self):
+        qs = Book.objects.annotate(num_authors=Count("authors")).filter(
+            num_authors__gt=1
+        )
+        self.assertEqual(qs.count(), 3)
+        self.assertEqual(qs.count(), len(qs))
+
+    def test_aggregation_unused_annotation_ordered_slice(self):
+        qs = Book.objects.annotate(num_authors=Count("authors")).order_by(
+            "-num_authors", "pk"
+        )
+        self.assertEqual(qs[:2].count(), 2)
+        self.assertEqual(qs[1:].count(), 5)
+
+    def test_aggregation_over_subquery_annotation_with_unused_annotation(self):
+        latest_book_pages = Subquery(
+            Book.objects.filter(publisher=OuterRef("pk"))
+            .order_by("-pk")
+            .values("pages")[:1]
+        )
+        qs = Publisher.objects.annotate(
+            latest_book_pages=latest_book_pages,
+            unused=F("num_awards") + 1,
+        )
+        expected = sum(p.latest_book_pages or 0 for p in qs)
+        self.assertEqual(
+            qs.aggregate(Sum("latest_book_pages")),
+            {"latest_book_pages__sum": expected},
+        )
+        qs = Publisher.objects.annotate(
+            latest_book_pages=Coalesce(latest_book_pages, 0),
+            unused=F("num_awards") + 1,
+        )
+        self.assertEqual(
+            qs.aggregate(Sum("latest_book_pages")),
+            {"latest_book_pages__sum": expected},
+        )

diff --git a/pylint/utils/utils.py b/pylint/utils/utils.py
index fa7f7b92f..4379b1bc3 100644
--- a/pylint/utils/utils.py
+++ b/pylint/utils/utils.py
@@ -253,6 +253,64 @@ def _check_csv(value: list[str] | tuple[str] | str) -> Sequence[str]:
     return _splitstrip(value)
 
 
+def _check_regexp_csv(value: list[str] | tuple[str] | str) -> Sequence[str]:
+    r"""Split a comma-separated list of regular expressions.
+
+    Unlike ``_check_csv``, commas that are part of a regular expression are not
+    treated as separators, i.e. commas that are escaped (``\,``) or that appear
+    inside a quantifier (``{1,3}``), a group (``(a,b)``) or a character class
+    (``[,;]``).
+
+    >>> _check_regexp_csv(r'foo{1,3}, (a,b), [,;], a\,b,,')
+    ['foo{1,3}', '(a,b)', '[,;]', 'a\\,b']
+    """
+    if isinstance(value, (list, tuple)):
+        return value
+    regexps: list[str] = []
+    current: list[str] = []
+    paren_depth = 0
+    in_braces = False
+    in_class = False
+    index = 0
+    while index < len(value):
+        char = value[index]
+        if char == "\\":
+            # Keep escape sequences (including '\,') untouched
+            current.append(value[index : index + 2])
+            index += 2
+            continue
+        if in_class:
+            if char == "]":
+                in_class = False
+        elif char == "[":
+            in_class = True
+            # A ']' right after '[' or '[^' is a literal and doesn't close the class
+            next_index = index + 1
+            if value[next_index : next_index + 1] == "^":
+                next_index += 1
+            if value[next_index : next_index + 1] == "]":
+                current.append(value[index : next_index + 1])
+                index = next_index + 1
+                continue
+        elif char == "{":
+            in_braces = True
+        elif char == "}":
+            in_braces = False
+        elif char == "(":
+            paren_depth += 1
+        elif char == ")" and paren_depth:
+            paren_depth -= 1
+        elif char == "," and not (in_braces or paren_depth):
+            regexps.append("".join(current))
+            current = []
+            index += 1
+            continue
+        current.append(char)
+        index += 1
+    regexps.append("".join(current))
+    return [regexp.strip() for regexp in regexps if regexp.strip()]
+
+
 def _comment(string: str) -> str:
     """Return string as a comment."""
     lines = [line.strip() for line in string.splitlines()]
diff --git a/tests/config/test_config.py b/tests/config/test_config.py
index 83c8b072e..badfb59e8 100644
--- a/tests/config/test_config.py
+++ b/tests/config/test_config.py
@@ -137,16 +137,59 @@ def test_csv_regex_error(capsys: CaptureFixture) -> None:
     """
     with pytest.raises(SystemExit):
         Run(
-            [str(EMPTY_MODULE), r"--bad-names-rgx=(foo{1,3})"],
+            [str(EMPTY_MODULE), r"--bad-names-rgxs=(foo{1,3}),(bar"],
             exit=False,
         )
     output = capsys.readouterr()
     assert (
-        r"Error in provided regular expression: (foo{1 beginning at index 0: missing ), unterminated subpattern"
+        r"Error in provided regular expression: (bar beginning at index 0: missing ), unterminated subpattern"
         in output.err
     )
 
 
+@pytest.mark.parametrize(
+    "in_string,expected",
+    [
+        ("foo{1,3}", ["foo{1,3}"]),
+        ("(foo{1,3})", ["(foo{1,3})"]),
+        ("foo, bar{1,3}, baz", ["foo", "bar{1,3}", "baz"]),
+        ("(?:foo,bar), baz", ["(?:foo,bar)", "baz"]),
+        ("(a(b,c)d,e), f", ["(a(b,c)d,e)", "f"]),
+        ("[,;], foo", ["[,;]", "foo"]),
+        ("[],], foo", ["[],]", "foo"]),
+        ("[^],], foo", ["[^],]", "foo"]),
+        (r"foo\,bar, baz", [r"foo\,bar", "baz"]),
+        (r"foo\\, bar", [r"foo\\", "bar"]),
+        ("foo,,bar,", ["foo", "bar"]),
+    ],
+)
+def test_csv_regex_comma_in_regex(in_string: str, expected: list[str]) -> None:
+    """Check that commas that are part of a regular expression aren't treated
+    as separators.
+
+    Reported in https://github.com/pylint-dev/pylint/issues/7229.
+    """
+    r = Run([str(EMPTY_MODULE), f"--bad-names-rgxs={in_string}"], exit=False)
+    assert [
+        pattern.pattern for pattern in r.linter.config.bad_names_rgxs
+    ] == expected
+
+
+def test_csv_regex_comma_in_regex_toml(tmp_path: Path) -> None:
+    """The example from https://github.com/pylint-dev/pylint/issues/7229."""
+    config_file = tmp_path / "pyproject.toml"
+    config_file.write_text(
+        """
+[tool.pylint.basic]
+bad-names-rgxs = "(foo{1,3})"
+"""
+    )
+    r = Run([str(EMPTY_MODULE), f"--rcfile={config_file}"], exit=False)
+    assert [pattern.pattern for pattern in r.linter.config.bad_names_rgxs] == [
+        "(foo{1,3})"
+    ]
+
+

+class FootnoteReorderTreeprocessor(Treeprocessor):
+    """ Reorder footnote list items by first reference and fix backlink titles. """
+
+    def __init__(self, footnotes: FootnoteExtension):
+        self.footnotes = footnotes
+
+    def run(self, root: etree.Element) -> None:
+        fns = self.footnotes
+        if fns.getConfig("USE_DEFINITION_ORDER") or not fns.footnotes:
+            return
+
+        fn_ids = [fns.makeFootnoteId(id) for id in fns.footnotes]
+        div, items = None, {}
+        for el in root.iter('div'):
+            if el.attrib.get('class', '') == 'footnote':
+                ol = el.find('ol')
+                if ol is not None and [li.attrib.get('id') for li in ol] == fn_ids:
+                    div, items = el, {li.attrib['id']: li for li in ol}
+                    break
+        if div is None:
+            return
+
+        # Collect references in final reading order: first the document body,
+        # then the text of each footnote as it is placed in the list. Inline
+        # processing does not necessarily visit elements in document order, so
+        # walk the tree rather than recording order during inline processing.
+        order: list[str] = []
+        refs: list[tuple[etree.Element, str]] = []
+
+        def collect(parent: etree.Element) -> None:
+            for el in parent:
+                if el is div:
+                    continue
+                if el.tag == 'a' and el.attrib.get('class', '') == 'footnote-ref':
+                    href = el.attrib.get('href', '')[1:]
+                    if href in items:
+                        refs.append((el, href))
+                        if href not in order:
+                            order.append(href)
+                collect(el)
+
+        collect(root)
+        scanned = 0
+        while True:
+            # Scan each placed footnote for references to further footnotes.
+            while scanned < len(order):
+                collect(items[order[scanned]])
+                scanned += 1
+            # Unreferenced footnotes follow the referenced ones in definition order.
+            unreferenced = [fn_id for fn_id in fn_ids if fn_id not in order]
+            if not unreferenced:
+                break
+            order.append(unreferenced[0])
+
+        position = {fn_id: n for n, fn_id in enumerate(order, start=1)}
+        for a, href in refs:
+            a.text = fns.getConfig("SUPERSCRIPT_TEXT").format(position[href])
+
+        ol = div.find('ol')
+        backlink_title = fns.getConfig("BACKLINK_TITLE").replace("%d", "{}")
+        for li in list(ol):
+            ol.remove(li)
+        for fn_id in order:
+            li = items[fn_id]
+            ol.append(li)
+            for a in li.iter('a'):
+                if a.attrib.get('class', '') == 'footnote-backref':
+                    a.set('title', backlink_title.format(position[fn_id]))
+
+
 class FootnotePostTreeprocessor(Treeprocessor):
     """ Amend footnote div with duplicates. """
 
diff --git a/tests/test_syntax/extensions/test_footnotes.py b/tests/test_syntax/extensions/test_footnotes.py

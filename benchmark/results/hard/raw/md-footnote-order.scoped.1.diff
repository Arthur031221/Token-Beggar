@@ -336,3 +336,79 @@ class TestFootnotes(TestCase):
             '</div>',
             extension_configs={'footnotes': {'SUPERSCRIPT_TEXT': '[{}]'}}
         )
+
+    def _order(self, text, **config):
+        import re
+        import markdown
+        html = markdown.markdown(text, extensions=['footnotes'], extension_configs={'footnotes': config})
+        nums = re.findall(r'class="footnote-ref" href="#fn:(\w+)">(\d+)</a>', html)
+        lis = re.findall(r'<li id="fn:(\w+)">', html)
+        titles = re.findall(r'title="Jump back to footnote (\d+) in the text"', html)
+        return nums, lis, titles, html
+
+    def test_reference_order(self):
+        text = 'one[^b] two[^a]\n\n[^a]: A\n[^b]: B\n'
+        nums, lis, titles, _ = self._order(text)
+        self.assertEqual(nums, [('b', '1'), ('a', '2')])
+        self.assertEqual(lis, ['b', 'a'])
+        self.assertEqual(titles, ['1', '2'])
+
+    def test_definition_order(self):
+        text = 'one[^b] two[^a]\n\n[^a]: A\n[^b]: B\n'
+        nums, lis, titles, _ = self._order(text, USE_DEFINITION_ORDER=True)
+        self.assertEqual(nums, [('b', '2'), ('a', '1')])
+        self.assertEqual(lis, ['a', 'b'])
+        self.assertEqual(titles, ['1', '2'])
+
+    def test_unreferenced_last(self):
+        text = 'one[^c]\n\n[^a]: A\n[^b]: B\n[^c]: C\n'
+        nums, lis, titles, _ = self._order(text)
+        self.assertEqual(nums, [('c', '1')])
+        self.assertEqual(lis, ['c', 'a', 'b'])
+        self.assertEqual(titles, ['1', '2', '3'])
+
+    def test_duplicate_references(self):
+        text = 'x[^b] y[^a] z[^b]\n\n[^a]: A\n[^b]: B\n'
+        nums, lis, _, html = self._order(text)
+        self.assertEqual(nums, [('b', '1'), ('a', '2'), ('b', '1')])
+        self.assertEqual(lis, ['b', 'a'])
+        self.assertIn('href="#fnref:b"', html)
+        self.assertIn('href="#fnref2:b"', html)
+
+    def test_nested_reference(self):
+        text = 'x[^b] y[^a]\n\n[^a]: A has[^c]\n[^b]: B\n[^c]: C\n'
+        nums, lis, titles, _ = self._order(text)
+        self.assertEqual(nums, [('b', '1'), ('a', '2'), ('c', '3')])
+        self.assertEqual(lis, ['b', 'a', 'c'])
+        self.assertEqual(titles, ['1', '2', '3'])
+
+    def test_nested_reference_follows_reading_order(self):
+        # `b` is listed first, so the footnote it references (`d`) comes before `c`.
+        text = 'x[^b] y[^a]\n\n[^a]: A has[^c]\n[^b]: B has[^d]\n[^c]: C\n[^d]: D\n'
+        nums, lis, titles, _ = self._order(text)
+        self.assertEqual(nums, [('b', '1'), ('a', '2'), ('d', '3'), ('c', '4')])
+        self.assertEqual(lis, ['b', 'a', 'd', 'c'])
+        self.assertEqual(titles, ['1', '2', '3', '4'])
+
+    def test_issue_example(self):
+        self.assertMarkdownRenders(
+            'defined[^definedsecond] occurrence[^definedfirst]\n\n'
+            '[^definedfirst]: blah\n'
+            '[^definedsecond]: blurb',
+            '<p>defined<sup id="fnref:definedsecond"><a class="footnote-ref" href="#fn:definedsecond">1</a></sup> '
+            'occurrence<sup id="fnref:definedfirst"><a class="footnote-ref" href="#fn:definedfirst">2</a></sup></p>\n'
+            '<div class="footnote">\n'
+            '<hr />\n'
+            '<ol>\n'
+            '<li id="fn:definedsecond">\n'
+            '<p>blurb&#160;<a class="footnote-backref" href="#fnref:definedsecond" '
+            'title="Jump back to footnote 1 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '<li id="fn:definedfirst">\n'
+            '<p>blah&#160;<a class="footnote-backref" href="#fnref:definedfirst" '
+            'title="Jump back to footnote 2 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '</ol>\n'
+            '</div>',
+            extensions=['footnotes']
+        )

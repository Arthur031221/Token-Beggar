@@ -148,3 +148,54 @@ def test_toctree_twice(app):
     assert_node(doctree[0][0],
                 entries=[(None, 'foo'), (None, 'foo')],
                 includefiles=['foo', 'foo'])
+
+
+
+@pytest.mark.sphinx(testroot='directive-include')
+def test_include_source_read_event(app):
+    sources_reported = []
+
+    def source_read_handler(app, docname, source):
+        sources_reported.append((docname, source[0]))
+
+    app.connect('source-read', source_read_handler)
+    text = ('.. include:: bar.txt\n'
+            '   :literal:\n'
+            '\n'
+            '.. include:: baz/baz.rst\n'
+            '   :start-line: 1\n')
+    app.env.find_files(app.config, app.builder)
+    restructuredtext.parse(app, text, 'index')
+
+    # literal includes are not parsed as reST, so no event is emitted for them;
+    # the nested ``text.inc`` is not a document, so the including docname is used
+    assert sources_reported == [
+        ('index', text),
+        ('baz/baz', '\n.. include:: /text.inc'),
+        ('index', 'The #magical inc.'),
+    ]
+
+
+@pytest.mark.sphinx(testroot='directive-include')
+def test_include_source_read_event_nested_includes(app):
+    def source_read_handler(app, docname, source):
+        source[0] = source[0].replace('#magical', 'amazing')
+
+    app.connect('source-read', source_read_handler)
+    app.env.find_files(app.config, app.builder)
+    doctree = restructuredtext.parse(app, '.. include:: foo.rst\n', 'index')
+    paragraphs = [node.astext() for node in doctree.findall(nodes.paragraph)]
+    assert paragraphs == ['The amazing foo.', 'Baz was here.', 'The amazing inc.']
+
+
+@pytest.mark.sphinx('html', testroot='directive-include')
+def test_include_source_read_event_build(app):
+    def source_read_handler(app, docname, source):
+        source[0] = source[0].replace('#magical', 'amazing')
+
+    app.connect('source-read', source_read_handler)
+    app.build()
+    content = (app.outdir / 'index.html').read_text(encoding='utf8')
+    assert 'The amazing foo.' in content
+    assert 'The amazing inc.' in content
+    assert '#magical' not in content

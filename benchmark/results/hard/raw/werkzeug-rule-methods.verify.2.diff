+def test_no_duplicate_different_methods() -> None:
+    """Rules with disjoint methods are not duplicates."""
+    m = r.Map(
+        [
+            r.Rule("/", endpoint="a", methods=["GET"]),
+            r.Rule("/", endpoint="b", methods=["POST"]),
+        ]
+    )
+    adapter = m.bind("localhost")
+    assert adapter.match("/", method="GET") == ("a", {})
+    assert adapter.match("/", method="POST") == ("b", {})
+
+
+@pytest.mark.parametrize(
+    ("a", "b"),
+    [(["GET", "POST"], ["POST", "PUT"]), (["GET"], ["HEAD"])],
+)
+def test_duplicate_overlapping_methods(a: list[str], b: list[str]) -> None:
+    """Rules sharing any method are duplicates, GET implies HEAD."""
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/", endpoint="a", methods=a),
+                r.Rule("/", endpoint="b", methods=b),
+            ]
+        )
+
+
+@pytest.mark.parametrize("none_first", [True, False])
+def test_duplicate_methods_none(none_first: bool) -> None:
+    """A rule with no methods matches all methods, so overlaps."""
+    rules = [
+        r.Rule("/", endpoint="a", methods=None),
+        r.Rule("/", endpoint="b", methods=["POST"]),
+    ]
+
+    if not none_first:
+        rules.reverse()
+
+    with pytest.raises(DuplicateRuleError):
+        r.Map(rules)
+
+
+@pytest.mark.parametrize("strict_slashes", [False, True])
+def test_no_duplicate_strict_slashes(strict_slashes: bool) -> None:
+    """Rules with and without a trailing slash are not duplicates."""
+    r.Map(
+        [
+            r.Rule("/a", endpoint="a", strict_slashes=strict_slashes),
+            r.Rule("/a/", endpoint="b", strict_slashes=strict_slashes),
+        ]
+    )
+
+
+def test_duplicate_strict_slashes() -> None:
+    """Same trailing slash rules are duplicates regardless of strict_slashes."""
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/a/", endpoint="a", strict_slashes=False),
+                r.Rule("/a/", endpoint="b", strict_slashes=True),
+            ]
+        )
+
+
+def test_duplicate_merge_slashes() -> None:
+    """Merged slashes make rules duplicates unless merging is disabled."""
+    with pytest.raises(DuplicateRuleError):
+        r.Map([r.Rule("/a//b", endpoint="a"), r.Rule("/a/b", endpoint="b")])
+
+    r.Map(
+        [
+            r.Rule("/a//b", endpoint="a", merge_slashes=False),
+            r.Rule("/a/b", endpoint="b"),
+        ]
+    )
+
+

diff --git a/src/werkzeug/routing/rules.py b/src/werkzeug/routing/rules.py
index 18cfba1b..ba389512 100644
--- a/src/werkzeug/routing/rules.py
+++ b/src/werkzeug/routing/rules.py
@@ -914,6 +914,23 @@ class Rule(RuleFactory):
 
     __hash__ = None  # type: ignore
 
+    def _is_duplicate(self, other: Rule) -> bool:
+        """Whether both rules could match the same request. They must have
+        equal parts and websocket mode, and overlapping methods. ``None``
+        methods overlaps with any methods.
+
+        :internal:
+        """
+        return (
+            self._parts == other._parts
+            and self.websocket == other.websocket
+            and (
+                self.methods is None
+                or other.methods is None
+                or not self.methods.isdisjoint(other.methods)
+            )
+        )
+
     def __str__(self) -> str:
         out = self.rule
 

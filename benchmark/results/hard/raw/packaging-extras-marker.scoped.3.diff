diff --git a/tests/test_markers.py b/tests/test_markers.py
index faf0d13..feabf62 100644
--- a/tests/test_markers.py
+++ b/tests/test_markers.py
@@ -394,3 +394,37 @@ class TestMarker:
     def test_python_full_version_untagged(self):
         with mock.patch("platform.python_version", return_value="3.11.1+"):
             assert Marker("python_full_version < '3.12'").evaluate()
+
+    @pytest.mark.parametrize("var", ["extras", "dependency_groups"])
+    def test_parse_set_variables(self, var):
+        assert str(Marker(f"'foo' in {var}")) == f'"foo" in {var}'
+        assert str(Marker(f'"dev" not in {var}')) == f'"dev" not in {var}'
+
+    def test_lock_file_defaults(self):
+        assert not Marker("'a' in extras").evaluate(context="lock_file")
+        assert Marker("'a' not in extras").evaluate(context="lock_file")
+        assert not Marker("'a' in dependency_groups").evaluate(context="lock_file")
+        assert Marker("'a' not in dependency_groups").evaluate(context="lock_file")
+
+    @pytest.mark.parametrize("var", ["extras", "dependency_groups"])
+    def test_set_normalization(self, var):
+        assert Marker(f"'foo-bar' in {var}").evaluate({var: {"Foo_Bar"}})
+        assert not Marker(f"'foo-bar' not in {var}").evaluate({var: {"Foo_Bar"}})
+        assert Marker(f"'Foo_Bar' in {var}").evaluate(
+            {var: {"foo-bar"}}, context="lock_file"
+        )
+
+    def test_metadata_context_sets_extra(self):
+        assert Marker("extra == ''").evaluate()
+        assert Marker("extra == ''").evaluate(context="metadata")
+        assert Marker("extra == ''").evaluate({"extra": None})  # type: ignore[dict-item]
+
+    def test_requirement_context_no_defaults(self):
+        with pytest.raises(KeyError):
+            Marker("extra == 'a'").evaluate(context="requirement")
+        assert Marker("extra == 'a'").evaluate({"extra": "a"}, context="requirement")
+
+    @pytest.mark.parametrize("context", ["metadata", "requirement"])
+    def test_extras_undefined_without_lock_file(self, context):
+        with pytest.raises(KeyError):
+            Marker("'a' in extras").evaluate(context=context)

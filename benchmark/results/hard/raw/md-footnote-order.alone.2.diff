+class FootnoteReorderingProcessor(Treeprocessor):
+    """ Number and order footnotes by the order of their first reference in the document.
+
+    References in the body of the document are counted first. References made from
+    within footnotes are counted in the order those footnotes appear in the final
+    list. Footnotes which are never referenced come last, in definition order.
+    """
+
+    def __init__(self, footnotes: FootnoteExtension):
+        self.footnotes = footnotes
+
+    def iter_refs(self, element: etree.Element, skip: etree.Element | None = None) -> Iterator[etree.Element]:
+        """ Yield footnote reference links under `element` in document order, ignoring `skip`. """
+        for child in element:
+            if child is skip:
+                continue
+            if child.tag == 'a' and child.attrib.get('class', '') == 'footnote-ref':
+                yield child
+            yield from self.iter_refs(child, skip)
+
+    def run(self, root: etree.Element) -> None:
+        if self.footnotes.getConfig("USE_DEFINITION_ORDER"):
+            return
+        div = self.footnotes.footnotes_div
+        self.footnotes.footnotes_div = None
+        ids = list(self.footnotes.footnotes.keys())
+        if not ids:
+            return
+        # Map the `href` of a reference to the footnote's definition index.
+        hrefs = {'#' + self.footnotes.makeFootnoteId(id): index for index, id in enumerate(ids)}
+        items: dict[int, etree.Element] = {}
+        ol = None
+        if div is not None:
+            ol = div.find('ol')
+            if ol is not None:
+                lis = {li.attrib.get('id'): li for li in ol if li.tag == 'li'}
+                for index, id in enumerate(ids):
+                    li = lis.get(self.footnotes.makeFootnoteId(id))
+                    if li is not None:
+                        items[index] = li
+
+        refs: list[etree.Element] = []
+        order: list[int] = []
+
+        def collect(element: etree.Element, skip: etree.Element | None = None) -> None:
+            for ref in self.iter_refs(element, skip):
+                refs.append(ref)
+                index = hrefs.get(ref.attrib.get('href', ''))
+                if index is not None and index not in order:
+                    order.append(index)
+
+        collect(root, skip=div)
+        pos = 0
+        unreferenced = iter(range(len(ids)))
+        while True:
+            while pos < len(order):
+                if order[pos] in items:
+                    collect(items[order[pos]])
+                pos += 1
+            remaining = next((index for index in unreferenced if index not in order), None)
+            if remaining is None:
+                break
+            order.append(remaining)
+
+        numbers = {index: number for number, index in enumerate(order, start=1)}
+
+        def replace(m: re.Match[str]) -> str:
+            return str(numbers[int(m.group(1)) - 1])
+
+        for ref in refs:
+            for el in ref.iter():
+                if el.text:
+                    el.text = RE_FN_NUMBER_PLACEHOLDER.sub(replace, el.text)
+                if el is not ref and el.tail:
+                    el.tail = RE_FN_NUMBER_PLACEHOLDER.sub(replace, el.tail)
+
+        if ol is not None:
+            ordered = [items[index] for index in order if index in items]
+            for li in ordered:
+                ol.remove(li)
+            for number, li in enumerate(ordered, start=1):
+                ol.append(li)
+                for link in li.iter('a'):
+                    if link.attrib.get('class', '') == 'footnote-backref':
+                        link.set('title', self.footnotes.getBacklinkTitle(number))
+
+

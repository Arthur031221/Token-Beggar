+def test_path_error_message_surrogate_escape(tmp_path, runner, type, make, expect):
+    name = os.fsdecode(tmp_path / os.fsdecode(b"foo\xe9"))
+
+    try:
+        if make == "dir":
+            os.mkdir(name)
+        elif make is not None:
+            open(name, "w").close()
+    except OSError:
+        pytest.skip("Filesystem doesn't allow non-UTF-8 filenames.")
+
+    if make == "ro":

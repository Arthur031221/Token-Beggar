@@ -429,3 +431,29 @@ class PrettifyTreeprocessor(Treeprocessor):
                 # Only prettify code containing text only
                 if not len(code) and code.text is not None:
                     code.text = util.AtomicString(code.text.rstrip() + '\n')
+
+
+class UnescapeTreeprocessor(Treeprocessor):
+    """ Restore escaped chars """
+
+    RE = re.compile(r'{}(\d+){}'.format(util.STX, util.ETX))
+
+    def _unescape(self, m):
+        return chr(int(m.group(1)))
+
+    def unescape(self, text):
+        """ Return text with escaped chars restored, preserving `AtomicString`. """
+        result = self.RE.sub(self._unescape, text)
+        if isinstance(text, util.AtomicString):
+            result = util.AtomicString(result)
+        return result
+
+    def run(self, root):
+        """ Loop over all elements and unescape all text, tails and attribute values. """
+        for elem in root.iter():
+            if elem.text:
+                elem.text = self.unescape(elem.text)
+            if elem.tail:
+                elem.tail = self.unescape(elem.tail)
+            for key, value in elem.items():
+                elem.set(key, self.unescape(value))

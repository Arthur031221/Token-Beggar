diff --git a/tests/test_syntax/extensions/test_footnotes.py b/tests/test_syntax/extensions/test_footnotes.py
index 6f504e3..d978035 100644
--- a/tests/test_syntax/extensions/test_footnotes.py
+++ b/tests/test_syntax/extensions/test_footnotes.py
@@ -336,3 +336,46 @@ class TestFootnotes(TestCase):
             '</div>',
             extension_configs={'footnotes': {'SUPERSCRIPT_TEXT': '[{}]'}}
         )
+
+    def _render(self, text, **config):
+        import markdown
+        return markdown.markdown(text, extensions=['footnotes'], extension_configs={'footnotes': config})
+
+    def test_reference_order(self):
+        text = 'a[^definedsecond] b[^definedfirst]\n\n[^definedfirst]: First\n\n[^definedsecond]: Second'
+        out = self._render(text)
+        self.assertIn('href="#fn:definedsecond">1</a>', out)
+        self.assertIn('href="#fn:definedfirst">2</a>', out)
+        self.assertLess(out.index('<li id="fn:definedsecond">'), out.index('<li id="fn:definedfirst">'))
+        self.assertIn('Jump back to footnote 1 in the text', out.split('<li id="fn:definedsecond">')[1])
+        self.assertIn('Jump back to footnote 2 in the text', out.split('<li id="fn:definedfirst">')[1])
+
+    def test_definition_order(self):
+        text = 'a[^definedsecond] b[^definedfirst]\n\n[^definedfirst]: First\n\n[^definedsecond]: Second'
+        out = self._render(text, USE_DEFINITION_ORDER=True)
+        self.assertIn('href="#fn:definedsecond">2</a>', out)
+        self.assertIn('href="#fn:definedfirst">1</a>', out)
+        self.assertLess(out.index('<li id="fn:definedfirst">'), out.index('<li id="fn:definedsecond">'))
+
+    def test_duplicate_references_reference_order(self):
+        out = self._render('a[^b] c[^a] d[^b]\n\n[^a]: A\n\n[^b]: B')
+        self.assertEqual(out.count('>1</a></sup>'), 2)
+        self.assertEqual(out.count('>2</a></sup>'), 1)
+        self.assertIn('href="#fnref2:b"', out)
+        self.assertLess(out.index('<li id="fn:b">'), out.index('<li id="fn:a">'))
+
+    def test_unreferenced_footnote_goes_last(self):
+        out = self._render('a[^b]\n\n[^u]: Unused\n\n[^b]: B')
+        self.assertLess(out.index('<li id="fn:b">'), out.index('<li id="fn:u">'))
+        self.assertIn('Jump back to footnote 2 in the text', out.split('<li id="fn:u">')[1])
+        self.assertNotIn('#fn:u', out.split('<div class="footnote">')[0])
+
+    def test_nested_footnote_reference(self):
+        text = 'a[^x] b[^z]\n\n[^x]: X refs[^y]\n\n[^y]: Y\n\n[^z]: Z'
+        out = self._render(text)
+        # Order: x (1), z (2), then y (3) first referenced from inside x.
+        self.assertIn('href="#fn:y">3</a>', out)
+        self.assertIn('href="#fn:z">2</a>', out)
+        self.assertLess(out.index('<li id="fn:x">'), out.index('<li id="fn:z">'))
+        self.assertLess(out.index('<li id="fn:z">'), out.index('<li id="fn:y">'))
+        self.assertIn('Jump back to footnote 3 in the text', out.split('<li id="fn:y">')[1])

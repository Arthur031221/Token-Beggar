diff --git a/tests/test_shell_completion.py b/tests/test_shell_completion.py
index 3e7a2bd..29c05d9 100644
--- a/tests/test_shell_completion.py
+++ b/tests/test_shell_completion.py
@@ -414,3 +414,47 @@ def test_add_completion_class_decorator():
     # Using `add_completion_class` as a decorator adds the new shell immediately
     assert "mysh" in click.shell_completion._available_shells
     assert click.shell_completion._available_shells["mysh"] is MyshComplete
+
+
+@pytest.mark.parametrize("chain", [False, True])
+def test_files_closed(tmp_path, chain):
+    """File options opened while resolving the context are closed after
+    completion, but are still open while completing.
+    """
+    path = tmp_path / "config"
+    path.write_text("")
+    files = []
+
+    class RecordFile(File):
+        def convert(self, value, param, ctx):
+            rv = super().convert(value, param, ctx)
+            files.append(rv)
+            return rv
+
+    def complete(ctx, param, incomplete):
+        assert files and not any(f.closed for f in files)
+        return ["done"]
+
+    cli = Group(
+        "cli",
+        chain=chain,
+        params=[Option(["--a"], type=RecordFile())],
+        commands=[
+            Command("x", params=[Option(["--b"], type=RecordFile())]),
+            Command(
+                "y",
+                params=[
+                    Option(["--c"], type=RecordFile()),
+                    Argument(["d"], shell_complete=complete),
+                ],
+            ),
+        ],
+    )
+    args = ["--a", str(path), "y", "--c", str(path)]
+
+    if chain:
+        args[2:2] = ["x", "--b", str(path)]
+
+    assert _get_words(cli, args, "") == ["done"]
+    assert len(files) == (3 if chain else 2)
+    assert all(f.closed for f in files)

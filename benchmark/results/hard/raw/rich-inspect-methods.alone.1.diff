+def test_strip_control_codes_length():
+    # https://github.com/Textualize/rich/issues/2214
+    text = Text("foo\x08bar\x0b\x0c\r")
+    assert text.plain == "foobar"
+    assert len(text) == 6
+    text.stylize("bold")
+    assert text._spans == [Span(0, 6, "bold")]
+
+
+def test_plain_property_setter_strips_control_codes():
+    text = Text("foo")
+    text.plain = "b\x08ar"
+    assert text.plain == "bar"
+    assert len(text) == 3
+
+

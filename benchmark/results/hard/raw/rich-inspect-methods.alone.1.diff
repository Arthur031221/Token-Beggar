--- a/tests/test_inspect.py
+++ b/tests/test_inspect.py
@@ -299,3 +299,23 @@ def test_inspect_module_with_class():
         "╰──────────────────────────────────────────╯\n"
     )
     assert render(module, methods=True) == expected
+
+
+def test_inspect_callable_with_control_codes_in_docstring():
+    """Issue #2214 - docstrings containing control codes such as backspace."""
+
+    def function():
+        """Emulate the ``\b`` behavior of regular expressions."""
+
+    module = ModuleType("my_module")
+    module.function = function
+
+    expected = (
+        "╭───────────────── <module 'my_module'> ─────────────────╮\n"
+        "│ function = def function(): Emulate the ```` behavior   │\n"
+        "│            of regular expressions.                     │\n"
+        "╰────────────────────────────────────────────────────────╯\n"
+    )
+    result = render(module, methods=True, width=58)
+    print(repr(result))
+    assert result == expected

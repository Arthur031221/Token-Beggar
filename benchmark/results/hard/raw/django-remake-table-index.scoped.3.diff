+    @isolate_apps("schema")
+    @skipUnlessDBFeature("supports_collation_on_charfield")
+    def test_alter_primary_key_db_collation_updates_fk(self):
+        collation = connection.features.test_collations.get("non_default")
+        if not collation:
+            self.skipTest("Language collations are not supported.")
+
+        class CollatedParent(Model):
+            id = CharField(max_length=20, primary_key=True)
+
+            class Meta:
+                app_label = "schema"
+
+        class FKChild(Model):
+            parent = ForeignKey(CollatedParent, CASCADE)
+
+            class Meta:
+                app_label = "schema"
+
+        class O2OChild(Model):
+            parent = OneToOneField(CollatedParent, CASCADE)
+
+            class Meta:
+                app_label = "schema"
+
+        with connection.schema_editor() as editor:
+            editor.create_model(CollatedParent)
+            editor.create_model(FKChild)
+            editor.create_model(O2OChild)
+        # Mutate the model's field so that related tables are remade with the
+        # new collation (as happens with migration state models).
+        new_field = CollatedParent._meta.get_field("id")
+        old_field = new_field.clone()
+        old_field.set_attributes_from_name("id")
+        old_field.model = CollatedParent
+        new_field.db_collation = collation
+        with connection.schema_editor() as editor:
+            editor.alter_field(CollatedParent, old_field, new_field, strict=True)
+        for model in (FKChild, O2OChild):
+            self.assertEqual(
+                self.get_column_collation(model._meta.db_table, "parent_id"),
+                collation,
+            )
+            if connection.features.supports_foreign_keys:
+                self.assertTrue(
+                    self.get_constraints_for_column(model, "parent_id")
+                )
+        collated_field = new_field.clone()
+        collated_field.set_attributes_from_name("id")
+        collated_field.model = CollatedParent
+        new_field.db_collation = None
+        with connection.schema_editor() as editor:
+            editor.alter_field(CollatedParent, collated_field, new_field, strict=True)
+        for model in (FKChild, O2OChild):
+            self.assertIsNone(
+                self.get_column_collation(model._meta.db_table, "parent_id")
+            )
+

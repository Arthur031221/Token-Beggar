+def isclassproperty(obj: Any, cls: Any = None, name: str = None) -> bool:
+    """Check if the object is a class property (a classmethod wrapping a property).
+
+    .. note:: The class property is evaluated on attribute access.  So *cls* and
+              *name* are needed to find the descriptor from its owner class.
+    """
+    if isinstance(obj, classmethod) and isproperty(obj.__func__):
+        return True
+    elif cls and name:
+        placeholder = object()
+        for basecls in getmro(cls):
+            meth = basecls.__dict__.get(name, placeholder)
+            if meth is not placeholder:
+                return isclassproperty(meth)
+
+    return False
+

+    def check_namespace_targets(self, target: nodes.Node, frame: Frame) -> None:
+        # The runtime check must be emitted as statements before the
+        # assignment line, since the target may be part of a tuple.
+        refs = list(target.find_all(nodes.NSRef))
+        if isinstance(target, nodes.NSRef):
+            refs.insert(0, target)
+        for ref_node in refs:
+            ref = frame.symbols.ref(ref_node.name)
+            self.writeline(f"if not isinstance({ref}, Namespace):")
+            self.indent()

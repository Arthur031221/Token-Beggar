+def test_inspect_doc_with_control_codes():
+    """Docstrings containing control codes (e.g. pyparsing) shouldn't crash inspect."""
+
+    class Thing:
+        def method(self):
+            """First line\x0c
+
+            Second\r line.
+            """
+
+    console = Console(width=50, file=io.StringIO(), legacy_windows=False)
+    inspect(Thing(), console=console, all=True, value=False)
+    result = console.file.getvalue()
+    assert "First line" in result
+    assert "\x0c" not in result
+    assert "\r" not in result
+
+    console = Console(width=50, file=io.StringIO(), legacy_windows=False)
+    inspect(Thing(), console=console, help=True, methods=True)
+    result = console.file.getvalue()
+    assert "Second line." in result
+

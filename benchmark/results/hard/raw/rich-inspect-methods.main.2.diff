+def test_strip_control_codes_length():
+    text = Text("foo\rbar\x0c")
+    assert text.plain == "foobar"
+    assert len(text) == 6
+    text.append(Text("\x0bbaz", style="bold"))
+    assert text.plain == "foobarbaz"
+    assert len(text) == 9
+    assert text._spans == [Span(6, 9, "bold")]
+    text.plain = "\x08spam\r"
+    assert text.plain == "spam"
+    assert len(text) == 4
+
+
+def test_divide_with_control_codes():
+    text = Text("foo\x0c\nbar", style="bold")
+    text.append(Text("\rbaz", style="red"))
+    lines = text.divide([4])
+    assert [line.plain for line in lines] == ["foo\n", "barbaz"]
+    assert lines[1]._spans == [Span(3, 6, "red")]
+
+

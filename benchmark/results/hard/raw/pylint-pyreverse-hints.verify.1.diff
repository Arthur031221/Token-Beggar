+def test_get_attrs_uses_type_hints():
+    from pylint.pyreverse.diagrams import ClassDiagram
+
+    module = astroid.parse(
+        """
+    class C(object):
+        x: int = 1
+        def __init__(self, a: str = None, b: List[int] = None, c: str = "c"):
+            self.a = a
+            self.b = b
+            self.c = c
+    """
+    )
+    project = astroid.nodes.Module("p", None)
+    linker = Linker(project)
+    linker.visit(module)
+    cls = module["C"]
+    diagram = ClassDiagram("t", "PUB_ONLY")
+    assert diagram.get_attrs(cls) == [
+        "a : Optional[str]",
+        "b : Optional[List[int]]",
+        "c : str",
+        "x : int",
+    ]
diff --git a/tests/unittest_pyreverse_utils.py b/tests/unittest_pyreverse_utils.py
new file mode 100644
index 00000000..0a97bd08
--- /dev/null
+++ b/tests/unittest_pyreverse_utils.py
@@ -0,0 +1,104 @@
+"""Tests for pylint.pyreverse.utils"""
+
+from unittest.mock import patch
+
+import astroid
+import pytest
+
+from pylint.pyreverse.utils import get_annotation, infer_node
+
+
+@pytest.mark.parametrize(
+    "init_method, label",
+    [
+        ("def __init__(self, x: str):                 self.x = x", "str"),
+        ("def __init__(self, x: str = 'str'):         self.x = x", "str"),
+        ("def __init__(self, x: str = None):          self.x = x", "Optional[str]"),
+        ("def __init__(self, x: Optional[str]):       self.x = x", "Optional[str]"),
+        ("def __init__(self, x: Optional[str] = None): self.x = x", "Optional[str]"),
+        ("def __init__(self, x: List[int] = None):    self.x = x", "Optional[List[int]]"),
+        ("def __init__(self, *, x: int = 1):          self.x = x", "int"),
+        ("def __init__(self, x: int, /):              self.x = x", "int"),
+        ("def __init__(self, x: datetime.date):       self.x = x", "datetime.date"),
+    ],
+)
+def test_get_annotation_assignattr(init_method, label):
+    node = astroid.extract_node(
+        f"""
+    class A:
+        {init_method}
+    """
+    )
+    (assign_attr,) = node.instance_attrs["x"]
+    assert isinstance(assign_attr, astroid.AssignAttr)
+    assert get_annotation(assign_attr).as_string() == label
+
+
+@pytest.mark.parametrize(
+    "assign, label",
+    [
+        ("a: str = None", "Optional[str]"),
+        ("a: str = 'mystr'", "str"),
+        ("a: Optional[str] = 'str'", "Optional[str]"),
+        ("a: Optional[str] = None", "Optional[str]"),
+        ("a: int", "int"),
+    ],
+)
+def test_get_annotation_annassign(assign, label):
+    node = astroid.extract_node(assign)
+    assert get_annotation(node).as_string() == label
+    assert get_annotation(node.target).as_string() == label
+
+
+@pytest.mark.parametrize(
+    "code",
+    [
+        "x = 1  #@",
+        "def f(self, c=3):\n    self.c = c  #@",
+        "def f(self, c: int):\n    self.c = c + 1  #@",
+    ],
+)
+def test_get_annotation_none(code):
+    node = astroid.extract_node(code)
+    assert get_annotation(node.targets[0]) is None
+
+
+def test_infer_node_uses_annotation():
+    node = astroid.extract_node(
+        """
+    class C:
+        def __init__(self, a: str = 'a'):
+            self.a = a  #@
+    """
+    )
+    values = infer_node(node.targets[0])
+    assert len(values) == 1
+    (value,) = values
+    assert isinstance(value, astroid.ClassDef)
+    assert value.name == "str"
+
+
+def test_infer_node_uninferable_annotation():
+    node = astroid.extract_node(
+        """
+    class C:
+        def __init__(self, a: str = None):
+            self.a = a  #@
+    """
+    )
+    (value,) = infer_node(node.targets[0])
+    assert value.as_string() == "Optional[str]"
+
+
+@patch("pylint.pyreverse.utils.get_annotation", return_value=None)
+@patch("astroid.node_classes.NodeNG.infer", side_effect=astroid.InferenceError)
+def test_infer_node_inference_error(mock_infer, _mock_get_annotation):
+    node = astroid.extract_node("a = 1  #@")
+    assert infer_node(node.targets[0]) == set()
+    assert mock_infer.called
+
+
+def test_infer_node_without_annotation():
+    node = astroid.extract_node("x = 1  #@")
+    (value,) = infer_node(node.targets[0])
+    assert value.value == 1

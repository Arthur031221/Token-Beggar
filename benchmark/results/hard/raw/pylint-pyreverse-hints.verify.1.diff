--- a/pylint/pyreverse/utils.py
+++ b/pylint/pyreverse/utils.py
@@ -20,6 +20,8 @@ import os
 import re
 import sys
 
+import astroid
+
 RCFILE = ".pyreverserc"
 
 
@@ -213,3 +215,85 @@ class LocalsVisitor(ASTWalker):
         if methods[1] is not None:
             return methods[1](node)
         return None
+
+
+def _annotated_argument(node):
+    """Return (annotation, default) of the function argument assigned to node.
+
+    Handles ``self.a = a`` (or ``b = a``) where ``a`` is an argument of the
+    enclosing function. Returns (None, None) if there is no such argument.
+    """
+    value = node.parent.value
+    if not isinstance(value, astroid.Name):
+        return None, None
+    func = node.scope()
+    if not isinstance(func, astroid.FunctionDef):
+        return None, None
+    args = func.args
+    groups = (
+        (getattr(args, "posonlyargs", None), getattr(args, "posonlyargs_annotations", None)),
+        (args.args, args.annotations),
+        (args.kwonlyargs, args.kwonlyargs_annotations),
+    )
+    for names, annotations in groups:
+        for arg, annotation in zip(names or [], annotations or []):
+            if arg.name == value.name:
+                try:
+                    default = args.default_value(arg.name)
+                except astroid.NoDefault:
+                    default = None
+                return annotation, default
+    return None, None
+
+
+def get_annotation(node):
+    """Return the type annotation node of an assignment target, or None.
+
+    Supports annotated assignments (``x: int = 1``) and assignments of an
+    annotated function argument (``self.a = a`` in ``def __init__(self, a: str)``).
+    If the annotation is not a (dotted) name, or the default value is ``None``,
+    a ``Name`` node labelled with the annotation (e.g. ``Optional[str]``) is
+    returned instead of the original one.
+    """
+    if isinstance(node, astroid.AnnAssign):
+        ann, default = node.annotation, node.value
+    elif isinstance(node.parent, astroid.AnnAssign):
+        ann, default = node.parent.annotation, node.parent.value
+    elif isinstance(node, (astroid.AssignAttr, astroid.AssignName)) and isinstance(
+        node.parent, astroid.Assign
+    ):
+        ann, default = _annotated_argument(node)
+    else:
+        return None
+    if ann is None:
+        return None
+    original_label = label = ann.as_string()
+    if (
+        isinstance(default, astroid.Const)
+        and default.value is None
+        and not label.startswith(("Optional", "typing.Optional"))
+        and label not in ("None", "Any", "typing.Any")
+    ):
+        label = f"Optional[{label}]"
+    if label == original_label and isinstance(ann, (astroid.Name, astroid.Attribute)):
+        # keep the original node so that it can be inferred
+        return ann
+    return astroid.Name(
+        name=label, lineno=ann.lineno, col_offset=ann.col_offset, parent=ann.parent
+    )
+
+
+def infer_node(node):
+    """Return the set of inferred values of node, preferring its type annotation.
+
+    If the annotation cannot be inferred, the annotation node itself is returned
+    so that it can still be displayed.
+    """
+    ann = get_annotation(node)
+    try:
+        if ann is not None:
+            values = {v for v in ann.infer() if v is not astroid.Uninferable}
+            return values or {ann}
+        return set(node.infer())
+    except astroid.InferenceError:
+        return {ann} if ann is not None else set()

@@ -269,6 +269,38 @@ class TestFigureOutExcInfo:
 
         assert (e.__class__, e, None) == _figure_out_exc_info(e)
 
+    @pytest.mark.parametrize("true_value", [True, 1, 1.1])
+    def test_no_current_exception(self, true_value):
+        """
+        If the passed argument evaluates to True but there is no current
+        exception, return None.
+        """
+        assert _figure_out_exc_info(true_value) is None
+
+    @pytest.mark.parametrize("false_value", [None, False, 0, ""])
+    def test_false_value(self, false_value):
+        """
+        False values return None.
+        """
+        assert _figure_out_exc_info(false_value) is None
+
+    def test_missing_exc_info_tuple(self):
+        """
+        The missing exc_info tuple returns None.
+        """
+        assert _figure_out_exc_info((None, None, None)) is None
+
+    def test_exc_info_tuple(self):
+        """
+        An exc_info tuple is returned unchanged.
+        """
+        try:
+            0 / 0
+        except Exception:
+            ei = sys.exc_info()
+
+        assert ei == _figure_out_exc_info(ei)
+
 

+def test_len_with_control_codes():
+    # Length should reflect the text after control codes are stripped
+    text = Text("foo\x08bar\r")
+    assert str(text) == "foobar"
+    assert len(text) == 6
+    text.append("\x0cbaz")
+    assert len(text) == 9
+    text.append(Text("\x0bqux"))
+    assert str(text) == "foobarbazqux"
+    assert len(text) == 12
+

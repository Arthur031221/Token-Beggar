+def test_inspect_docstring_with_control_codes():
+    """Docstrings containing control codes (e.g. a literal backspace
+    from an unescaped ``\\b``) caused an IndexError when rendered."""
+
+    class Thing:
+        def method(self):
+            """Mimics pyparsing's WordEnd: To emulate the ``\b`` behavior of
+            regular expressions, use ``WordEnd(alphanums)``.
+
+            More text.
+            """
+
+    result = render(Thing, methods=True, width=45)
+    print(repr(result))
+    assert "│ method = def method(self):                │\n" in result
+    assert "│          emulate the ```` behavior of     │\n" in result
+    assert "│          ``WordEnd(alphanums)``.          │\n" in result

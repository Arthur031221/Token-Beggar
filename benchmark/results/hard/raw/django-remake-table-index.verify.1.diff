+    def test_alter_primary_key_db_collation_propagates_to_fks(self):
+        collation = connection.features.test_collations.get("non_default")
+        if not collation:
+            self.skipTest("Language collations are not supported.")
+
+        class Parent(Model):
+            id = CharField(primary_key=True, max_length=20)
+
+            class Meta:
+                app_label = "schema"
+
+        class Child(Model):
+            parent = ForeignKey(Parent, CASCADE)
+            parent_o2o = OneToOneField(Parent, CASCADE, related_name="o2o_child")
+
+            class Meta:
+                app_label = "schema"
+
+        self.isolated_local_models = [Parent, Child]
+        with connection.schema_editor() as editor:
+            editor.create_model(Parent)
+            editor.create_model(Child)
+
+        old_field = Parent._meta.get_field("id")
+        new_field = old_field.clone()
+        new_field.db_collation = collation
+        new_field.set_attributes_from_name("id")
+        new_field.model = Parent
+        # Simulate the model state after the alteration, as in migrations.
+        old_field = old_field.clone()
+        old_field.set_attributes_from_name("id")
+        old_field.model = Parent
+        Parent._meta.get_field("id").db_collation = collation
+        with connection.schema_editor() as editor:

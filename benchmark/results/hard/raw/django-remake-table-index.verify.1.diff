+            self.assertEqual(self.get_column_collation(table, column), collation)
+        with connection.schema_editor() as editor:
+            Parent._meta.get_field("id").db_collation = None
+            editor.alter_field(Parent, new_field, old_field, strict=True)
+        for table, column in [
+            (Parent._meta.db_table, "id"),
+            (Child._meta.db_table, "parent_id"),
+            (Child._meta.db_table, "parent_o2o_id"),
+        ]:

+def get_unpacked_marks(
+    obj: Union[object, type],
+    *,
+    consider_mro: bool = True,
+) -> List[Mark]:
+    """Obtain the unpacked marks that are stored on an object.
+
+    If obj is a class and consider_mro is true, return marks applied to
+    this class and all of its super-classes in MRO order (base classes
+    first). If consider_mro is false, only return marks applied directly
+    to this class (not inherited ones). For non-class objects, the
+    ``pytestmark`` attribute is used.
+    """
+    if isinstance(obj, type) and consider_mro:
+        mark_lists = []
+        for cls in reversed(obj.__mro__):
+            cls_marks = cls.__dict__.get("pytestmark", [])
+            if not isinstance(cls_marks, list):
+                cls_marks = [cls_marks]
+            mark_lists.append(cls_marks)
+        mark_list = [m for marks in mark_lists for m in marks]
+    else:
+        if isinstance(obj, type):
+            # Only the class' own marks, not those inherited by attribute lookup.
+            mark_list = obj.__dict__.get("pytestmark", [])
+        else:
+            mark_list = getattr(obj, "pytestmark", [])
+        if not isinstance(mark_list, list):
+            mark_list = [mark_list]
+    return list(normalize_mark_list(mark_list))
 
 

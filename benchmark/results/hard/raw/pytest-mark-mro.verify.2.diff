+    def test_mark_mro(self) -> None:
+        from _pytest.mark.structures import get_unpacked_marks
+
+        @pytest.mark.foo
+        class Foo:
+            pass
+
+        @pytest.mark.bar
+        class Bar:
+            pass
+
+        class TestDings(Foo, Bar):
+            def test_dings(self):
+                pass
+
+        # Marks come from reversed MRO: Bar first, then Foo.
+        assert [m.name for m in get_unpacked_marks(TestDings)] == ["bar", "foo"]
+
+        # Diamond with a shared marked base: no duplicates.
+        @pytest.mark.baz
+        class Base:
+            pass
+
+        @pytest.mark.foo
+        class Left(Base):
+            pass
+
+        @pytest.mark.bar
+        class Right(Base):
+            pass
+
+        class Diamond(Left, Right):
+            pass
+
+        assert [m.name for m in get_unpacked_marks(Diamond)] == [
+            "baz",
+            "bar",
+            "foo",
+        ]
+
+    def test_mark_multiple_inheritance_collected(self, pytester: Pytester) -> None:
+        p = pytester.makepyfile(

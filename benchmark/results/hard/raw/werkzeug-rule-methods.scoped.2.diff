diff --git a/tests/test_routing.py b/tests/test_routing.py
index 4f31037c..f8dd31aa 100644
--- a/tests/test_routing.py
+++ b/tests/test_routing.py
@@ -299,6 +299,67 @@ def test_duplicate_rule() -> None:
         )
 
 
+def test_no_duplicate_disjoint_methods() -> None:
+    m = r.Map(
+        [
+            r.Rule("/a", endpoint="get", methods=["GET"]),
+            r.Rule("/a", endpoint="post", methods=["POST"]),
+        ]
+    )
+    a = m.bind("localhost")
+    assert a.match("/a", method="GET")[0] == "get"
+    assert a.match("/a", method="POST")[0] == "post"
+
+
+@pytest.mark.parametrize(
+    ("m1", "m2"),
+    [
+        (["GET", "POST"], ["POST"]),
+        (None, ["POST"]),
+        (["POST"], None),
+        (None, None),
+        (["GET"], ["HEAD"]),
+        (["GET"], ["GET", "HEAD"]),
+    ],
+)
+def test_duplicate_overlapping_methods(
+    m1: list[str] | None, m2: list[str] | None
+) -> None:
+    with pytest.raises(DuplicateRuleError):
+        r.Map([r.Rule("/a", endpoint="a", methods=m1), r.Rule("/a", methods=m2)])
+
+
+def test_no_duplicate_websocket() -> None:
+    r.Map(
+        [
+            r.Rule("/a", endpoint="a"),
+            r.Rule("/a", endpoint="b", websocket=True),
+        ]
+    )
+
+
+def test_no_duplicate_trailing_slash() -> None:
+    r.Map([r.Rule("/a/", endpoint="a"), r.Rule("/a", endpoint="b")])
+
+
+def test_duplicate_strict_slashes() -> None:
+    """strict_slashes doesn't change what path a rule matches."""
+    with pytest.raises(DuplicateRuleError):
+        r.Map([r.Rule("/a/", endpoint="a"), r.Rule("/a/", strict_slashes=False)])
+
+
+def test_duplicate_merge_slashes() -> None:
+    with pytest.raises(DuplicateRuleError):
+        r.Map([r.Rule("/a//b", endpoint="a"), r.Rule("/a/b", endpoint="b")])
+
+
+def test_empty_preserves_merge_slashes_websocket() -> None:
+    rule = r.Rule("/a", merge_slashes=False, websocket=True)
+    new = rule.empty()
+    assert new.merge_slashes is False
+    assert new.websocket is True
+
+

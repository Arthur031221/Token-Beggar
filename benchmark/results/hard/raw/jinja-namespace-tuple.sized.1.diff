+    def _check_nsref_targets(self, target: nodes.Expr, frame: Frame) -> None:
+        """``a.b`` is allowed as an assignment target and is parsed as an
+        :class:`~jinja2.nodes.NSRef`, but it's only valid if ``a`` is a
+        :class:`~jinja2.utils.Namespace`. Emit a check for each referenced
+        name before the assignment code. This can't be done in
+        :meth:`visit_NSRef` as the ref could be in the middle of a tuple.
+        """
+        seen_refs: t.Set[str] = set()
+        nsrefs: t.List[nodes.NSRef] = []
+
+        if isinstance(target, nodes.NSRef):
+            nsrefs.append(target)
+
+        nsrefs.extend(target.find_all(nodes.NSRef))
+
+        for nsref in nsrefs:
+            if nsref.name in seen_refs:
+                # Only emit the check once per name, for `ns.a, ns.b = c, d`.
+                continue
+
+            seen_refs.add(nsref.name)
+            ref = frame.symbols.ref(nsref.name)
+            self.writeline(f"if not isinstance({ref}, Namespace):")
+            self.indent()
+            self.writeline(
+                "raise TemplateRuntimeError"
+                '("cannot assign attribute on non-namespace object")'
+            )
+            self.outdent()
+
     def visit_Assign(self, node: nodes.Assign, frame: Frame) -> None:
         self.push_assign_tracking()
+        self._check_nsref_targets(node.target, frame)
         self.newline(node)
         self.visit(node.target, frame)
         self.write(" = ")

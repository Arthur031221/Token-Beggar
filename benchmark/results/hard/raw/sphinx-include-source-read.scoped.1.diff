+project = 'test-directive-include'
+exclude_patterns = ['_build']
+
+
+def setup(app):
+    def replace(app, docname, source):
+        source[0] = source[0].replace('&REPLACE_ME;', 'REPLACED')
+    app.connect('source-read', replace)

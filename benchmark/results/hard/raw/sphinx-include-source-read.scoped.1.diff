diff --git a/sphinx/directives/other.py b/sphinx/directives/other.py
index 19f7c0a8d..42e171cd2 100644
--- a/sphinx/directives/other.py
+++ b/sphinx/directives/other.py
@@ -1,5 +1,6 @@
 from __future__ import annotations
 
+import os
 import re
 from typing import TYPE_CHECKING, Any, cast
 
@@ -8,6 +9,7 @@ from docutils.parsers.rst import directives
 from docutils.parsers.rst.directives.admonitions import BaseAdmonition
 from docutils.parsers.rst.directives.misc import Class
 from docutils.parsers.rst.directives.misc import Include as BaseInclude
+from docutils.statemachine import StateMachine
 
 from sphinx import addnodes
 from sphinx.domains.changeset import VersionChange  # noqa: F401  # for compatibility
@@ -376,6 +378,22 @@ class Include(BaseInclude, SphinxDirective):
         rel_filename, filename = self.env.relfn2path(self.arguments[0])
         self.arguments[0] = filename
         self.env.note_included(filename)
+
+        # Let "source-read" handlers process the included content, too.
+        if self.env.app.events.listeners.get('source-read'):
+            def _insert_input(include_lines: list[str], path: str) -> None:
+                # docutils (>= 0.18) appends two marker lines
+                # (an empty line and an "end of inclusion" comment)
+                text = "\n".join(include_lines[:-2])
+                docname = self.env.path2doc(os.path.abspath(path))
+                arg = [text]
+                self.env.app.events.emit('source-read', docname, arg)
+                text = arg[0]
+                include_lines = text.splitlines() + include_lines[-2:]
+                StateMachine.insert_input(self.state_machine, include_lines, path)
+
+            self.state_machine.insert_input = _insert_input  # type: ignore[method-assign]
+
         return super().run()
 
 

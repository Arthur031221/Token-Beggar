+class PrefetchSlicedTests(TestDataMixin, TestCase):
+    @skipUnlessDBFeature("supports_over_clause")
+    def test_reverse_fk_sliced(self):
+        Author.objects.create(name="Extra", first_book=self.book2)
+        for sl, expected in [
+            (slice(1, None), {self.book1: ["Anne", "Emily"], self.book2: []}),
+            (slice(None, 1), {self.book1: ["Charlotte"], self.book2: ["Extra"]}),
+            (slice(1, 2), {self.book1: ["Anne"], self.book2: []}),
+        ]:
+            with self.subTest(sl=sl):
+                qs = Book.objects.filter(pk__in=[self.book1.pk, self.book2.pk])
+                with self.assertNumQueries(2):
+                    books = list(
+                        qs.prefetch_related(
+                            Prefetch(
+                                "first_time_authors",
+                                Author.objects.order_by("id")[sl],
+                                to_attr="sliced",
+                            )
+                        )
+                    )
+                    got = {b: [a.name for a in b.sliced] for b in books}
+                self.assertEqual(got, expected)
+
+    @skipUnlessDBFeature("supports_over_clause")
+    def test_m2m_sliced(self):
+        with self.assertNumQueries(2):
+            books = list(
+                Book.objects.filter(pk__in=[self.book1.pk, self.book2.pk])
+                .order_by("id")
+                .prefetch_related(
+                    Prefetch(
+                        "authors",
+                        Author.objects.order_by("name")[1:3],
+                        to_attr="sliced",
+                    )
+                )
+            )
+            got = [[a.name for a in b.sliced] for b in books]
+        self.assertEqual(got, [["Charlotte", "Emily"], []])

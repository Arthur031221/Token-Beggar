+        )
+
+    def testEscapedCharsInText(self):
+        """ Test that unescaped characters are HTML escaped in text. """
+        md = markdown.Markdown()
+        md.ESCAPED_CHARS.extend(['&', '<'])
+        self.assertEqual(md.convert('a\\&b\\<c\\>d'), '<p>a&amp;b&lt;c&gt;d</p>')
+
+    def testUnescapePostprocessorDeprecated(self):
+        """ Test that UnescapePostprocessor raises a DeprecationWarning. """
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter('always')
+            pp = markdown.postprocessors.UnescapePostprocessor()
+            self.assertEqual(len(w), 1)
+            self.assertTrue(issubclass(w[-1].category, DeprecationWarning))

+class TestSmartyEscapes(unittest.TestCase):
+    """ Test that backslash escaped quotes are properly escaped in HTML attributes. """
+
+    def setUp(self):
+        self.md = markdown.Markdown(extensions=['smarty'])
+
+    def testEscapedQuoteInImageAlt(self):
+        self.assertEqual(
+            self.md.convert('![x\\"x](x)'),
+            '<p><img alt="x&quot;x" src="x" /></p>'
+        )
+        self.assertEqual(
+            self.md.convert('![x\\"x](x)'),
+            self.md.reset().convert('![x"x](x)')
+        )
+
+    def testEscapedQuoteInLinkTitle(self):
+        self.assertEqual(
+            self.md.convert('[x](x "a\\"b")'),
+            '<p><a href="x" title="a&quot;b">x</a></p>'
+        )
+
+    def testEscapedSingleQuoteInImageAlt(self):
+        self.assertEqual(
+            self.md.convert("![x\\'x](x)"),
+            '<p><img alt="x\'x" src="x" /></p>'
+        )
+
+    def testEscapedQuoteInText(self):
+        self.assertEqual(
+            self.md.convert('\\"x\\"'),
+            '<p>"x"</p>'
+        )

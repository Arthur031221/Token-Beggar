+def test_no_duplicate_disjoint_methods() -> None:
+    """Rules with the same path but no shared methods are not duplicates."""
+    m = r.Map(
+        [
+            r.Rule("/", endpoint="get", methods=["GET"]),
+            r.Rule("/", endpoint="post", methods=["POST"]),
+            r.Rule("/", endpoint="put_delete", methods=["PUT", "DELETE"]),
+        ]
+    )
+    a = m.bind("localhost")
+    assert a.match("/", method="GET") == ("get", {})
+    assert a.match("/", method="HEAD") == ("get", {})
+    assert a.match("/", method="POST") == ("post", {})
+    assert a.match("/", method="DELETE") == ("put_delete", {})
+
+
+@pytest.mark.parametrize(
+    ("a_methods", "b_methods"),
+    [
+        (["GET"], ["GET"]),
+        (["GET", "POST"], ["POST", "PUT"]),
+        # HEAD is added automatically when GET is present.
+        (["GET"], ["HEAD"]),
+        # None allows all methods.
+        (None, ["POST"]),
+        (["POST"], None),
+        (None, None),
+    ],
+)
+def test_duplicate_shared_method(
+    a_methods: list[str] | None, b_methods: list[str] | None
+) -> None:
+    """Rules with the same path that share any method are duplicates."""
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/", endpoint="a", methods=a_methods),
+                r.Rule("/", endpoint="b", methods=b_methods),
+            ]
+        )
+
+
+def test_no_duplicate_websocket_methods() -> None:
+    """Websocket mode is still considered when methods are shared."""
+    r.Map(
+        [
+            r.Rule("/", endpoint="http", methods=["GET"]),
+            r.Rule("/", endpoint="ws", methods=["GET"], websocket=True),
+        ]
+    )
+
+
+def test_duplicate_strict_slashes() -> None:
+    """Different ``strict_slashes`` doesn't prevent a duplicate, both rules
+    still match the same path.
+    """
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/a", endpoint="a", strict_slashes=True),
+                r.Rule("/a", endpoint="b", strict_slashes=False),
+            ]
+        )
+
+
+def test_no_duplicate_branch_leaf() -> None:
+    """A branch and leaf rule are not duplicates, regardless of
+    ``strict_slashes``.
+    """
+    r.Map(
+        [
+            r.Rule("/a", endpoint="leaf"),
+            r.Rule("/a/", endpoint="branch"),
+        ],
+        strict_slashes=False,
+    )
+
+
+def test_duplicate_merge_slashes() -> None:
+    """With ``merge_slashes``, rules are compared after merging slashes."""
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/a/b", endpoint="a"),
+                r.Rule("/a//b", endpoint="b"),
+            ]
+        )
+
+
+def test_no_duplicate_merge_slashes_disabled() -> None:
+    """Without ``merge_slashes``, repeated slashes are a distinct path."""
+    m = r.Map(
+        [
+            r.Rule("/a/b", endpoint="a"),
+            r.Rule("/a//b", endpoint="b", merge_slashes=False),
+        ]
+    )
+    a = m.bind("localhost")
+    assert a.match("/a/b") == ("a", {})
+    assert a.match("/a//b") == ("b", {})
+
+
+def test_is_duplicate() -> None:
+    """Rules that share any method are duplicates, rules that share none are
+    not.
+    """
+    a = r.Rule("/", endpoint="a", methods=["GET", "POST"])
+    b = r.Rule("/", endpoint="b", methods=["POST"])
+    r.Map([a])
+    r.Map([b])
+    assert a.is_duplicate(b)
+    assert b.is_duplicate(a)
+    c = r.Rule("/", endpoint="c", methods=["PUT"])
+    r.Map([c])
+    assert not a.is_duplicate(c)
+
+

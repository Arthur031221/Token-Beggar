+    def test_namespace_set_tuple(self, env_trim):
+        tmpl = env_trim.from_string(
+            "{% set ns = namespace(a=12, b=36) %}"
+            "{% set ns.a, ns.b = ns.a + 1, ns.b + 1 %}"
+            "{{ ns.a }}|{{ ns.b }}"
+        )
+        assert tmpl.render() == "13|37"
+
+    def test_namespace_set_tuple_swap(self, env_trim):
+        tmpl = env_trim.from_string(
+            "{% set ns = namespace(a=1, b=2) %}"
+            "{% set ns.a, ns.b = ns.b, ns.a %}"
+            "{{ ns.a }}|{{ ns.b }}"
+        )
+        assert tmpl.render() == "2|1"
+
+    def test_namespace_set_tuple_mixed(self, env_trim):
+        tmpl = env_trim.from_string(
+            "{% set ns = namespace(prev='', cur='a') %}"
+            "{% for x in 'bc' %}"
+            "{% set ns.prev, ns.cur, last = ns.cur, ns.cur ~ x, x %}"
+            "{% endfor %}"
+            "{{ ns.prev }}|{{ ns.cur }}|{{ last is defined }}"
+        )
+        assert tmpl.render() == "ab|abc|False"
+
+    def test_namespace_set_tuple_multiple_namespaces(self, env_trim):
+        tmpl = env_trim.from_string(
+            "{% set a = namespace() %}{% set b = namespace() %}"
+            "{% set a.x, b.y = 13, 37 %}"
+            "{{ a.x }}|{{ b.y }}"
+        )
+        assert tmpl.render() == "13|37"
+

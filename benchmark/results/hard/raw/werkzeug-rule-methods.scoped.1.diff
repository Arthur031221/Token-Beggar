+def test_no_duplicate_disjoint_methods() -> None:
+    m = r.Map(
+        [
+            r.Rule("/", endpoint="a", methods=["GET"]),
+            r.Rule("/", endpoint="b", methods=["POST"]),
+        ]
+    )
+    a = m.bind("localhost")
+    assert a.match("/", method="GET")[0] == "a"
+    assert a.match("/", method="POST")[0] == "b"
+
+
+@pytest.mark.parametrize(
+    ("m1", "m2"),
+    [
+        (["GET", "POST"], ["POST"]),
+        (["GET"], ["HEAD"]),
+        (None, ["POST"]),
+        (["POST"], None),
+    ],
+)
+def test_duplicate_overlapping_methods(m1, m2) -> None:
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/", endpoint="a", methods=m1),
+                r.Rule("/", endpoint="b", methods=m2),
+            ]
+        )
+
+
+def test_no_duplicate_websocket() -> None:
+    r.Map(
+        [
+            r.Rule("/", endpoint="a"),
+            r.Rule("/", endpoint="b", websocket=True),
+        ]
+    )
+
+
+def test_no_duplicate_merge_slashes_disabled() -> None:
+    r.Map(
+        [
+            r.Rule("/a//b", endpoint="a", merge_slashes=False),
+            r.Rule("/a/b", endpoint="b"),
+        ]
+    )
+
+
+def test_duplicate_strict_slashes_ignored() -> None:
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/a/", endpoint="a", strict_slashes=False),
+                r.Rule("/a/", endpoint="b"),
+            ]
+        )
+
+

 def test_project_node(project):
     expected = ["data", "data.clientmodule_test", "data.suppliermodule_test"]
     assert sorted(project.keys()) == expected
+
+
+def test_type_hints_used_for_attributes():
+    from pylint.pyreverse.diagrams import ClassDiagram
+    from pylint.pyreverse.utils import infer_node
+
+    module = astroid.parse(
+        """
+    from typing import Optional
+    class C(object):
+        x: int = 3
+        def __init__(self, a: str = None, b=None, c: Optional[int] = None):
+            self.a = a
+            self.b = b
+            self.c = c
+            self.d: float = None
+    """
+    )
+    klass = module["C"]
+    linker = inspector.Linker(inspector.Project("test"))
+    linker.visit(module)
+    diagram = ClassDiagram("test", mode="PUB_ONLY")
+    attrs = diagram.get_attrs(klass)
+    assert "a : str" in attrs
+    assert "b : NoneType" in attrs
+    assert "c : Optional[int]" in attrs
+    assert "d : float" in attrs
+    assert "x : int" in attrs
+    assert {v.name for v in infer_node(klass.instance_attrs["a"][0])} == {"str"}

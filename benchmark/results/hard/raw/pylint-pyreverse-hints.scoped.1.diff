diff --git a/pylint/pyreverse/utils.py b/pylint/pyreverse/utils.py
index a24d227e..c26d8752 100644
--- a/pylint/pyreverse/utils.py
+++ b/pylint/pyreverse/utils.py
@@ -20,6 +20,8 @@ import os
 import re
 import sys
 
+import astroid
+
 RCFILE = ".pyreverserc"
 
 
@@ -213,3 +215,55 @@ class LocalsVisitor(ASTWalker):
         if methods[1] is not None:
             return methods[1](node)
         return None
+
+
+def get_annotation(node):
+    """Return the annotation node of an AssignAttr/AssignName, if any.
+
+    The annotation comes from an annotated assignment, or from the annotation
+    of the function argument the assigned value is taken from.
+    """
+    parent = node.parent
+    if isinstance(parent, astroid.AnnAssign) and parent.target is node:
+        return parent.annotation
+    if not isinstance(parent, astroid.Assign):
+        return None
+    value = parent.value
+    if not isinstance(value, astroid.Name):
+        return None
+    try:
+        assignments = value.lookup(value.name)[1]
+    except (astroid.NotFoundError, IndexError):
+        return None
+    for assignment in assignments:
+        if not isinstance(assignment, astroid.AssignName):
+            continue
+        arguments = assignment.parent
+        if not isinstance(arguments, astroid.Arguments):
+            continue
+        for args, annotations in (
+            (arguments.args, arguments.annotations),
+            (arguments.kwonlyargs, arguments.kwonlyargs_annotations),
+            (arguments.posonlyargs, arguments.posonlyargs_annotations),
+        ):
+            for arg, ann in zip(args or [], annotations or []):
+                if arg is assignment and ann is not None:
+                    return ann
+    return None
+
+
+def infer_node(node):
+    """Return a set of inferred values for node, preferring its type annotation."""
+    ann = get_annotation(node)
+    if isinstance(ann, astroid.Subscript):
+        # e.g. Optional[int] or List[str]: keep the annotation itself so that
+        # it can be displayed as written
+        return {ann}
+    try:
+        if ann is not None:
+            values = {val for val in ann.infer() if val is not astroid.Uninferable}
+            if values:
+                return values
+        return set(node.infer())
+    except astroid.InferenceError:
+        return set()

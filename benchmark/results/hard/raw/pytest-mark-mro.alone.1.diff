+    def test_mark_decorator_multiple_baseclasses_merged(
+        self, pytester: Pytester
+    ) -> None:
+        """Marks of all base classes are considered, following the MRO (#7792)."""
+        p = pytester.makepyfile(
+            """
+            import pytest
+
+            @pytest.mark.a
+            class Base1: pass
+
+            @pytest.mark.b
+            class Base2: pass
+
+            @pytest.mark.c
+            class Base3(Base1, Base2): pass
+
+            class TestNoOwn(Base1, Base2):
+                def test_no_own(self): pass
+
+            @pytest.mark.d
+            class TestOwn(Base3):
+                def test_own(self): pass
+
+            class TestDiamond(Base3, Base2):
+                @pytest.mark.e
+                def test_diamond(self): pass
+        """
+        )
+        items, rec = pytester.inline_genitems(p)
+        self.assert_markers(
+            items,
+            test_no_own=("a", "b"),
+            test_own=("a", "b", "c", "d"),
+            test_diamond=("a", "b", "c", "e"),
+        )
+        # Each mark is reported only once, even with diamond inheritance.
+        for item in items:
+            names = [m.name for m in item.iter_markers()]
+            assert len(names) == len(set(names)), (item.name, names)

index 19f7c0a8d..453c8a229 100644
--- a/sphinx/directives/other.py
+++ b/sphinx/directives/other.py
@@ -1,5 +1,6 @@
 from __future__ import annotations
 
+import os
 import re
 from typing import TYPE_CHECKING, Any, cast
 
@@ -376,7 +377,32 @@ class Include(BaseInclude, SphinxDirective):
         rel_filename, filename = self.env.relfn2path(self.arguments[0])
         self.arguments[0] = filename
         self.env.note_included(filename)
-        return super().run()
+
+        if not self.env.events.listeners.get('source-read'):
+            return super().run()
+
+        # Emit 'source-read' for included content, so that modifications made
+        # by handlers are reflected in the output.  docutils re-reads the
+        # included file itself and passes the lines to insert_input() (the
+        # literal/code options do not call insert_input at all).
+        sm = self.state_machine
+        orig_insert_input = sm.insert_input
+
+        def _insert_input(include_lines: list[str], source: str) -> None:
+            # docutils appends two marker lines ('' and '.. end of inclusion
+            # from ...'); keep them out of the text given to the handlers.
+            text = '\n'.join(include_lines[:-2])
+            # docname is None if the included file is not a document
+            docname = self.env.path2doc(os.path.normpath(source))
+            arg = [text]
+            self.env.events.emit('source-read', docname, arg)
+            orig_insert_input(arg[0].splitlines() + include_lines[-2:], source)
+
+        sm.insert_input = _insert_input  # type: ignore[method-assign]
+        try:
+            return super().run()
+        finally:
+            del sm.insert_input
 
 
 def setup(app: Sphinx) -> dict[str, Any]:

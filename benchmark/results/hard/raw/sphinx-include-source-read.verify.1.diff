                 includefiles=['foo', 'foo'])
+
+
+@pytest.mark.sphinx('text', testroot='directive-include')
+def test_include_source_read_event(app):
+    seen = []
+
+    def handler(app_, docname, source):
+        seen.append(docname)
+        assert 'end of inclusion' not in source[0]
+        source[0] = source[0].replace('&REPLACE_ME;', 'REPLACED')
+
+    app.connect('source-read', handler)
+    app.builder.build_all()
+    result = (app.outdir / 'index.txt').read_text(encoding='utf8')
+    assert '&REPLACE_ME;' not in result
+    assert result.count('REPLACED') == 3
+    assert 'baz/baz' in seen
+    assert None in seen  # inner.inc is not a document

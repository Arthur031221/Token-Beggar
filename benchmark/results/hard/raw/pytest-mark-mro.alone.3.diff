+    def test_mark_closest_considers_mro(self, pytester: Pytester) -> None:
+        p = pytester.makepyfile(
+            """
+            import pytest
+
+            @pytest.mark.c(location="base")
+            class Base: pass
+
+            @pytest.mark.c(location="sub")
+            class TestSub(Base):
+                def test_foo(self): pass
+        """
+        )
+        items, rec = pytester.inline_genitems(p)
+        (item,) = items
+        marker = item.get_closest_marker("c")
+        assert marker is not None
+        assert marker.kwargs == {"location": "sub"}
+        assert [m.kwargs["location"] for m in item.iter_markers("c")] == [
+            "sub",
+            "base",
+        ]

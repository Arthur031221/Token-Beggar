     assert_node(doctree[0][0],
                 entries=[(None, 'foo'), (None, 'foo')],
                 includefiles=['foo', 'foo'])
+
+
+@pytest.mark.sphinx('html', testroot='directive-include', freshenv=True)
+def test_include_source_read_event(app):
+    def source_read(app, docname, source):
+        source[0] = source[0].replace('&REPLACE_ME;', 'REPLACED')
+
+    app.connect('source-read', source_read)
+    app.build(force_all=True)
+    html = (app.outdir / 'index.html').read_text(encoding='utf8')
+    assert '&amp;REPLACE_ME;' not in html
+    assert 'REPLACED in baz' in html
+    assert 'REPLACED in inner' in html
+
+
+@pytest.mark.sphinx('html', testroot='directive-include', freshenv=True)
+def test_include_source_read_docname(app):
+    docnames = []
+
+    def source_read(app, docname, source):
+        docnames.append(docname)
+
+    app.connect('source-read', source_read)
+    app.build(force_all=True)
+    # read as standalone documents, plus once per include
+    assert docnames.count('index') == 1
+    assert docnames.count('baz/baz') == 2  # itself, included by index
+    assert docnames.count('baz/inner') == 3  # itself, included by baz/baz and by index

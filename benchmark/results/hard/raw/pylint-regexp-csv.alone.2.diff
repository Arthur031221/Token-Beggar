diff --git a/pylint/utils/utils.py b/pylint/utils/utils.py
index fa7f7b92f..4e090260b 100644
--- a/pylint/utils/utils.py
+++ b/pylint/utils/utils.py
@@ -253,6 +253,51 @@ def _check_csv(value: list[str] | tuple[str] | str) -> Sequence[str]:
     return _splitstrip(value)
 
 
+def _check_regexp_csv(value: list[str] | tuple[str] | str) -> Sequence[str]:
+    r"""Split a comma-separated list of regular expressions.
+
+    Commas that are part of a regular expression are not treated as separators:
+    commas inside a quantifier (``\d{1,2}``), inside a character class
+    (``[,;]``) or escaped with a backslash (``\,``) are kept.
+
+    >>> _check_regexp_csv('foo, bar{1,3}, [,;]')
+    ['foo', 'bar{1,3}', '[,;]']
+    """
+    if isinstance(value, (list, tuple)):
+        return value
+    regexps: list[str] = []
+    current: list[str] = []
+    in_braces = False
+    # Index of the opening '[' of the current character class, if any
+    class_start: int | None = None
+    index = 0
+    while index < len(value):
+        char = value[index]
+        if char == "\\" and index + 1 < len(value):
+            current.append(value[index : index + 2])
+            index += 2
+            continue
+        if class_start is not None:
+            # A ']' right after '[' or '[^' is a literal and doesn't end the class
+            if char == "]" and value[class_start:index] not in {"[", "[^"}:
+                class_start = None
+        elif char == "[":
+            class_start = index
+        elif char == "{":
+            in_braces = True
+        elif char == "}":
+            in_braces = False
+        elif char == "," and not in_braces:
+            regexps.append("".join(current))
+            current = []
+            index += 1
+            continue
+        current.append(char)
+        index += 1
+    regexps.append("".join(current))
+    return [regexp.strip() for regexp in regexps if regexp.strip()]
+
+
 def _comment(string: str) -> str:
     """Return string as a comment."""
     lines = [line.strip() for line in string.splitlines()]

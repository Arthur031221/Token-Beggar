-        r"Error in provided regular expression: (foo{1 beginning at index 0: missing ), unterminated subpattern"
+        r"Error in provided regular expression: (foo{1,} beginning at index 0: missing ), unterminated subpattern"
         in output.err
     )
 
 
+@pytest.mark.parametrize(
+    "in_string,expected",
+    [
+        ("foo", ["foo"]),
+        ("foo,bar", ["foo", "bar"]),
+        ("foo, bar", ["foo", "bar"]),
+        ("foo, bar{1,3}", ["foo", "bar{1,3}"]),
+        ("(foo{1,3})", ["(foo{1,3})"]),
+        ("foo{1,}, bar{,3}", ["foo{1,}", "bar{,3}"]),
+        ("[,;]x, y", ["[,;]x", "y"]),
+        ("[],]x, y", ["[],]x", "y"]),
+        ("[^],]x, y", ["[^],]x", "y"]),
+        (r"foo\,bar, baz", [r"foo\,bar", "baz"]),
+        (r"foo\{,bar", [r"foo\{", "bar"]),
+    ],
+)
+def test_csv_regex_comma_in_quantifier(in_string: str, expected: list[str]) -> None:
+    """Check that commas used inside a regular expression (quantifiers,
+    character classes, escapes) are not treated as separators.
+    """
+    runner = Run(
+        [str(EMPTY_MODULE), f"--bad-names-rgx={in_string}"],
+        exit=False,
+    )
+    assert [
+        pattern.pattern for pattern in runner.linter.config.bad_names_rgxs
+    ] == expected
+
+

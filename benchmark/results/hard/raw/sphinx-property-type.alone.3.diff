+def get_classmethod_property(subject: Any, name: str) -> Any:
+    """Get the property wrapped by classmethod (ex. ``@classmethod @property``)
+    defined as *name* in *subject* or its base classes.  Returns None if not found.
+    """
+    for cls in getmro(subject) or (subject,):
+        __dict__ = safe_getattr(cls, '__dict__', {})
+        if name in __dict__:
+            obj = __dict__[name]
+            if isinstance(obj, classmethod) and isproperty(safe_getattr(obj, '__func__', None)):
+                return obj.__func__
+            else:
+                return None
+
+    return None
+

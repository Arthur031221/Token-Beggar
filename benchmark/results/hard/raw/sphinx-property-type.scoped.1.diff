+@pytest.mark.skipif(sys.version_info < (3, 9), reason='python 3.9+ is required.')
+@pytest.mark.sphinx(testroot='ext-autodoc')
+def test_isclassmethod_classproperty(app):
+    from target.properties import Foo
+
+    class Bar(Foo):
+        pass
+
+    # Foo.classprop evaluates to the value returned by the property
+    assert inspect.isclassmethod(Foo.classprop) is False
+    assert inspect.isclassmethod(Foo.classprop, Foo, 'classprop') is True
+    assert inspect.isclassmethod(Bar.classprop, Bar, 'classprop') is True
+    assert inspect.isclassmethod(Foo.prop, Foo, 'prop') is False
+    assert inspect.getdoc(Foo.classprop, cls=Foo, name='classprop') == 'docstring'
+    assert inspect.getdoc(Bar.classprop, cls=Bar, name='classprop') == 'docstring'
 
 

+class FootnoteReorderingProcessor(Treeprocessor):
+    """ Reorder and renumber footnotes by the order in which they are first referenced. """
+
+    def __init__(self, footnotes: FootnoteExtension):
+        self.footnotes = footnotes
+
+    def iter_refs(self, element: etree.Element, skip: etree.Element) -> Iterator[tuple[etree.Element, str]]:
+        """ Yield `(link, id)` for each footnote reference in `element` in document order, ignoring `skip`. """
+        for child in element:
+            if child is skip:
+                continue
+            if child.tag == 'a' and child.get('class', '') == 'footnote-ref' and child.get('href') in self.href_map:
+                yield child, self.href_map[child.get('href')]
+            yield from self.iter_refs(child, skip)
+
+    def run(self, root: etree.Element) -> None:
+        if self.footnotes.getConfig('USE_DEFINITION_ORDER') or not self.footnotes.footnotes:
+            return
+
+        div = None
+        for el in root.iter('div'):
+            if el.get('class', '') == 'footnote':
+                div = el
+                break
+        if div is None:
+            return
+        ol = div.find('ol')
+        if ol is None:
+            return
+
+        definition_order = list(self.footnotes.footnotes.keys())
+        self.href_map = {'#' + self.footnotes.makeFootnoteId(id): id for id in definition_order}
+        li_map = {li.get('id'): li for li in ol}
+
+        order: list[str] = []
+        seen: set[str] = set()
+        links: list[tuple[etree.Element, str]] = []
+
+        def collect(element: etree.Element) -> None:
+            for link, id in self.iter_refs(element, div):
+                links.append((link, id))
+                if id not in seen:
+                    seen.add(id)
+                    order.append(id)
+
+        # References in the body of the document come first. Then references found
+        # within the footnotes themselves, in the order those footnotes are numbered.
+        # Unreferenced footnotes are added at the end in the order they were defined.
+        collect(root)
+        index = 0
+        while True:
+            while index < len(order):
+                li = li_map.get(self.footnotes.makeFootnoteId(order[index]))
+                if li is not None:
+                    collect(li)
+                index += 1
+            remaining = next((id for id in definition_order if id not in seen), None)
+            if remaining is None:
+                break
+            seen.add(remaining)
+            order.append(remaining)
+
+        if order == definition_order:
+            return
+
+        numbers = {id: num for num, id in enumerate(order, start=1)}
+        superscript_text = self.footnotes.getConfig('SUPERSCRIPT_TEXT')
+        for link, id in links:
+            link.text = superscript_text.format(numbers[id])
+
+        backlink_title = self.footnotes.getConfig('BACKLINK_TITLE').replace('%d', '{}')
+        items = []
+        for id in order:
+            li = li_map[self.footnotes.makeFootnoteId(id)]
+            for link in li.iter('a'):
+                if link.get('class', '') == 'footnote-backref':
+                    link.set('title', backlink_title.format(numbers[id]))
+            items.append(li)
+        ol[:] = items
+
+
 class FootnoteTreeprocessor(Treeprocessor):
     """ Build and append footnote div to end of document. """
 

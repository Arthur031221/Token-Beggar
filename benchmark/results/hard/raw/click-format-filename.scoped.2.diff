+@pytest.mark.skipif(os.name == "nt", reason="surrogateescape paths are POSIX only")
+def test_surrogate_filename_messages_encodable():
+    name = "foo\udce9"
+
+    for exc in (
+        click.FileError(name),
+        click.FileError(os.fsencode(name)),
+    ):
+        exc.format_message().encode("utf-8")
+
+    with pytest.raises(click.BadParameter) as e:
+        click.Path(exists=True).convert(name, None, None)
+
+    e.value.format_message().encode("utf-8")
+
+    with pytest.raises(click.BadParameter) as e:
+        click.File().convert(name, None, None)
+
+    e.value.format_message().encode("utf-8")

diff --git a/pylint/utils/utils.py b/pylint/utils/utils.py
index fa7f7b92f..72768a557 100644
--- a/pylint/utils/utils.py
+++ b/pylint/utils/utils.py
@@ -253,6 +253,59 @@ def _check_csv(value: list[str] | tuple[str] | str) -> Sequence[str]:
     return _splitstrip(value)
 
 
+def _check_regexp_csv(value: list[str] | tuple[str] | str) -> Sequence[str]:
+    r"""Split a comma-separated list of regular expressions.
+
+    Unlike ``_check_csv``, commas that are part of a regular expression are not
+    treated as separators: commas inside a quantifier (``\d{1,3}``), inside a
+    character class (``[,;]``) or escaped with a backslash (``\,``) are kept.
+    Empty strings are discarded.
+
+    >>> _check_regexp_csv(r'foo{1,3}, [a,b], c\,d')
+    ['foo{1,3}', '[a,b]', 'c\\,d']
+    """
+    if isinstance(value, (list, tuple)):
+        return value
+    regexps: list[str] = []
+    current: list[str] = []
+    in_braces = False
+    in_class = False
+    index = 0
+    while index < len(value):
+        char = value[index]
+        if char == "\\" and index + 1 < len(value):
+            # Keep escape sequences as-is, an escaped comma is not a separator
+            current.append(value[index : index + 2])
+            index += 2
+            continue
+        if in_class:
+            if char == "]":
+                in_class = False
+        elif char == "[":
+            in_class = True
+            # A ']' right after '[' or '[^' is a literal and doesn't close the class
+            lookahead = index + 1
+            if value[lookahead : lookahead + 1] == "^":
+                lookahead += 1
+            if value[lookahead : lookahead + 1] == "]":
+                current.append(value[index : lookahead + 1])
+                index = lookahead + 1
+                continue
+        elif char == "{":
+            in_braces = True
+        elif char == "}":
+            in_braces = False
+        elif char == "," and not in_braces:
+            regexps.append("".join(current))
+            current = []
+            index += 1
+            continue
+        current.append(char)
+        index += 1
+    regexps.append("".join(current))
+    return [regexp.strip() for regexp in regexps if regexp.strip()]
+
+
 def _comment(string: str) -> str:
     """Return string as a comment."""
     lines = [line.strip() for line in string.splitlines()]

 RCFILE = ".pyreverserc"
 
 
@@ -213,3 +215,47 @@ class LocalsVisitor(ASTWalker):
         if methods[1] is not None:
             return methods[1](node)
         return None
+
+
+def get_annotation(node):
+    """Return the annotation node of an AssignAttr/AssignName, or None.
+
+    The annotation comes either from an enclosing AnnAssign, or from the
+    annotation of the function argument whose value is being assigned.
+    """
+    parent = node.parent
+    if isinstance(parent, astroid.AnnAssign) and parent.target is node:
+        return parent.annotation
+    if not isinstance(parent, astroid.Assign):
+        return None
+    value = parent.value
+    if not isinstance(value, astroid.Name):
+        return None
+    func = node.scope()
+    if not isinstance(func, astroid.FunctionDef):
+        return None
+    args = func.args
+    groups = (
+        (
+            getattr(args, "posonlyargs", None) or [],
+            getattr(args, "posonlyargs_annotations", None) or [],
+        ),
+        (args.args or [], args.annotations or []),
+        (args.kwonlyargs or [], args.kwonlyargs_annotations or []),
+    )
+    for arguments, annotations in groups:
+        for arg, annotation in zip(arguments, annotations):
+            if arg.name == value.name:
+                return annotation
+    return None
+
+
+def infer_node(node):
+    """Return the set of types of node: its annotation if any, else inferred values."""
+    annotation = get_annotation(node)
+    if annotation is not None:
+        return {annotation}
+    try:
+        return set(node.infer())
+    except astroid.InferenceError:
+        return set()

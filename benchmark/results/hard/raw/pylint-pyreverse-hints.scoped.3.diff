+def test_get_annotation_and_infer_node():
+    func = astroid.extract_node(
+        """
+    class C:
+        def __init__(self, a: str = None, *, k: List[int] = None):  #@
+            self.a = a
+            self.k = k
+            self.x: int = None
+            self.n = None
+    """
+    )
+    attrs = [n.targets[0] if hasattr(n, "targets") else n.target for n in func.body]
+    assert get_annotation(attrs[0]).as_string() == "str"
+    assert get_annotation(attrs[1]).as_string() == "List[int]"
+    assert get_annotation(attrs[2]).as_string() == "int"
+    assert get_annotation(attrs[3]) is None
+    assert {n.as_string() for n in infer_node(attrs[0])} == {"str"}
+    assert [n.value for n in infer_node(attrs[3])] == [None]
+
+
+def test_class_diagram_uses_type_hints():
+    module = astroid.parse(
+        """
+    class C(object):
+        def __init__(self, a: str = None):
+            self.a = a
+
+    class D:
+        b: int = None
+    """
+    )
+    project = inspector.Project("p")
+    project.add_module(module)
+    inspector.Linker(project).visit(project)
+    diagram = ClassDiagram("t", "ALL")
+    assert diagram.get_attrs(module["C"]) == ["a : str"]
+    assert diagram.get_attrs(module["D"]) == ["b : int"]

+def get_annotation_label(ann):
+    """return a printable label for an annotation node"""
+    if isinstance(ann, astroid.Name):
+        return ann.name
+    if isinstance(ann, astroid.NodeNG):
+        return ann.as_string()
+    return ""
+
+
+def get_annotation(node):
+    """return the annotation node (PEP 484) of an AssignName/AssignAttr, or None"""
+    ann = None
+    parent = node.parent
+    if isinstance(parent, astroid.AnnAssign):
+        return parent.annotation
+    if isinstance(node, astroid.AssignAttr):
+        value = getattr(parent, "value", None)
+        func = node.frame()
+        if (
+            isinstance(parent, astroid.Assign)
+            and isinstance(value, astroid.Name)
+            and isinstance(func, astroid.FunctionDef)
+            and func.name == "__init__"
+        ):
+            args = func.args
+            for index, arg in enumerate(args.args or []):
+                if arg.name != value.name:
+                    continue
+                if index < len(args.annotations):
+                    ann = args.annotations[index]
+                break
+    return ann
+
+
+def infer_node(node):
+    """return the set of inferred values  of a node"""
+    ann = get_annotation(node)
+    if isinstance(ann, astroid.Subscript):
+        return {ann}
+    try:
+        if ann:
+            return set(ann.infer())
+        return set(node.infer())
+    except astroid.InferenceError:
+        return {ann} if ann else set()
+
+
 class FilterMixIn:
     """filter nodes according to a mode and nodes' visibility"""
 
diff --git a/tests/unittest_pyreverse_utils.py b/tests/unittest_pyreverse_utils.py
new file mode 100644
index 00000000..21694156
--- /dev/null
+++ b/tests/unittest_pyreverse_utils.py
@@ -0,0 +1,43 @@
+"""Unit tests for the type hint helpers of pyreverse."""
+import astroid
+import pytest
+
+from pylint.pyreverse.utils import get_annotation, get_annotation_label, infer_node
+
+
+@pytest.mark.parametrize(
+    "code, label",
+    [
+        ("class C:\n    x: int = None", "int"),
+        ("class C:\n    x: Optional[str] = None", "Optional[str]"),
+    ],
+)
+def test_class_level_annotation(code, label):
+    module = astroid.parse(code)
+    target = module.body[0].body[0].target
+    assert get_annotation_label(get_annotation(target)) == label
+
+
+def test_init_argument_annotation():
+    module = astroid.parse(
+        "class C:\n    def __init__(self, a: str = None):\n        self.a = a\n"
+    )
+    attr = module["C"].instance_attrs["a"][0]
+    assert get_annotation_label(get_annotation(attr)) == "str"
+    assert [v.name for v in infer_node(attr)] == ["str"]
+
+
+def test_instance_annotated_assign():
+    module = astroid.parse(
+        "class C:\n    def __init__(self):\n        self.b: Optional[str] = None\n"
+    )
+    attr = module["C"].instance_attrs["b"][0]
+    assert get_annotation_label(get_annotation(attr)) == "Optional[str]"
+    assert len(infer_node(attr)) == 1
+
+
+def test_no_annotation():
+    module = astroid.parse("class C:\n    def __init__(self, a):\n        self.a = a\n")
+    attr = module["C"].instance_attrs["a"][0]
+    assert get_annotation(attr) is None
+    assert infer_node(attr) == set(attr.infer())

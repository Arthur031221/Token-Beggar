+    @skipUnlessDBFeature("supports_foreign_keys", "supports_collation_on_charfield")
+    def test_alter_field_pk_fk_db_collation(self):
+        """
+        AlterField on a primary key's db_collation updates the collation of
+        the foreign keys pointing to it.
+        """
+        collation = connection.features.test_collations.get("non_default")
+        if not collation:
+            self.skipTest("Language collations are not supported.")
+
+        app_label = "test_alflpkfkcoll"
+        project_state = self.apply_operations(
+            app_label,
+            ProjectState(),
+            [
+                migrations.CreateModel(
+                    "Parent",
+                    fields=[("id", models.CharField(primary_key=True, max_length=22))],
+                ),
+                migrations.CreateModel(
+                    "Child",
+                    fields=[
+                        ("id", models.AutoField(primary_key=True)),
+                        (
+                            "parent",
+                            models.ForeignKey(f"{app_label}.Parent", models.CASCADE),
+                        ),
+                        (
+                            "parent_o2o",
+                            models.OneToOneField(
+                                f"{app_label}.Parent",
+                                models.CASCADE,
+                                related_name="+",
+                            ),
+                        ),
+                    ],
+                ),
+            ],
+        )
+        child_table = f"{app_label}_child"
+
+        def get_collation(column):
+            return {
+                c.name: c.collation for c in self.get_table_description(child_table)
+            }[column]
+
+        self.assertNotEqual(get_collation("parent_id"), collation)
+        operation = migrations.AlterField(
+            "Parent",
+            "id",
+            models.CharField(primary_key=True, max_length=22, db_collation=collation),
+        )
+        new_state = project_state.clone()
+        operation.state_forwards(app_label, new_state)
+        with connection.schema_editor() as editor:
+            operation.database_forwards(app_label, editor, project_state, new_state)
+        self.assertEqual(get_collation("parent_id"), collation)
+        self.assertEqual(get_collation("parent_o2o_id"), collation)
+        with connection.schema_editor() as editor:
+            operation.database_backwards(app_label, editor, new_state, project_state)
+        self.assertNotEqual(get_collation("parent_id"), collation)
+        self.assertNotEqual(get_collation("parent_o2o_id"), collation)
+

diff --git a/tests/processors/test_processors.py b/tests/processors/test_processors.py
index 09ea0e9..51a931d 100644
--- a/tests/processors/test_processors.py
+++ b/tests/processors/test_processors.py
@@ -269,6 +269,27 @@ class TestFigureOutExcInfo:
 
         assert (e.__class__, e, None) == _figure_out_exc_info(e)
 
+    @pytest.mark.parametrize("false_value", [None, False, 0, ""])
+    def test_returns_none_on_false(self, false_value):
+        """
+        If the passed argument evaluates to False, return None.
+        """
+        assert None is _figure_out_exc_info(false_value)
+
+    def test_returns_none_if_no_current_exception(self):
+        """
+        If asked to obtain exc_info ourselves outside of an exception handler,
+        return None.
+        """
+        assert None is _figure_out_exc_info(True)
+
+    def test_returns_none_on_missing_exc_info_tuple(self):
+        """
+        A missing exc_info tuple (as returned by sys.exc_info() outside of an
+        exception handler) is converted to None.
+        """
+        assert None is _figure_out_exc_info((None, None, None))
+
 

+class FootnoteReorderingProcessor(Treeprocessor):
+    """ Reorder and renumber footnotes by the order of their first reference in the document. """
+
+    def __init__(self, footnotes: FootnoteExtension):
+        self.footnotes = footnotes
+
+    def run(self, root: etree.Element) -> None:
+        if self.footnotes.getConfig("USE_DEFINITION_ORDER"):
+            return
+        for div in root.iter('div'):
+            if div.attrib.get('class', '') == 'footnote':
+                # Footnotes should be under the first ordered list under
+                # the footnote div.  So once we find it, quit.
+                for ol in div.iter('ol'):
+                    self.reorder_footnotes(root, div, ol)
+                    break
+                break
+
+    def find_refs(self, element: etree.Element, skip: etree.Element | None = None) -> list[etree.Element]:
+        """ Return footnote reference links within `element` in document order, ignoring `skip`. """
+        refs = []
+        for child in element:
+            if child is skip:
+                continue
+            if child.tag == 'a' and child.attrib.get('class', '') == 'footnote-ref':
+                refs.append(child)
+            refs.extend(self.find_refs(child, skip))
+        return refs
+
+    def reorder_footnotes(self, root: etree.Element, div: etree.Element, ol: etree.Element) -> None:
+        """ Reorder the `li` items of `ol` and update all footnote numbers. """
+        items = {'#' + li.attrib.get('id', ''): li for li in ol}
+        order: list[etree.Element] = []
+        refs = []
+
+        def add_refs(links: list[etree.Element]) -> None:
+            for link in links:
+                li = items.get(link.attrib.get('href', ''))
+                if li is not None:
+                    refs.append((link, li))
+                    if li not in order:
+                        order.append(li)
+
+        # References in the document body come first, followed by references
+        # nested within footnotes in the order those footnotes are referenced.
+        add_refs(self.find_refs(root, skip=div))
+        i = 0
+        while i < len(order):
+            add_refs(self.find_refs(order[i]))
+            i += 1
+        # Footnotes which are never referenced retain their definition order.
+        order.extend(li for li in ol if li not in order)
+
+        for li in order:
+            ol.remove(li)
+            ol.append(li)
+
+        numbers = {li: index for index, li in enumerate(order, start=1)}
+        superscript_text = self.footnotes.getConfig("SUPERSCRIPT_TEXT")
+        for link, li in refs:
+            link.text = superscript_text.format(numbers[li])
+
+        # Backward compatibility with old '%d' placeholder
+        backlink_title = self.footnotes.getConfig("BACKLINK_TITLE").replace("%d", "{}")
+        for li, index in numbers.items():
+            for link in li.iter('a'):
+                if link.attrib.get('class', '') == 'footnote-backref':
+                    link.set('title', backlink_title.format(index))
+

+class FootnoteReorderingProcessor(Treeprocessor):
+    """ Number and order footnotes by the order in which they are first referenced. """
+
+    def __init__(self, footnotes: FootnoteExtension):
+        self.footnotes = footnotes
+
+    def run(self, root: etree.Element) -> None:
+        if not self.footnotes.footnotes or self.footnotes.getConfig("USE_DEFINITION_ORDER"):
+            return
+        for div in root.iter('div'):
+            if div.attrib.get('class', '') == 'footnote':
+                # Footnotes should be under the first ordered list under
+                # the footnote div.  So once we find it, quit.
+                for ol in div.iter('ol'):
+                    self.reorder(root, div, ol)
+                    break
+                break
+
+    def reorder(self, root: etree.Element, div: etree.Element, ol: etree.Element) -> None:
+        """ Renumber the references and reorder the `li` elements of `ol`. """
+        hrefs = {'#' + self.footnotes.makeFootnoteId(id): id for id in self.footnotes.footnotes}
+        items = {li.attrib.get('id'): li for li in ol}
+        order: list[str] = []
+        refs: list[tuple[etree.Element, str]] = []
+
+        def collect(element: etree.Element) -> None:
+            """ Collect footnote references below `element` in document order. """
+            for child in element:
+                if child is div:
+                    continue
+                if child.tag == 'a' and child.attrib.get('class', '') == 'footnote-ref':
+                    id = hrefs.get(child.attrib.get('href', ''))
+                    if id is not None:
+                        refs.append((child, id))
+                        if id not in order:
+                            order.append(id)
+                collect(child)
+
+        # References in the document body come first. References which only
+        # appear within footnotes follow, in the order they are encountered
+        # when reading the footnotes in their new order. Footnotes which are
+        # never referenced are placed last, in definition order.
+        collect(root)
+        index = 0
+        remaining = list(self.footnotes.footnotes)
+        while True:
+            while index < len(order):
+                li = items.get(self.footnotes.makeFootnoteId(order[index]))
+                if li is not None:
+                    collect(li)
+                index += 1
+            unreferenced = [id for id in remaining if id not in order]
+            if not unreferenced:
+                break
+            order.append(unreferenced[0])
+            remaining = unreferenced[1:]
+        self.footnotes.footnote_order = order
+
+        numbers = {id: num for num, id in enumerate(order, start=1)}
+        for a, id in refs:
+            a.text = self.footnotes.getConfig("SUPERSCRIPT_TEXT").format(numbers[id])
+
+        # Backward compatibility with old '%d' placeholder
+        backlink_title = self.footnotes.getConfig("BACKLINK_TITLE").replace("%d", "{}")
+        new = [items.pop(self.footnotes.makeFootnoteId(id)) for id in order
+               if self.footnotes.makeFootnoteId(id) in items]
+        # Keep any unexpected children at the end.
+        new += [li for li in ol if li not in new]
+        for li in list(ol):
+            ol.remove(li)
+        for num, li in enumerate(new, start=1):
+            ol.append(li)
+            for a in li.iter('a'):
+                if a.attrib.get('class', '') == 'footnote-backref':
+                    a.set('title', backlink_title.format(num))
+
+

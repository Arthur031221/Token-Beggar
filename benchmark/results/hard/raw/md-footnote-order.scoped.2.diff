+        # Reorder items and fix backlink titles.
+        backlink_title = fn.getConfig("BACKLINK_TITLE").replace("%d", "{}")
+        items = []
+        for id in final:
+            li = lis.get(fn.makeFootnoteId(id))
+            if li is None:
+                continue
+            items.append(li)
+            for link in li.iter('a'):
+                if link.attrib.get('class', '') == 'footnote-backref':
+                    link.set('title', backlink_title.format(numbers[id]))
+        if len(items) == len(lis):
+            for li in list(ol):

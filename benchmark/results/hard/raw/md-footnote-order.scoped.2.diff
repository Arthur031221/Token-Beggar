+    def reorder(self, root: etree.Element, div: etree.Element, ol: etree.Element) -> None:
+        """ Order footnotes by first reference; renumber references and backlink titles. """
+        fn = self.footnotes
+        ids = {fn.makeFootnoteId(id): id for id in fn.footnotes}
+        lis = {li.attrib.get('id', ''): li for li in ol}
+        # References in the body, in document order.
+        order: list[str] = []
+        seen: set[str] = set()
+        for id in self.find_refs(root, ids, skip=div):
+            if id not in seen:
+                seen.add(id)
+                order.append(id)
+        # References nested within footnotes, discovered in order of the footnotes listed so far.
+        i = 0

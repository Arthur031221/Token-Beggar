@@ -336,3 +336,101 @@ class TestFootnotes(TestCase):
             '</div>',
             extension_configs={'footnotes': {'SUPERSCRIPT_TEXT': '[{}]'}}
         )
+
+    def _fn_li(self, id, n, body):
+        return (
+            f'<li id="fn:{id}">\n'
+            f'<p>{body}&#160;<a class="footnote-backref" href="#fnref:{id}"'
+            f' title="Jump back to footnote {n} in the text">&#8617;</a></p>\n'
+            '</li>\n'
+        )
+
+    def _ref(self, id, n, ref_id=None):
+        return f'<sup id="{ref_id or "fnref:" + id}"><a class="footnote-ref" href="#fn:{id}">{n}</a></sup>'
+
+    def test_reference_order(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                defined[^b] rather than occurrence[^a] in the text.
+
+                [^a]: blah
+                [^b]: blurb
+                """
+            ),
+            f'<p>defined{self._ref("b", 1)} rather than occurrence{self._ref("a", 2)} in the text.</p>\n'
+            '<div class="footnote">\n<hr />\n<ol>\n'
+            + self._fn_li('b', 1, 'blurb') + self._fn_li('a', 2, 'blah') +
+            '</ol>\n</div>'
+        )
+
+    def test_definition_order(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                defined[^b] rather than occurrence[^a] in the text.
+
+                [^a]: blah
+                [^b]: blurb
+                """
+            ),
+            f'<p>defined{self._ref("b", 2)} rather than occurrence{self._ref("a", 1)} in the text.</p>\n'
+            '<div class="footnote">\n<hr />\n<ol>\n'
+            + self._fn_li('a', 1, 'blah') + self._fn_li('b', 2, 'blurb') +
+            '</ol>\n</div>',
+            extension_configs={'footnotes': {'USE_DEFINITION_ORDER': True}}
+        )
+
+    def test_nested_reference_order(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                text[^a]
+
+                [^c]: third
+                [^b]: second
+                [^a]: first[^c]
+                """
+            ),
+            f'<p>text{self._ref("a", 1)}</p>\n'
+            '<div class="footnote">\n<hr />\n<ol>\n'
+            + self._fn_li('a', 1, f'first{self._ref("c", 2)}')
+            + self._fn_li('c', 2, 'third') + self._fn_li('b', 3, 'second') +
+            '</ol>\n</div>'
+        )
+
+    def test_unreferenced_footnote_kept(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                text[^b]
+
+                [^a]: unused
+                [^b]: used
+                """
+            ),
+            f'<p>text{self._ref("b", 1)}</p>\n'
+            '<div class="footnote">\n<hr />\n<ol>\n'
+            + self._fn_li('b', 1, 'used') + self._fn_li('a', 2, 'unused') +
+            '</ol>\n</div>'
+        )
+
+    def test_duplicate_references_order(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                one[^b] two[^a] three[^b]
+
+                [^a]: A
+                [^b]: B
+                """
+            ),
+            f'<p>one{self._ref("b", 1)} two{self._ref("a", 2)} three{self._ref("b", 1, "fnref2:b")}</p>\n'
+            '<div class="footnote">\n<hr />\n<ol>\n'
+            '<li id="fn:b">\n'
+            '<p>B&#160;<a class="footnote-backref" href="#fnref:b" title="Jump back to footnote 1 in the text">'
+            '&#8617;</a><a class="footnote-backref" href="#fnref2:b" title="Jump back to footnote 1 in the text">'
+            '&#8617;</a></p>\n</li>\n'
+            + self._fn_li('a', 2, 'A') +
+            '</ol>\n</div>'
+        )

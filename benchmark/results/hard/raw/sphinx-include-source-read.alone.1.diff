+            return self._run()
+
+        # Included reST text is passed to ``StateMachine.insert_input()``;
+        # wrap it so that "source-read" listeners can modify the included
+        # source as well (refs: #10678).
+        state_machine = self.state_machine
+        original_insert_input = state_machine.insert_input
+
+        def insert_input(include_lines: list[str], source: str) -> None:
+            # docutils appends two marker lines (an empty line and an
+            # "end of inclusion" comment); keep them out of the event.
+            text = '\n'.join(include_lines[:-2])
+            docname = self.env.path2doc(abspath(source)) or self.env.docname
+            arg = [text]
+            self.env.events.emit('source-read', docname, arg)
+            include_lines = arg[0].splitlines() + include_lines[-2:]
+            original_insert_input(include_lines, source)
+
+        state_machine.insert_input = insert_input  # type: ignore[method-assign]
+        try:
+            return self._run()
+        finally:
+            state_machine.insert_input = original_insert_input  # type: ignore[method-assign]
+

diff --git a/tests/test_directive_other.py b/tests/test_directive_other.py
index f221db075..e99342a08 100644
--- a/tests/test_directive_other.py
+++ b/tests/test_directive_other.py
@@ -148,3 +148,43 @@ def test_toctree_twice(app):
     assert_node(doctree[0][0],
                 entries=[(None, 'foo'), (None, 'foo')],
                 includefiles=['foo', 'foo'])
+
+
+@pytest.mark.sphinx('html', testroot='directive-include', freshenv=True)
+def test_include_source_read_event(app):
+    sources_reported = []
+
+    def source_read_handler(app, docname, source):
+        sources_reported.append((docname, source[0]))
+        source[0] = source[0].replace('&REPLACE_ME;', 'REPLACED')
+
+    app.connect('source-read', source_read_handler)
+    app.build()
+
+    # every included file is reported, with its own docname when it is a
+    # document and with the including docname otherwise
+    reported = {(docname, text.strip()) for docname, text in sources_reported}
+    assert ('foo', 'Foo\n---\n\nfoo: &REPLACE_ME;\n\n.. include:: bar.txt') in reported
+    assert ('index', 'bar: &REPLACE_ME;') in reported
+    assert ('foo', 'bar: &REPLACE_ME;') in reported
+    assert ('index', 'text: &REPLACE_ME;') in reported
+    assert ('baz/baz', 'text: &REPLACE_ME;') in reported
+
+    for docname in ('index', 'foo', 'baz/baz'):
+        html = (app.outdir / f'{docname}.html').read_text(encoding='utf8')
+        assert '&amp;REPLACE_ME;' not in html
+        assert 'REPLACED' in html
+
+    index_html = (app.outdir / 'index.html').read_text(encoding='utf8')
+    assert '<p>foo: REPLACED</p>' in index_html
+    assert '<p>bar: REPLACED</p>' in index_html
+    assert '<p>text: REPLACED</p>' in index_html
+
+
+@pytest.mark.sphinx(testroot='directive-include', freshenv=True)
+def test_include_without_source_read_listeners(app):
+    app.build()
+    doctree = app.env.get_doctree('index')
+    assert 'foo: &REPLACE_ME;' in doctree.astext()
+    assert 'bar: &REPLACE_ME;' in doctree.astext()
+    assert 'text: &REPLACE_ME;' in doctree.astext()

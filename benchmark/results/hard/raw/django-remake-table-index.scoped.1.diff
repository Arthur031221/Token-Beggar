+    @isolate_apps("schema")
+    @skipUnlessDBFeature("supports_collation_on_charfield")
+    def test_db_collation_primary_key_related_fields_create(self):
+        collation = connection.features.test_collations.get("non_default")
+        if not collation:
+            self.skipTest("Language collations are not supported.")
+
+        class Parent(Model):
+            id = CharField(max_length=20, primary_key=True, db_collation=collation)
+
+            class Meta:
+                app_label = "schema"
+
+        class Child(Model):
+            fk = ForeignKey(Parent, CASCADE)
+            o2o = OneToOneField(Parent, CASCADE, related_name="+")
+
+            class Meta:
+                app_label = "schema"
+
+        self.assertEqual(
+            Child._meta.get_field("fk").db_parameters(connection)["collation"],
+            collation,
+        )
+        self.isolated_local_models = [Parent, Child]
+        with connection.schema_editor() as editor:
+            editor.create_model(Parent)
+            editor.create_model(Child)
+        for column in ("fk_id", "o2o_id"):
+            self.assertEqual(
+                self.get_column_collation(Child._meta.db_table, column), collation
+            )
+
+    @isolate_apps("schema")
+    @skipUnlessDBFeature("supports_collation_on_charfield")
+    def test_alter_primary_key_db_collation_related_fields(self):
+        collation = connection.features.test_collations.get("non_default")
+        if not collation:
+            self.skipTest("Language collations are not supported.")
+
+        class Parent(Model):
+            id = CharField(max_length=20, primary_key=True)
+
+            class Meta:
+                app_label = "schema"
+
+        class Child(Model):
+            fk = ForeignKey(Parent, CASCADE)
+            o2o = OneToOneField(Parent, CASCADE, related_name="+")
+
+            class Meta:
+                app_label = "schema"
+
+        class NewParent(Model):
+            id = CharField(max_length=20, primary_key=True, db_collation=collation)
+
+            class Meta:
+                app_label = "schema"
+                db_table = Parent._meta.db_table
+
+        class NewChild(Model):
+            fk = ForeignKey(NewParent, CASCADE)
+            o2o = OneToOneField(NewParent, CASCADE, related_name="+")
+
+            class Meta:
+                app_label = "schema"
+                db_table = Child._meta.db_table
+
+        self.isolated_local_models = [Parent, Child]
+        with connection.schema_editor() as editor:
+            editor.create_model(Parent)
+            editor.create_model(Child)
+        old_field = Parent._meta.get_field("id")
+        new_field = NewParent._meta.get_field("id")
+        with connection.schema_editor() as editor:
+            editor.alter_field(Parent, old_field, new_field, strict=True)
+        for column in ("fk_id", "o2o_id"):
+            self.assertEqual(
+                self.get_column_collation(Child._meta.db_table, column), collation
+            )
+        if connection.features.supports_foreign_keys:
+            self.assertEqual(
+                len(
+                    [
+                        c
+                        for c in self.get_constraints(Child._meta.db_table).values()
+                        if c["foreign_key"]
+                    ]
+                ),
+                2,
+            )
+
     @skipUnlessDBFeature(
         "supports_collation_on_charfield", "supports_collation_on_textfield"
     )

index 4f31037c..2e98a415 100644
--- a/tests/test_routing.py
+++ b/tests/test_routing.py
@@ -299,6 +299,75 @@ def test_duplicate_rule() -> None:
         )
 
 
+def test_no_duplicate_different_methods() -> None:
+    """Rules with disjoint methods are not duplicates."""
+    r.Map(
+        [
+            r.Rule("/", endpoint="a", methods=["GET"]),
+            r.Rule("/", endpoint="b", methods=["POST"]),
+        ]
+    )
+
+
+def test_duplicate_overlapping_methods() -> None:
+    """Rules sharing any method are duplicates."""
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/", endpoint="a", methods=["GET", "POST"]),
+                r.Rule("/", endpoint="b", methods=["POST", "PUT"]),
+            ]
+        )
+
+
+@pytest.mark.parametrize("first_none", [True, False])
+def test_duplicate_methods_none(first_none: bool) -> None:
+    """A rule without methods matches all methods, so it duplicates any rule."""
+    rules = [
+        r.Rule("/", endpoint="a"),
+        r.Rule("/", endpoint="b", methods=["POST"]),
+    ]
+
+    if not first_none:
+        rules.reverse()
+
+    with pytest.raises(DuplicateRuleError):
+        r.Map(rules)
+
+
+def test_duplicate_head_added_with_get() -> None:
+    """HEAD is added automatically with GET, so they overlap."""
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/", endpoint="a", methods=["GET"]),
+                r.Rule("/", endpoint="b", methods=["HEAD"]),
+            ]
+        )
+
+
+def test_duplicate_merge_slashes() -> None:
+    """Paths are compared after merging slashes."""
+    with pytest.raises(DuplicateRuleError):
+        r.Map([r.Rule("/a//b", endpoint="a"), r.Rule("/a/b", endpoint="b")])
+
+    r.Map(
+        [
+            r.Rule("/a//b", endpoint="a", merge_slashes=False),
+            r.Rule("/a/b", endpoint="b"),
+        ]
+    )
+
+
+@pytest.mark.parametrize("strict_slashes", [True, False])
+def test_no_duplicate_trailing_slash(strict_slashes: bool) -> None:
+    """A trailing slash makes rules distinct regardless of strict_slashes."""
+    r.Map(
+        [r.Rule("/a", endpoint="a"), r.Rule("/a/", endpoint="b")],
+        strict_slashes=strict_slashes,
+    )
+
+

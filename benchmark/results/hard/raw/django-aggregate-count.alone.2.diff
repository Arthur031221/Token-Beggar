+
+    def test_non_aggregate_annotation_pruned(self):
+        with CaptureQueriesContext(connection) as ctx:
+            cnt = Book.objects.annotate(name_lower=Lower("name")).count()
+        self.assertEqual(cnt, Book.objects.count())
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertEqual(sql.count("select"), 1, "No subquery wrapping required")
+        self.assertNotIn("name_lower", sql)
+
+    def test_unreferenced_aggregate_annotation_pruned(self):
+        with CaptureQueriesContext(connection) as ctx:
+            cnt = Book.objects.annotate(authors_count=Count("authors")).count()
+        self.assertEqual(cnt, Book.objects.count())
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertEqual(sql.count("select"), 2, "Subquery wrapping required")
+        self.assertNotIn("authors_count", sql)
+
+    def test_unused_aliased_aggregate_pruned(self):
+        with CaptureQueriesContext(connection) as ctx:
+            cnt = Book.objects.alias(authors_count=Count("authors")).count()
+        self.assertEqual(cnt, Book.objects.count())
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertNotIn("authors_count", sql)
+
+    def test_referenced_aggregate_annotation_kept(self):
+        with CaptureQueriesContext(connection) as ctx:
+            result = Book.objects.annotate(
+                authors_count=Count("authors"),
+                name_lower=Lower("name"),
+            ).aggregate(Sum("authors_count"))
+        self.assertEqual(result["authors_count__sum"], 10)
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertIn("authors_count", sql)
+        self.assertNotIn("name_lower", sql)
+
+    def test_filtered_aggregate_annotation_pruned(self):
+        with CaptureQueriesContext(connection) as ctx:
+            cnt = (
+                Book.objects.annotate(authors_count=Count("authors"))
+                .filter(authors_count__gt=1)
+                .count()
+            )
+        self.assertEqual(cnt, 3)
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertNotIn("authors_count", sql)
+
+    def test_non_aggregate_multivalued_annotation_pruned(self):
+        qs = Book.objects.annotate(author_name=F("authors__name"))
+        with CaptureQueriesContext(connection) as ctx:
+            cnt = qs.count()
+        self.assertEqual(cnt, len(qs))
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertNotIn("author_name", sql)
+
+    def test_grouped_by_annotation_count(self):
+        qs = (
+            Book.objects.annotate(publisher_name=Lower("publisher__name"))
+            .values("publisher_name")
+            .annotate(books_count=Count("id"))
+        )
+        with CaptureQueriesContext(connection) as ctx:
+            self.assertEqual(qs.count(), len(qs))
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertNotIn("books_count", sql)

+class FootnoteReorderingProcessor(Treeprocessor):
+    """ Number and sort footnotes in the order in which they are referenced. """
+
+    def __init__(self, footnotes: FootnoteExtension):
+        self.footnotes = footnotes
+
+    def run(self, root: etree.Element) -> None:
+        fn = self.footnotes
+        if not fn.footnotes:
+            return
+
+        div = None
+        for el in root.iter('div'):
+            if el.attrib.get('class', '') == 'footnote':
+                div = el
+                break
+        if div is None:
+            return
+        ol = div.find('ol')
+        if ol is None:
+            return
+
+        # Map the generated footnote `id` attributes back to footnote labels.
+        labels = {fn.makeFootnoteId(id): id for id in fn.footnotes.keys()}
+        items = {labels[li.get('id', '')]: li for li in ol if li.get('id', '') in labels}
+        refs: list[tuple[str, etree.Element]] = []
+        order = fn.footnote_order
+
+        def collect(parent: etree.Element) -> None:
+            """ Record footnote references under `parent` (excluding the footnotes `div`) in document order. """
+            for child in parent:
+                if child is div:
+                    continue
+                if child.tag == 'a' and child.get('class', '') == 'footnote-ref':
+                    label = labels.get(child.get('href', '')[1:])
+                    if label is not None:
+                        refs.append((label, child))
+                        if label not in order:
+                            order.append(label)
+                collect(child)
+
+        # References in the body of the document come first. References found within
+        # footnotes follow, in the order in which those footnotes are numbered.
+        collect(root)
+        index = 0
+        while True:
+            while index < len(order):
+                if order[index] in items:
+                    collect(items[order[index]])
+                index += 1
+            # Any footnotes which are never referenced follow in definition order.
+            remaining = [id for id in fn.footnotes.keys() if id not in order]
+            if not remaining:
+                break
+            order.append(remaining[0])
+
+        numbers = {id: num for num, id in enumerate(order, start=1)}
+        for label, a in refs:
+            a.text = fn.getConfig("SUPERSCRIPT_TEXT").format(numbers[label])
+
+        backlink_title = fn.getConfig("BACKLINK_TITLE").replace("%d", "{}")
+        for li in list(ol):
+            ol.remove(li)
+        for id in order:
+            li = items.get(id)
+            if li is None:
+                continue
+            for link in li.iter('a'):
+                if link.get('class', '') == 'footnote-backref':
+                    link.set('title', backlink_title.format(numbers[id]))
+            ol.append(li)
+

diff --git a/tests/aggregation/tests.py b/tests/aggregation/tests.py
index 39c8a45707..b98084e82d 100644
--- a/tests/aggregation/tests.py
+++ b/tests/aggregation/tests.py
@@ -34,6 +34,7 @@ from django.db.models.functions import (
     Cast,
     Coalesce,
     Greatest,
+    Lower,
     Now,
     Pi,
     TruncDate,
@@ -2084,3 +2085,74 @@ class AggregateTestCase(TestCase):
             exists=Exists(Author.objects.extra(where=["1=0"])),
         )
         self.assertEqual(len(qs), 6)
+
+    def test_unused_aliased_aggregate_pruned(self):
+        with CaptureQueriesContext(connection) as ctx:
+            cnt = Book.objects.alias(
+                authors_count=Count("authors"),
+            ).count()
+        self.assertEqual(cnt, Book.objects.count())
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertEqual(sql.count("select"), 2, "Subquery wrapping required")
+        self.assertNotIn("authors_count", sql)
+
+    def test_non_aggregate_annotation_pruned(self):
+        with CaptureQueriesContext(connection) as ctx:
+            cnt = Book.objects.annotate(
+                name_lower=Lower("name"),
+            ).count()
+        self.assertEqual(cnt, Book.objects.count())
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertEqual(sql.count("select"), 1, "No subquery wrapping required")
+        self.assertNotIn("name_lower", sql)
+
+    def test_unreferenced_aggregate_annotation_pruned(self):
+        with CaptureQueriesContext(connection) as ctx:
+            cnt = Book.objects.annotate(
+                authors_count=Count("authors"),
+            ).count()
+        self.assertEqual(cnt, Book.objects.count())
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertEqual(sql.count("select"), 2, "Subquery wrapping required")
+        self.assertNotIn("authors_count", sql)
+
+    def test_referenced_aggregate_annotation_kept(self):
+        with CaptureQueriesContext(connection) as ctx:
+            Book.objects.annotate(
+                authors_count=Count("authors"),
+            ).aggregate(Avg("authors_count"))
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertEqual(sql.count("select"), 2, "Subquery wrapping required")
+        self.assertEqual(sql.count("authors_count"), 2)
+
+    def test_referenced_non_aggregate_annotation_inlined(self):
+        qs = Book.objects.annotate(double_price=F("price") * 2)
+        with CaptureQueriesContext(connection) as ctx:
+            result = qs.aggregate(Sum("double_price"))
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertEqual(sql.count("select"), 1, "No subquery wrapping required")
+        self.assertEqual(
+            result["double_price__sum"],
+            Book.objects.aggregate(total=Sum("price"))["total"] * 2,
+        )
+
+    def test_count_annotation_referencing_unused_aggregate(self):
+        qs = Book.objects.annotate(
+            authors_count=Count("authors"),
+        ).annotate(authors_count_plus=F("authors_count") + 1)
+        self.assertEqual(qs.count(), Book.objects.count())
+        self.assertEqual(
+            qs.aggregate(Sum("authors_count")),
+            {"authors_count__sum": Book.objects.filter(authors__isnull=False).count()},
+        )
+
+    def test_count_pruned_annotations_keep_row_count(self):
+        qs = Book.objects.annotate(author_name=F("authors__name"))
+        self.assertEqual(qs.count(), len(qs))
+        qs = Book.objects.annotate(Count("authors"), author_name=F("authors__name"))
+        self.assertEqual(qs.count(), len(qs))
+        qs = Book.objects.annotate(authors_count=Count("authors"))
+        self.assertEqual(
+            qs.filter(authors_count__gt=1).count(),
+            len(qs.filter(authors_count__gt=1)),
+        )

diff --git a/pylint/utils/utils.py b/pylint/utils/utils.py
index fa7f7b92f..3f1ba7609 100644
--- a/pylint/utils/utils.py
+++ b/pylint/utils/utils.py
@@ -253,6 +253,47 @@ def _check_csv(value: list[str] | tuple[str] | str) -> Sequence[str]:
     return _splitstrip(value)
 
 
+def _check_regexp_csv(value: list[str] | tuple[str] | str) -> Sequence[str]:
+    r"""Split a comma separated list of regular expressions.
+
+    Commas that are part of a regular expression are not treated as separators:
+    commas inside groups ``(...)``, quantifiers ``{...}`` or character classes
+    ``[...]``, as well as escaped commas ``\,``, are kept.
+
+    >>> _check_regexp_csv(r'foo{1,3}, [a,b]+, (x|y,z), a\,b,,')
+    ['foo{1,3}', '[a,b]+', '(x|y,z)', 'a\\,b']
+    """
+    if isinstance(value, (list, tuple)):
+        return value
+    regexps: list[str] = []
+    current: list[str] = []
+    depth = 0  # Nesting level of unclosed '(' and '{'
+    class_start: int | None = None  # Index in `current` after an unclosed '['
+    chars = iter(value)
+    for char in chars:
+        if char == "\\":
+            current.append(char)
+            current.append(next(chars, ""))
+            continue
+        if class_start is not None:
+            # ']' directly after '[' or '[^' is a literal, not the end of the class
+            if char == "]" and current[class_start:] not in ([], ["^"]):
+                class_start = None
+        elif char == "[":
+            class_start = len(current) + 1
+        elif char in "({":
+            depth += 1
+        elif char in ")}" and depth:
+            depth -= 1
+        elif char == "," and not depth:
+            regexps.append("".join(current))
+            current = []
+            continue
+        current.append(char)
+    regexps.append("".join(current))
+    return [regexp.strip() for regexp in regexps if regexp.strip()]
+
+
 def _comment(string: str) -> str:
     """Return string as a comment."""
     lines = [line.strip() for line in string.splitlines()]
diff --git a/tests/config/test_config.py b/tests/config/test_config.py
index 83c8b072e..a73eb6eed 100644
--- a/tests/config/test_config.py
+++ b/tests/config/test_config.py
@@ -137,16 +137,60 @@ def test_csv_regex_error(capsys: CaptureFixture) -> None:
     """
     with pytest.raises(SystemExit):
         Run(
-            [str(EMPTY_MODULE), r"--bad-names-rgx=(foo{1,3})"],
+            [str(EMPTY_MODULE), r"--bad-names-rgxs=(foo{1,3}),(bar"],
             exit=False,
         )
     output = capsys.readouterr()
     assert (
-        r"Error in provided regular expression: (foo{1 beginning at index 0: missing ), unterminated subpattern"
+        r"Error in provided regular expression: (bar beginning at index 0: missing ), unterminated subpattern"
         in output.err
     )
 
 
+@pytest.mark.parametrize(
+    "in_string,expected",
+    [
+        ("", []),
+        ("foo", ["foo"]),
+        ("foo,bar", ["foo", "bar"]),
+        ("foo, bar,, ", ["foo", "bar"]),
+        ("(foo{1,3})", ["(foo{1,3})"]),
+        (r"\d{1,2},^ba{,3}r$", [r"\d{1,2}", "^ba{,3}r$"]),
+        ("[a,b]+,c", ["[a,b]+", "c"]),
+        ("[],]x,[^],]y,z", ["[],]x", "[^],]y", "z"]),
+        ("[(],a", ["[(]", "a"]),
+        ("(a|b,c),d", ["(a|b,c)", "d"]),
+        (r"a\,b,c", [r"a\,b", "c"]),
+        (r"a\\,b", [r"a\\", "b"]),
+    ],
+)
+def test_csv_regex_comma_in_quantifier(in_string: str, expected: list[str]) -> None:
+    """Check that commas that are part of a regular expression are not used
+    as separators.
+
+    Reported in https://github.com/pylint-dev/pylint/issues/7229.
+    """
+    run = Run(
+        [str(EMPTY_MODULE), f"--bad-names-rgxs={in_string}"],
+        exit=False,
+    )
+    bad_names_rgxs = run.linter.config.bad_names_rgxs
+    assert [regex.pattern for regex in bad_names_rgxs] == expected
+
+
+def test_csv_regex_comma_in_config_file(tmp_path: Path) -> None:
+    """Check that the regexes from the issue can be set in a configuration file."""
+    config_file = tmp_path / "pyproject.toml"
+    config_file.write_text(
+        '[tool.pylint.basic]\nbad-names-rgxs = "(foo{1,3}),bar"\n', encoding="utf-8"
+    )
+    run = Run([str(EMPTY_MODULE), f"--rcfile={config_file}"], exit=False)
+    assert [regex.pattern for regex in run.linter.config.bad_names_rgxs] == [
+        "(foo{1,3})",
+        "bar",
+    ]
+
+

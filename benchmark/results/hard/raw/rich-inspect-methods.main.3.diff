+def test_inspect_docstring_with_control_codes():
+    # Regression test: control codes in docstrings caused an IndexError
+    def function():
+        """Emulate the ``\b`` behavior.
+        Second line."""
+
+    module = ModuleType("my_module")
+    module.function = function
+
+    expected = (
+        "╭──────── <module 'my_module'> ─────────╮\n"
+        "│ function = def function():            │\n"
+        "│            Emulate the ```` behavior. │\n"
+        "│            Second line.               │\n"
+        "╰───────────────────────────────────────╯\n"
+    )
+    assert render(module, methods=True) == expected
diff --git a/tests/test_text.py b/tests/test_text.py
index 4f02fd4..1c55614 100644
--- a/tests/test_text.py
+++ b/tests/test_text.py
@@ -590,6 +590,24 @@ def test_strip_control_codes():
     assert str(text) == "foobar"
 
 
+def test_strip_control_codes_length():
+    text = Text("foo\x08bar\rbaz")
+    assert text.plain == "foobarbaz"
+    assert len(text) == 9
+    text.plain = "Hello\x08World"
+    assert text.plain == "HelloWorld"
+    assert len(text) == 10
+
+
+def test_stylize_with_control_codes():
+    # Spans must not extend beyond the text once control codes are stripped
+    text = Text("foo\x08\nbar")
+    text.stylize("bold")
+    assert text._spans == [Span(0, 7, "bold")]
+    lines = text.split(allow_blank=True)
+    assert [line.plain for line in lines] == ["foo", "bar"]
+
+

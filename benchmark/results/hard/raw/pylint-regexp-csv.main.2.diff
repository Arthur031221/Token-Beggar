diff --git a/pylint/utils/utils.py b/pylint/utils/utils.py
index fa7f7b92f..bceb97df0 100644
--- a/pylint/utils/utils.py
+++ b/pylint/utils/utils.py
@@ -253,6 +253,53 @@ def _check_csv(value: list[str] | tuple[str] | str) -> Sequence[str]:
     return _splitstrip(value)
 
 
+_REGEXP_QUANTIFIER = re.compile(r"\{\d*,\d*\}")
+
+
+def _check_regexp_csv(value: list[str] | tuple[str] | str) -> Sequence[str]:
+    r"""Split a comma-separated list of regular expressions.
+
+    Commas that belong to a regular expression are not treated as separators:
+    commas in a ``{m,n}`` quantifier, inside a character class such as ``[,;]``,
+    or escaped as ``\,``.
+
+    >>> _check_regexp_csv(r'foo{1,3}, [,;], a\,b')
+    ['foo{1,3}', '[,;]', 'a\\,b']
+    """
+    if isinstance(value, (list, tuple)):
+        return value
+    regexps: list[str] = []
+    current: list[str] = []
+    in_class = False
+    index = 0
+    while index < len(value):
+        char = value[index]
+        end = index + 1
+        if char == "\\":
+            end += 1
+        elif in_class:
+            in_class = char != "]"
+        elif char == "[":
+            in_class = True
+            # A ']' right after '[' or '[^' is a literal, not the end of the class
+            if value.startswith("^", end):
+                end += 1
+            if value.startswith("]", end):
+                end += 1
+        elif char == "{":
+            if quantifier := _REGEXP_QUANTIFIER.match(value, index):
+                end = quantifier.end()
+        elif char == ",":
+            regexps.append("".join(current))
+            current = []
+            index = end
+            continue
+        current.append(value[index:end])
+        index = end
+    regexps.append("".join(current))
+    return [regexp.strip() for regexp in regexps if regexp.strip()]
+
+
 def _comment(string: str) -> str:
     """Return string as a comment."""
     lines = [line.strip() for line in string.splitlines()]
diff --git a/tests/config/test_config.py b/tests/config/test_config.py
index 83c8b072e..1a3cba48d 100644
--- a/tests/config/test_config.py
+++ b/tests/config/test_config.py
@@ -137,16 +137,36 @@ def test_csv_regex_error(capsys: CaptureFixture) -> None:
     """
     with pytest.raises(SystemExit):
         Run(
-            [str(EMPTY_MODULE), r"--bad-names-rgx=(foo{1,3})"],
+            [str(EMPTY_MODULE), r"--bad-names-rgx=(foo{1,}, foo{1,3}})"],
             exit=False,
         )
     output = capsys.readouterr()
     assert (
-        r"Error in provided regular expression: (foo{1 beginning at index 0: missing ), unterminated subpattern"
+        r"Error in provided regular expression: (foo{1,} beginning at index 0: missing ), unterminated subpattern"
         in output.err
     )
 
 
+@pytest.mark.parametrize(
+    "value,expected",
+    [
+        ("(foo{1,3})", ["(foo{1,3})"]),
+        ("foo{1,3}, bar{,2}", ["foo{1,3}", "bar{,2}"]),
+        ("[,;]x,y", ["[,;]x", "y"]),
+        (r"a\,b,c", [r"a\,b", "c"]),
+    ],
+)
+def test_csv_regex_with_commas(value: str, expected: list[str]) -> None:
+    """Commas that are part of a regular expression must not split it.
+
+    Reported in https://github.com/pylint-dev/pylint/issues/7229.
+    """
+    r = Run([str(EMPTY_MODULE), f"--bad-names-rgxs={value}"], exit=False)
+    assert [
+        pattern.pattern for pattern in r.linter.config.bad_names_rgxs
+    ] == expected
+
+
 def test_short_verbose(capsys: CaptureFixture) -> None:

diff --git a/src/click/utils.py b/src/click/utils.py
index 6e74ace..2a12431 100644
--- a/src/click/utils.py
+++ b/src/click/utils.py
@@ -410,11 +410,23 @@ def format_filename(
                      the filename into unicode without failing.
     :param shorten: this optionally shortens the filename to strip of the
                     path that leads up to it.
+
+    Invalid bytes or surrogate escapes in the filename are replaced with the
+    Unicode replacement character, so the result can always be printed.
+
+    .. versionchanged:: 8.1.4
+        Invalid bytes and surrogates are replaced with the replacement
+        character instead of being passed through.
     """
     if shorten:
         filename = os.path.basename(filename)
+    else:
+        filename = os.fspath(filename)
+
+    if isinstance(filename, bytes):
+        return filename.decode(sys.getfilesystemencoding(), "replace")
 
-    return os.fsdecode(filename)
+    return filename.encode("utf-8", "surrogateescape").decode("utf-8", "replace")
 
 

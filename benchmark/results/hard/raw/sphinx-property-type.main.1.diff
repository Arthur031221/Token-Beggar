diff --git a/sphinx/util/inspect.py b/sphinx/util/inspect.py
index 23dd9e930..3e155a261 100644
--- a/sphinx/util/inspect.py
+++ b/sphinx/util/inspect.py
@@ -393,6 +393,26 @@ def isproperty(obj: Any) -> bool:
     return isinstance(obj, property)
 
 
+def getclassproperty(cls: Any, name: str) -> Any:
+    """Get the property wrapped by classmethod *name* of *cls* (available since py39).
+
+    Accessing such an attribute evaluates the property, so this looks up the raw
+    descriptor in the ``__dict__`` of *cls* and its base classes instead.  Return None
+    if the attribute is not a classmethod wrapping a property.
+    """
+    for basecls in getmro(cls):
+        __dict__ = safe_getattr(basecls, '__dict__', {})
+        if name in __dict__:
+            obj = __dict__[name]
+            func = safe_getattr(obj, '__func__', None)
+            if isinstance(obj, classmethod) and isproperty(func):
+                return func
+            else:
+                return None
+
+    return None
+

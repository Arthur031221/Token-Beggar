+def test_inspect_module_with_control_codes_in_docstring():
+    # Regression test: pyparsing docstrings contain a literal backspace character
+    def function():
+        """Use ``\b`` to
+        match a word boundary.
+        """
+
+    module = ModuleType("my_module")
+    module.function = function
+
+    expected = (
+        "╭────── <module 'my_module'> ───────╮\n"
+        "│ function = def function():        │\n"
+        "│            Use ```` to            │\n"
+        "│            match a word boundary. │\n"
+        "╰───────────────────────────────────╯\n"
+    )
+    assert render(module, methods=True) == expected
diff --git a/tests/test_text.py b/tests/test_text.py
index 4f02fd4..86d4ceb 100644
--- a/tests/test_text.py
+++ b/tests/test_text.py
@@ -590,6 +590,28 @@ def test_strip_control_codes():
     assert str(text) == "foobar"
 
 
+def test_strip_control_codes_length():
+    text = Text("foo\x08bar\x0b\x0c\r")
+    assert str(text) == "foobar"
+    assert len(text) == len(text.plain) == 6
+    text.plain = "\rbaz\x08"
+    assert str(text) == "baz"
+    assert len(text) == len(text.plain) == 3
+
+
+def test_wrap_with_control_codes():
+    # Length mismatch from stripped control codes used to raise IndexError
+    text = Text("Use \x08 to\n")
+    text.append("match a word boundary", "bold")
+    lines = text.wrap(Console(), 10)
+    assert [(line.plain, line.spans) for line in lines] == [
+        ("Use  to", []),
+        ("match a ", [Span(0, 8, "bold")]),
+        ("word ", [Span(0, 5, "bold")]),
+        ("boundary", [Span(0, 8, "bold")]),
+    ]
+
+

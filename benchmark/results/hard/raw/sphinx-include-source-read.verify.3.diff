index f221db075..20352d9c9 100644
--- a/tests/test_directive_other.py
+++ b/tests/test_directive_other.py
@@ -148,3 +148,23 @@ def test_toctree_twice(app):
     assert_node(doctree[0][0],
                 entries=[(None, 'foo'), (None, 'foo')],
                 includefiles=['foo', 'foo'])
+
+
+@pytest.mark.sphinx('html', testroot='directive-include')
+def test_include_source_read_event(app):
+    docnames = []
+
+    def source_read_handler(app, docname, source):
+        docnames.append(docname)
+        source[0] = source[0].replace('hello', 'REPLACED')
+
+    app.connect('source-read', source_read_handler)
+    app.build(force_all=True)
+
+    # emitted once when read as a document, and once more per inclusion
+    assert docnames.count('baz/baz') == 2  # index
+    assert docnames.count('baz/inner') == 3  # baz/baz, index (via baz/baz)
+    html = (app.outdir / 'index.html').read_text(encoding='utf8')
+    assert 'REPLACED' in html
+    assert 'inner REPLACED' in html
+    assert 'hello' not in html

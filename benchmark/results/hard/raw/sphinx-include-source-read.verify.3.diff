     def run(self) -> list[Node]:
+        # Docutils reads included files directly, bypassing Sphinx's reader.
+        # Patch this state machine instance's insert_input so that the
+        # 'source-read' event is also emitted for included content.
+        def _insert_input(include_lines: list[str], source: str) -> None:
+            # the last 2 lines are marker lines that must be preserved
+            text = "\n".join(include_lines[:-2])
+            docname = self.env.path2doc(abspath(relpath(source)))

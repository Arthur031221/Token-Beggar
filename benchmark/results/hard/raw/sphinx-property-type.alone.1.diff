@@ -393,6 +393,25 @@ def isproperty(obj: Any) -> bool:
     return isinstance(obj, property)
 
 
+def getclassproperty(cls: Any, name: str) -> Optional[Any]:
+    """Get the property wrapped by classmethod (available since Python 3.9).
+
+    Looks up *name* in the ``__dict__`` of *cls* and its base classes without invoking
+    descriptors.  Returns the wrapped property object if the attribute is a classmethod
+    wrapping a property, otherwise None.
+    """
+    placeholder = object()
+    for basecls in getmro(cls):
+        meth = safe_getattr(basecls, '__dict__', {}).get(name, placeholder)
+        if meth is not placeholder:
+            if isinstance(meth, classmethod) and isproperty(meth.__func__):
+                return meth.__func__
+            else:
+                return None
+
+    return None
+
+

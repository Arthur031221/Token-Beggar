 from io import BufferedReader, BytesIO
 from typing import (
     TYPE_CHECKING,
@@ -253,6 +253,32 @@ def _check_csv(value: list[str] | tuple[str] | str) -> Sequence[str]:
     return _splitstrip(value)
 
 
+def _check_regexp_csv(value: list[str] | tuple[str] | str) -> Iterable[str]:
+    r"""Split a comma-separated string of regexes, ignoring commas inside ``{}``.
+
+    Lists and tuples are returned unchanged. Whitespace is stripped and empty
+    items are dropped, e.g. ``"(foo{1,3}), bar"`` -> ``["(foo{1,3})", "bar"]``.
+    """
+    if isinstance(value, (list, tuple)):
+        yield from value
+    else:
+        current = ""
+        depth = 0
+        for char in value:
+            if char == "{":
+                depth += 1
+            elif char == "}" and depth > 0:
+                depth -= 1
+            if char == "," and depth == 0:
+                if current.strip():
+                    yield current.strip()
+                current = ""
+            else:
+                current += char
+        if current.strip():
+            yield current.strip()
+
+
 def _comment(string: str) -> str:
     """Return string as a comment."""
     lines = [line.strip() for line in string.splitlines()]

+    def write_ns_checks(self, target: nodes.Expr, frame: Frame) -> None:
+        # Namespace checks must be emitted before the assignment line, as
+        # NSRefs may be nested inside a tuple target.
+        refs = list(target.find_all(nodes.NSRef))

 from io import BufferedReader, BytesIO
 from typing import (
     TYPE_CHECKING,
@@ -253,6 +253,33 @@ def _check_csv(value: list[str] | tuple[str] | str) -> Sequence[str]:
     return _splitstrip(value)
 
 
+def _check_regexp_csv(value: list[str] | tuple[str] | str) -> Iterable[str]:
+    r"""Split a comma-separated list of regexps, ignoring commas inside braces.
+
+    Commas inside ``{...}`` (e.g. the quantifier in ``(foo{1,3})``) are kept.
+    """
+    if isinstance(value, (list, tuple)):
+        yield from value
+        return
+    current: list[str] = []
+    depth = 0
+    for char in value:
+        if char == "{":
+            depth += 1
+        elif char == "}" and depth:
+            depth -= 1
+        if char == "," and depth == 0:
+            item = "".join(current).strip()
+            if item:
+                yield item
+            current = []
+        else:
+            current.append(char)
+    item = "".join(current).strip()
+    if item:
+        yield item
+
+
 def _comment(string: str) -> str:
     """Return string as a comment."""
     lines = [line.strip() for line in string.splitlines()]

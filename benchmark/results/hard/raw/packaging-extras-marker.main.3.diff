+    @pytest.mark.parametrize(
+        "marker_string",
+        [
+            '"a" in extras',
+            '"a" not in dependency_groups',
+            'extras == "a"',
+        ],
+    )
+    def test_parses_set_variables(self, marker_string):
+        assert str(Marker(marker_string)) == marker_string
+
+    @pytest.mark.parametrize(
+        ("marker_string", "environment", "expected"),
+        [
+            ('"a" in extras', {"extras": {"a", "b"}}, True),
+            ('"c" in extras', {"extras": {"a", "b"}}, False),
+            ('"a" not in extras', {"extras": {"a", "b"}}, False),
+            ('"c" not in extras', {"extras": {"a", "b"}}, True),
+            ('"Foo_Bar" in extras', {"extras": {"foo-bar"}}, True),
+            ('"foo-bar" in extras', {"extras": {"Foo_Bar"}}, True),
+            ('"Foo_Bar" not in extras', {"extras": {"foo-bar"}}, False),
+            ('"a" in dependency_groups', {"dependency_groups": {"a"}}, True),
+            ('"A_B" in dependency_groups', {"dependency_groups": {"a-b"}}, True),
+            ('"a" not in dependency_groups', {"dependency_groups": {"a"}}, False),
+            ('extra == "a"', {"extra": "A"}, True),
+        ],
+    )
+    def test_evaluate_set_variables(self, marker_string, environment, expected):
+        assert Marker(marker_string).evaluate(environment) is expected
+
+    def test_evaluate_lock_file_context_defaults(self):
+        assert Marker('"a" in extras').evaluate(context="lock_file") is False
+        assert (
+            Marker('"a" not in dependency_groups').evaluate(context="lock_file")
+            is True
+        )
+        assert Marker('"a" in extras').evaluate({"extras": {"a"}}, "lock_file")
+
+    def test_evaluate_metadata_context_has_no_set_defaults(self):
+        with pytest.raises(KeyError):
+            Marker('"a" in extras').evaluate()
+        assert Marker('extra == "a"').evaluate(context="metadata") is False
+
+    def test_evaluate_requirement_context_has_no_defaults(self):
+        with pytest.raises(KeyError):
+            Marker('extra == "x"').evaluate(context="requirement")
+        with pytest.raises(KeyError):
+            Marker('"a" in extras').evaluate(context="requirement")
+        assert Marker('extra == "x"').evaluate({"extra": "x"}, "requirement")
+

         "╰──────────────────────────────────────────╯\n"
     )
     assert render(module, methods=True) == expected
+
+
+def test_inspect_method_with_control_codes_in_docstring():
+    # Control codes (e.g. \r from \r\n line endings) in docstrings used to
+    # raise an IndexError when rendering
+    class Thing:
+        def method(self):
+            """First line.\r\nSecond line with some (parenthesised) 'text' 123."""
+
+    expected = (
+        "│ method = def method(self):                      │\n"
+        "│          First line.                            │\n"
+        "│          Second line with some (parenthesised)  │\n"
+        "│          'text' 123.                            │\n"
+    )
+    assert expected in render(Thing, methods=True, width=51)

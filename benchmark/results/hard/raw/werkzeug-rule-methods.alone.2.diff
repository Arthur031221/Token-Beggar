@@ -914,6 +916,27 @@ class Rule(RuleFactory):
 
     __hash__ = None  # type: ignore
 
+    def _is_duplicate(self, other: Rule) -> bool:
+        """Check if this rule would match the same requests as another rule,
+        such that only one of them would ever be used for a given method.
+
+        In addition to the rules being equal, they must share at least one
+        method. If either rule does not specify ``methods``, it matches all
+        methods, and so shares methods with any other rule.
+
+        This is not part of ``==``, as having overlapping methods is not the
+        same as being equal.
+
+        :internal:
+        """
+        if self != other:
+            return False
+
+        if self.methods is None or other.methods is None:
+            return True
+
+        return not self.methods.isdisjoint(other.methods)
+

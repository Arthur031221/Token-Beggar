diff --git a/tests/test_routing.py b/tests/test_routing.py
index 4f31037c..c6ef2c2d 100644
--- a/tests/test_routing.py
+++ b/tests/test_routing.py
@@ -320,6 +320,94 @@ def test_no_duplicate_different_converters() -> None:
     )
 
 
+def test_no_duplicate_different_methods() -> None:
+    """Rules with no shared methods are not duplicates, and each one matches."""
+    adapter = r.Map(
+        [
+            r.Rule("/", endpoint="get", methods=["GET"]),
+            r.Rule("/", endpoint="post", methods=["POST"]),
+            r.Rule("/", endpoint="put", methods=["PUT", "PATCH"]),
+        ]
+    ).bind("localhost")
+    assert adapter.match("/", method="GET") == ("get", {})
+    assert adapter.match("/", method="POST") == ("post", {})
+    assert adapter.match("/", method="PATCH") == ("put", {})
+
+
+@pytest.mark.parametrize(
+    ("a", "b"),
+    [
+        pytest.param(["GET", "POST"], ["POST"], id="shared"),
+        pytest.param(["GET"], ["HEAD"], id="implicit head"),
+        pytest.param(None, ["POST"], id="all first"),
+        pytest.param(["POST"], None, id="all second"),
+        pytest.param(None, None, id="all both"),
+    ],
+)
+def test_duplicate_methods(a: list[str] | None, b: list[str] | None) -> None:
+    """Rules with any shared method are duplicates. Not specifying methods means
+    all methods are allowed.
+    """
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/", endpoint="a", methods=a),
+                r.Rule("/", endpoint="b", methods=b),
+            ]
+        )
+
+
+def test_duplicate_methods_error_str() -> None:
+    """The error message shows the methods of the existing rule."""
+    with pytest.raises(DuplicateRuleError, match=r"^GET,HEAD,POST / → a$"):
+        r.Map(
+            [
+                r.Rule("/", endpoint="a", methods=["GET", "POST"]),
+                r.Rule("/", endpoint="b", methods=["POST"]),
+            ]
+        )
+
+
+def test_no_duplicate_strict_slashes() -> None:
+    """A leaf and branch are not duplicates even if strict slashes is disabled,
+    as each is still matched by its exact path.
+    """
+    adapter = r.Map(
+        [
+            r.Rule("/a", endpoint="leaf"),
+            r.Rule("/a/", endpoint="branch"),
+        ],
+        strict_slashes=False,
+    ).bind("localhost")
+    assert adapter.match("/a") == ("leaf", {})
+    assert adapter.match("/a/") == ("branch", {})
+
+
+def test_duplicate_merge_slashes() -> None:
+    """Paths are compared after merging slashes."""
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/a/b", endpoint="a"),
+                r.Rule("/a//b", endpoint="b"),
+            ]
+        )
+
+
+def test_no_duplicate_merge_slashes_disabled() -> None:
+    """If a rule disables merging slashes, its path is not merged before
+    comparing, and it matches its exact path.
+    """
+    adapter = r.Map(
+        [
+            r.Rule("/a/b", endpoint="a"),
+            r.Rule("/a//b", endpoint="b", merge_slashes=False),
+        ]
+    ).bind("localhost")
+    assert adapter.match("/a/b") == ("a", {})
+    assert adapter.match("/a//b") == ("b", {})
+
+

+    def _ref_nums(self, html):
+        return re.findall(r'<sup id="[^"]*"><a class="footnote-ref" href="#fn:(\w+)">(\d+)</a></sup>', html)
+
+    def _li_ids(self, html):
+        return re.findall(r'<li id="fn:(\w+)">', html)
+
+    def test_reference_order(self):
+        text = self.dedent(
+            """
+            first[^b] second[^a]
+
+            [^a]: A
+            [^b]: B
+            """
+        )
+        html = markdown.markdown(text, extensions=['footnotes'])
+        self.assertEqual(self._ref_nums(html), [('b', '1'), ('a', '2')])
+        self.assertEqual(self._li_ids(html), ['b', 'a'])
+        self.assertIn('title="Jump back to footnote 1 in the text"', html.split('<li id="fn:b">')[1])
+
+    def test_reference_order_exact(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                foo[^definedsecond] bar[^definedfirst]
+
+                [^definedfirst]: First
+                [^definedsecond]: Second
+                """
+            ),
+            '<p>foo<sup id="fnref:definedsecond"><a class="footnote-ref" href="#fn:definedsecond">1</a></sup> '
+            'bar<sup id="fnref:definedfirst"><a class="footnote-ref" href="#fn:definedfirst">2</a></sup></p>\n'
+            '<div class="footnote">\n'
+            '<hr />\n'
+            '<ol>\n'
+            '<li id="fn:definedsecond">\n'
+            '<p>Second&#160;<a class="footnote-backref" href="#fnref:definedsecond"'
+            ' title="Jump back to footnote 1 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '<li id="fn:definedfirst">\n'
+            '<p>First&#160;<a class="footnote-backref" href="#fnref:definedfirst"'
+            ' title="Jump back to footnote 2 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '</ol>\n'
+            '</div>'
+        )
+
+    def test_duplicate_references(self):

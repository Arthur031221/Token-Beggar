+    def reorder(self, root: etree.Element, ol: etree.Element | None) -> None:
+        """ Renumber references and reorder footnotes by order of first reference. """
+        fn = self.footnotes
+        id_map = {fn.makeFootnoteId(id): id for id in fn.footnotes}
+        refs = [
+            a for sup in root.iter('sup') for a in sup.iter('a')
+            if a.attrib.get('class', '') == 'footnote-ref' and a.attrib.get('href', '')[1:] in id_map
+        ]
+        order = fn.footnote_order
+        order.clear()
+        for a in refs:
+            id = id_map[a.attrib['href'][1:]]
+            if id not in order:
+                order.append(id)
+        # Defined but unreferenced footnotes follow, in definition order.
+        order.extend(id for id in fn.footnotes if id not in order)
+        numbers = {id: index for index, id in enumerate(order, start=1)}
+        template = fn.getConfig("SUPERSCRIPT_TEXT")
+        for a in refs:
+            a.text = template.format(numbers[id_map[a.attrib['href'][1:]]])
+        if ol is None:
+            return
+        backlink_title = fn.getConfig("BACKLINK_TITLE").replace("%d", "{}")
+        items = {}
+        for li in list(ol):
+            items[li.attrib.get('id', '')] = li
+            ol.remove(li)
+        for id in order:
+            li = items.pop(fn.makeFootnoteId(id), None)
+            if li is None:
+                continue
+            ol.append(li)
+            for link in li.iter('a'):
+                if link.attrib.get('class', '') == 'footnote-backref':
+                    link.set('title', backlink_title.format(numbers[id]))
+                    break
+        # Preserve anything unexpected.
+        for li in items.values():
+            ol.append(li)
+

+        )
+
+    @skipUnlessDBFeature("supports_collation_on_charfield")
+    def test_alter_pk_db_collation_propagates_to_fk(self):
+        collation = connection.features.test_collations.get("non_default")
+        if not collation:
+            self.skipTest("Language collations are not supported.")
+
+        def make_models(db_collation):
+            class Parent(Model):
+                id = CharField(
+                    primary_key=True, max_length=22, db_collation=db_collation
+                )
+
+                class Meta:
+                    app_label = "schema"
+                    db_table = "schema_collation_parent"
+
+            class Child(Model):
+                parent = ForeignKey(Parent, CASCADE)
+
+                class Meta:
+                    app_label = "schema"
+                    db_table = "schema_collation_child"
+
+            return Parent, Child
+
+        with isolate_apps("schema"):
+            OldParent, OldChild = make_models(None)
+        with isolate_apps("schema"):
+            NewParent, NewChild = make_models(collation)
+        with connection.schema_editor() as editor:
+            editor.create_model(OldParent)
+            editor.create_model(OldChild)
+        self.isolated_local_models = [NewChild, NewParent]
+        with connection.schema_editor() as editor:
+            editor.alter_field(
+                OldParent,
+                OldParent._meta.get_field("id"),
+                NewParent._meta.get_field("id"),
+                strict=True,
+            )
+        self.assertEqual(
+            self.get_column_collation(NewParent._meta.db_table, "id"), collation
+        )
+        self.assertEqual(
+            self.get_column_collation(NewChild._meta.db_table, "parent_id"), collation
+        )
+

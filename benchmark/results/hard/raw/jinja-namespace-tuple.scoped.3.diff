+    def check_namespace_targets(self, target: nodes.Node, frame: Frame) -> None:
+        """Emit runtime checks that every namespace reference in an
+        assignment target (possibly nested in a tuple) is a namespace.
+        """
+        for ref_node in [target, *target.find_all(nodes.NSRef)]:
+            if not isinstance(ref_node, nodes.NSRef):

 RCFILE = ".pyreverserc"
 
 
@@ -213,3 +215,123 @@ class LocalsVisitor(ASTWalker):
         if methods[1] is not None:
             return methods[1](node)
         return None
+
+
+def _annotated_args(func):
+    """yield (argument, annotation) pairs of a function definition"""
+    args = func.args
+    for arg_list, annotations in (
+        (
+            getattr(args, "posonlyargs", None),
+            getattr(args, "posonlyargs_annotations", None),
+        ),
+        (args.args, args.annotations),
+        (args.kwonlyargs, args.kwonlyargs_annotations),
+    ):
+        yield from zip(arg_list or [], annotations or [])
+
+
+def get_annotation(node):
+    """return the type annotation applying to the assignment target ``node``
+    (an AssignName or AssignAttr), or None
+
+    The annotation comes either from an annotated assignment
+    (``a: str = None``) or from the annotated argument of the enclosing
+    function the target is assigned from (``self.a = a`` in
+    ``def __init__(self, a: str = None)``).
+    """
+    assign = node.parent
+    if isinstance(assign, astroid.AnnAssign):
+        return assign.annotation
+    if not isinstance(assign, astroid.Assign) or not isinstance(
+        assign.value, astroid.Name
+    ):
+        return None
+    func = node.scope()
+    if not isinstance(func, astroid.FunctionDef):
+        return None
+    for arg, annotation in _annotated_args(func):
+        if arg.name == assign.value.name:
+            return annotation
+    return None
+
+
+def _defaults_to_none(annotation):
+    """return True if the variable annotated by ``annotation`` has
+    a None default value"""
+    parent = annotation.parent
+    if isinstance(parent, astroid.AnnAssign):
+        default = parent.value
+    elif isinstance(parent, astroid.Arguments):
+        func = parent.parent
+        try:
+            arg = next(arg for arg, ann in _annotated_args(func) if ann is annotation)
+            default = parent.default_value(arg.name)
+        except (StopIteration, astroid.NoDefault):
+            return False
+    else:
+        return False
+    return isinstance(default, astroid.Const) and default.value is None
+
+
+def get_annotation_label(annotation):
+    """return the label to display for a type annotation node,
+    e.g. ``str`` or ``Optional[str]`` for ``a: str = None``"""
+    if isinstance(annotation, astroid.Const) and isinstance(annotation.value, str):
+        label = annotation.value  # string annotation, e.g. a: "MyClass"
+    else:
+        label = annotation.as_string()
+    if (
+        _defaults_to_none(annotation)
+        and label != "None"
+        and not isinstance(annotation, astroid.BinOp)  # a: int | None = None
+        and not label.startswith(
+            ("Optional[", "typing.Optional[", "Union[", "typing.Union[")
+        )
+    ):
+        label = f"Optional[{label}]"
+    return label
+
+
+def is_annotation(node):
+    """return True if ``node`` is a type annotation node, as returned by
+    ``infer_node`` for non class annotations"""
+    parent = node.parent
+    if isinstance(parent, astroid.AnnAssign):
+        return parent.annotation is node
+    if isinstance(parent, astroid.Arguments) and isinstance(
+        parent.parent, astroid.FunctionDef
+    ):
+        return any(ann is node for _, ann in _annotated_args(parent.parent))
+    return False
+
+
+def infer_node(node):
+    """return the set of possible values (or types) of the assignment
+    target ``node``
+
+    If the target has a type annotation, use it rather than inferring the
+    assigned value: a plain class annotation gives instances of that class,
+    anything else (``Optional[str]``, ``List[str]``, ``str`` with a None
+    default...) gives the annotation node itself, see ``get_annotation_label``.
+    """
+    annotation = get_annotation(node)
+    if annotation is not None:
+        if isinstance(
+            annotation, (astroid.Name, astroid.Attribute)
+        ) and not _defaults_to_none(annotation):
+            try:
+                inferred = set(annotation.infer())
+            except astroid.InferenceError:
+                inferred = set()
+            if inferred and all(
+                isinstance(value, astroid.ClassDef)
+                and not value.qname().startswith("typing.")
+                for value in inferred
+            ):
+                return {value.instantiate_class() for value in inferred}
+        return {annotation}
+    try:
+        return set(node.infer())
+    except astroid.InferenceError:
+        return set()

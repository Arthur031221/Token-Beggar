+def test_annotations_in_class_diagram():
+    module = astroid.parse(
+        """
+    from typing import Optional
+
+    class Other:
+        pass
+
+    class C(object):
+        cls_attr: int = 0
+
+        def __init__(self, a: str = None, b: Optional[int] = None, c: Other = Other(), d=1):
+            self.a = a
+            self.b = b
+            self.c = c
+            self.d = d
+
+        def meth(self, x: int, y):
+            pass
+    """,
+        module_name="mod",
+    )
+    project = Project("p")
+    project.add_module(module)
+    Linker(project).visit(project)
+    diagram = ClassDiagram("classes", "ALL")
+    diagram.add_object("C", module["C"])
+    diagram.add_object("Other", module["Other"])
+    diagram.extract_relationships()
+    c_obj = diagram.object_from_node(module["C"])
+    assert c_obj.attrs == [
+        "a : Optional[str]",
+        "b : Optional[int]",
+        "c",  # displayed as an association to Other
+        "cls_attr : int",
+        "d : int",
+    ]
+    (association,) = diagram.relationships["association"]
+    assert association.from_object.title == "Other"
+    assert association.name == "c"
+    label = DotWriter(Config()).get_values(c_obj)["label"]
+    assert r"meth(x: int, y)\l" in label

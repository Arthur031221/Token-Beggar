+class FootnoteReorderingProcessor(Treeprocessor):
+    """ Number and sort footnotes by the order in which they are first referenced. """
+
+    def __init__(self, footnotes: FootnoteExtension):
+        self.footnotes = footnotes
+
+    def iter_refs(self, element: etree.Element, fn_ids: dict[str, str]) -> Iterator[str]:
+        """ Yield ids of footnotes referenced in `element` in document order, skipping the footnote div. """
+        stack = [iter(element)]
+        while stack:
+            child = next(stack[-1], None)
+            if child is None:
+                stack.pop()
+                continue
+            if child is self.footnotes.footnotes_div:
+                continue
+            if child.tag == 'a' and child.get('class') == 'footnote-ref':
+                href = child.get('href', '')
+                if href.startswith('#') and href[1:] in fn_ids:
+                    yield fn_ids[href[1:]]
+            stack.append(iter(child))
+
+    def get_order(self, root: etree.Element, items: dict[str, etree.Element]) -> list[str]:
+        """ Return footnote ids in the order they are first referenced. """
+        fn_ids = {self.footnotes.makeFootnoteId(id): id for id in self.footnotes.footnotes}
+        order: list[str] = []
+
+        def collect(element: etree.Element) -> None:
+            for id in self.iter_refs(element, fn_ids):
+                if id not in order:
+                    order.append(id)
+
+        collect(root)
+        # Footnotes referenced from within other footnotes follow those referenced from the
+        # body. Unreferenced footnotes are placed last in the order of their definition.
+        unreferenced = iter(self.footnotes.footnotes)
+        index = 0
+        while True:
+            if index == len(order):
+                id = next((id for id in unreferenced if id not in order), None)
+                if id is None:
+                    break
+                order.append(id)
+            li = items.get(order[index])
+            if li is not None:
+                collect(li)
+            index += 1
+        return order
+
+    def run(self, root: etree.Element) -> None:
+        keys = list(self.footnotes.footnotes.keys())
+        self.footnotes.footnote_numbers = {index: index + 1 for index in range(len(keys))}
+        div = self.footnotes.footnotes_div
+        if self.footnotes.getConfig("USE_DEFINITION_ORDER") or div is None:
+            return
+        ol = div.find('ol')
+        if ol is None:
+            return
+        li_ids = {self.footnotes.makeFootnoteId(id): id for id in keys}
+        items = {li_ids[li.get('id', '')]: li for li in ol if li.get('id', '') in li_ids}
+        order = self.get_order(root, items)
+        positions = {id: index for index, id in enumerate(keys)}
+        self.footnotes.footnote_numbers = {positions[id]: number for number, id in enumerate(order, start=1)}
+
+        # Sort the list items and update the backlink titles to match the new numbers.
+        others = [li for li in ol if li.get('id', '') not in li_ids]
+        ol[:] = [items[id] for id in order if id in items] + others
+        backlink_title = self.footnotes.getConfig("BACKLINK_TITLE").replace("%d", "{}")
+        for index, li in enumerate(ol, start=1):
+            for link in li.iter('a'):
+                if link.get('class') == 'footnote-backref':
+                    link.set('title', backlink_title.format(index))
+

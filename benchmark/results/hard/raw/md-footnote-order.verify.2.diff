+    def reorder(self, root: etree.Element) -> None:
+        """ Number and list footnotes in the order of their first reference. """
+        sep = self.footnotes.get_separator()
+        footnote_div = None
+        ol = None
+        for div in root.iter('div'):
+            if div.attrib.get('class', '') == 'footnote':
+                footnote_div = div
+                ol = next(div.iter('ol'), None)
+                break
+        if ol is None:
+            return
+
+        lis = {li.attrib.get('id', ''): li for li in ol}
+        id_map = {self.footnotes.makeFootnoteId(id): id for id in self.footnotes.footnotes}
+
+        def find_refs(element, skip=None):
+            # Collect refs in true document order.
+            refs = []
+            for el in element.iter('sup'):
+                a = el.find('a')
+                if (
+                    a is not None and a.attrib.get('class', '') == 'footnote-ref' and
+                    a.attrib.get('href', '')[1:] in id_map
+                ):
+                    refs.append(el)
+            if skip is not None:
+                inside = set(skip.iter('sup'))
+                refs = [r for r in refs if r not in inside]
+            return refs
+
+        # Refs in the main document (outside the footnote div) first, then
+        # refs found in the content of footnotes already placed, in order.
+        order: list[str] = []
+        all_refs: list[etree.Element] = []
+
+        def note(refs):
+            for sup in refs:
+                id = id_map[sup.find('a').attrib['href'][1:]]
+                all_refs.append(sup)
+                if id not in order:
+                    order.append(id)
+
+        note(find_refs(root, skip=footnote_div))
+        pos = 0
+        while pos < len(self.footnotes.footnotes):
+            if pos == len(order):
+                # Unreferenced footnotes follow in definition order. Their
+                # content is scanned as well so any refs in it are renumbered.
+                order.append(next(id for id in self.footnotes.footnotes if id not in order))
+            li = lis.get(self.footnotes.makeFootnoteId(order[pos]))
+            if li is not None:
+                note(find_refs(li))
+            pos += 1
+
+        self.footnotes.footnotes = OrderedDict((id, self.footnotes.footnotes[id]) for id in order)
+
+        # Renumber refs and make `fnref` ids follow document order.
+        seen: dict[str, int] = {}
+        numbers = {id: i for i, id in enumerate(order, start=1)}
+        for sup in all_refs:
+            a = sup.find('a')
+            id = id_map[a.attrib['href'][1:]]
+            a.text = self.footnotes.getConfig("SUPERSCRIPT_TEXT").format(numbers[id])
+            seen[id] = seen.get(id, 0) + 1
+            ref = self.footnotes.makeFootnoteRefId(id)
+            if seen[id] > 1:
+                head, rest = ref.split(sep, 1)
+                ref = '%s%d%s%s' % (head, seen[id], sep, rest)
+            sup.set('id', ref)
+
+        # Reorder the list items and fix the backlink titles.
+        backlink_title = self.footnotes.getConfig("BACKLINK_TITLE").replace("%d", "{}")
+        items = [lis[self.footnotes.makeFootnoteId(id)] for id in order if self.footnotes.makeFootnoteId(id) in lis]
+        for li in list(ol):
+            ol.remove(li)
+        for index, li in enumerate(items, start=1):
+            ol.append(li)
+            for link in li.iter('a'):
+                if link.attrib.get('class', '') == 'footnote-backref':
+                    link.set('title', backlink_title.format(index))
+

@@ -336,3 +336,102 @@ class TestFootnotes(TestCase):
             '</div>',
             extension_configs={'footnotes': {'SUPERSCRIPT_TEXT': '[{}]'}}
         )
+
+    def test_reference_order(self):
+        """Test footnotes are numbered in order of reference."""
+
+        text = 'A[^second] B[^first].\n\n[^first]: blah\n[^second]: blurb'
+        expected = (
+            '<p>A<sup id="fnref:second"><a class="footnote-ref" href="#fn:second">1</a></sup> '
+            'B<sup id="fnref:first"><a class="footnote-ref" href="#fn:first">2</a></sup>.</p>\n'
+            '<div class="footnote">\n'
+            '<hr />\n'
+            '<ol>\n'
+            '<li id="fn:second">\n'
+            '<p>blurb&#160;<a class="footnote-backref" href="#fnref:second"'
+            ' title="Jump back to footnote 1 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '<li id="fn:first">\n'
+            '<p>blah&#160;<a class="footnote-backref" href="#fnref:first"'
+            ' title="Jump back to footnote 2 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '</ol>\n'
+            '</div>'
+        )
+        self.assertMarkdownRenders(text, expected)
+
+    def test_definition_order(self):
+        """Test `USE_DEFINITION_ORDER` restores definition order."""
+
+        text = 'A[^second] B[^first].\n\n[^first]: blah\n[^second]: blurb'
+        expected = (
+            '<p>A<sup id="fnref:second"><a class="footnote-ref" href="#fn:second">2</a></sup> '
+            'B<sup id="fnref:first"><a class="footnote-ref" href="#fn:first">1</a></sup>.</p>\n'
+            '<div class="footnote">\n'
+            '<hr />\n'
+            '<ol>\n'
+            '<li id="fn:first">\n'
+            '<p>blah&#160;<a class="footnote-backref" href="#fnref:first"'
+            ' title="Jump back to footnote 1 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '<li id="fn:second">\n'
+            '<p>blurb&#160;<a class="footnote-backref" href="#fnref:second"'
+            ' title="Jump back to footnote 2 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '</ol>\n'
+            '</div>'
+        )
+        self.assertMarkdownRenders(
+            text, expected, extension_configs={'footnotes': {'USE_DEFINITION_ORDER': True}}
+        )
+
+    def test_nested_reference_order(self):
+        """Test a ref nested in a list item precedes a later paragraph ref."""
+
+        text = '* item[^b]\n\npara[^a]\n\n[^a]: A\n[^b]: B'
+        import markdown
+        out = markdown.markdown(text, extensions=['footnotes'])
+        self.assertIn('href="#fn:b">1</a>', out)
+        self.assertIn('href="#fn:a">2</a>', out)
+        self.assertLess(out.index('<li id="fn:b">'), out.index('<li id="fn:a">'))
+
+    def test_duplicate_refs_reference_order(self):
+        """Test duplicate refs and ids follow document order."""
+
+        text = 'x[^a] y[^b] z[^a]\n\n[^a]: A\n[^b]: B'
+        import markdown
+        out = markdown.markdown(text, extensions=['footnotes'])
+        self.assertIn('<sup id="fnref:a"><a class="footnote-ref" href="#fn:a">1</a></sup>', out)
+        self.assertIn('<sup id="fnref2:a"><a class="footnote-ref" href="#fn:a">1</a></sup>', out)
+        self.assertIn('href="#fnref2:a"', out)
+        self.assertIn('href="#fn:b">2</a>', out)
+
+    def test_unreferenced_footnote(self):
+        """Test unreferenced footnotes are not listed before referenced ones."""
+
+        text = 'x[^b]\n\n[^a]: A\n[^b]: B'
+        import markdown
+        out = markdown.markdown(text, extensions=['footnotes'])
+        self.assertIn('href="#fn:b">1</a>', out)
+        self.assertLess(out.index('<li id="fn:b">'), out.index('<li id="fn:a">'))
+
+    def test_ref_in_unreferenced_footnote(self):
+        """Test refs inside unreferenced footnotes are renumbered."""
+
+        text = 'x[^c]\n\n[^b]: B\n[^a]: A see[^b]\n[^c]: C'
+        import markdown
+        out = markdown.markdown(text, extensions=['footnotes'])
+        self.assertIn('href="#fn:c">1</a>', out)
+        self.assertIn('href="#fn:b">2</a>', out)
+        self.assertLess(out.index('<li id="fn:c">'), out.index('<li id="fn:b">'))
+        self.assertLess(out.index('<li id="fn:b">'), out.index('<li id="fn:a">'))
+
+    def test_reset_reuse(self):
+        """Test the same instance converts multiple documents."""
+
+        import markdown
+        md = markdown.Markdown(extensions=['footnotes'])
+        text = 'x[^b] y[^a]\n\n[^a]: A\n[^b]: B'
+        first = md.convert(text)
+        md.reset()
+        self.assertEqual(first, md.convert(text))

+def test_type_annotations_in_class_diagram():
+    """PEP 484 annotations are used for the attributes types"""
+    module = astroid.parse(
+        """
+        from typing import List, Optional
+
+        class Other:
+            pass
+
+        class C(object):
+            x: int = 0
+
+            def __init__(
+                self,
+                a: str = None,
+                b: Other = None,
+                c: List[Other] = (),
+                d: Optional[int] = None,
+                e=None,
+            ):
+                self.a = a
+                self.b = b
+                self.c = c
+                self.d = d
+                self.e = e
+                self.f: Other = Other()
+        """
+    )
+    linker = Linker(None)
+    linker.visit(module)
+    diagram = ClassDiagram("test", "ALL")
+    for klass in ("C", "Other"):
+        diagram.add_object(klass, module[klass])
+    diagram.extract_relationships()
+    assert diagram.object_from_node(module["C"]).attrs == [
+        "a : Optional[str]",
+        "b : Optional[Other]",
+        "c : List[Other]",
+        "d : Optional[int]",
+        "e : NoneType",
+        # plain annotation of a class of the diagram: shown as an association
+        "f",
+        "x : int",
+    ]
+    associations = sorted(
+        (rel.from_object.title, rel.to_object.title, rel.name)
+        for rel in diagram.relationships["association"]
+    )
+    assert associations == [
+        ("Other", "C", "b"),
+        ("Other", "C", "c"),
+        ("Other", "C", "f"),
+    ]

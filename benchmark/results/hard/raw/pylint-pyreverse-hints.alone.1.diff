+def test_annotations_resolution():
+    """PEP 484 annotations take precedence over inferred values"""
+    klass = astroid.extract_node(
+        """
+        class MyClass:
+            cls_attr: int = 0
+            other = 1
+
+            def __init__(self, a: str = None, b=None):
+                self.a = a
+                self.b = b
+                self.c: float = 1
+        """
+    )
+    linker = inspector.Linker(None)
+    linker.visit_classdef(klass)
+    for assignname in klass.nodes_of_class(astroid.AssignName):
+        linker.visit_assignname(assignname)
+
+    def as_strings(values):
+        return [value.as_string() for value in values]
+
+    assert as_strings(klass.locals_type["cls_attr"]) == ["int"]
+    assert [v.value for v in klass.locals_type["other"]] == [1]
+    attrs = klass.instance_attrs_type
+    assert as_strings(attrs["a"]) == ["str"]
+    assert as_strings(attrs["c"]) == ["float"]
+    # without annotation, inferred values are kept
+    assert None in [getattr(v, "value", v) for v in attrs["b"]]

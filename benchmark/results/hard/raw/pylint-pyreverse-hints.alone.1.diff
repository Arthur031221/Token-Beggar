diff --git a/pylint/pyreverse/utils.py b/pylint/pyreverse/utils.py
index a24d227e..aeeb3fe9 100644
--- a/pylint/pyreverse/utils.py
+++ b/pylint/pyreverse/utils.py
@@ -20,6 +20,8 @@ import os
 import re
 import sys
 
+import astroid
+
 RCFILE = ".pyreverserc"
 
 
@@ -93,6 +95,132 @@ def is_exception(node):
     return node.type == "exception"
 
 
+def _annotated_arguments(arguments):
+    """yield (argument, annotation) pairs for an Arguments node"""
+    for names, annotations in (
+        (arguments.posonlyargs, arguments.posonlyargs_annotations),
+        (arguments.args, arguments.annotations),
+        (arguments.kwonlyargs, arguments.kwonlyargs_annotations),
+    ):
+        yield from zip(names or (), annotations or ())
+
+
+def get_annotation(node):
+    """return the PEP 484 annotation for the assignment target `node`
+    (an AssignName or AssignAttr), or None if there is none.
+
+    The annotation is either given by an annotated assignment
+    (``x: int = 0`` / ``self.x: int = 0``) or, for a plain assignment
+    of a function argument (``self.x = x``), by the argument's annotation.
+    """
+    parent = node.parent
+    if isinstance(parent, astroid.AnnAssign) and parent.target is node:
+        return parent.annotation
+    if (
+        isinstance(parent, astroid.Assign)
+        and node in parent.targets
+        and isinstance(parent.value, astroid.Name)
+    ):
+        _, assignments = parent.value.lookup(parent.value.name)
+        if len(assignments) == 1 and isinstance(
+            assignments[0].parent, astroid.Arguments
+        ):
+            arg = assignments[0]
+            for name, annotation in _annotated_arguments(arg.parent):
+                if name is arg:
+                    return annotation
+    return None
+
+
+def is_annotation(node):
+    """return true if `node` is a type annotation (as returned by
+    `get_annotation`) rather than an inferred value
+    """
+    parent = node.parent
+    if isinstance(parent, astroid.AnnAssign):
+        return parent.annotation is node
+    if isinstance(parent, astroid.Arguments):
+        return any(
+            annotation is node for _, annotation in _annotated_arguments(parent)
+        )
+    return False
+
+
+def _annotation_default(annotation):
+    """return the default value associated with an annotation, or None if
+    there is no default value
+    """
+    parent = annotation.parent
+    if isinstance(parent, astroid.AnnAssign):
+        return parent.value
+    if isinstance(parent, astroid.Arguments):
+        for name, ann in _annotated_arguments(parent):
+            if ann is annotation:
+                try:
+                    return parent.default_value(name.name)
+                except astroid.NoDefault:
+                    return None
+    return None
+
+
+_NONE_IN_ANNOTATION = re.compile(r"\bNone\b|^Optional\[|\.Optional\[")
+
+
+def get_annotation_label(annotation):
+    """return the label to display for a type annotation
+
+    If the default value is None and the annotation does not already
+    accept None, the label is wrapped in ``Optional[...]``.
+    """
+    if isinstance(annotation, astroid.Const) and isinstance(annotation.value, str):
+        # string annotation (forward reference)
+        label = annotation.value
+    else:
+        label = annotation.as_string()
+    default = _annotation_default(annotation)
+    if (
+        isinstance(default, astroid.Const)
+        and default.value is None
+        and not _NONE_IN_ANNOTATION.search(label)
+    ):
+        label = f"Optional[{label}]"
+    return label
+
+
+def infer_annotation_classes(annotation):
+    """yield the classes referenced by a type annotation
+
+    For subscripted generics such as ``List[Foo]`` or ``Optional[Foo]``, only
+    the parameters (``Foo``) are considered, not the generic itself.
+    """
+    if isinstance(annotation, astroid.Subscript):
+        yield from infer_annotation_classes(annotation.slice)
+    elif isinstance(annotation, (astroid.Tuple, astroid.List)):
+        for elt in annotation.elts:
+            yield from infer_annotation_classes(elt)
+    elif isinstance(annotation, astroid.BinOp) and annotation.op == "|":
+        yield from infer_annotation_classes(annotation.left)
+        yield from infer_annotation_classes(annotation.right)
+    elif isinstance(annotation, (astroid.Name, astroid.Attribute)):
+        try:
+            for inferred in annotation.infer():
+                if isinstance(inferred, astroid.ClassDef):
+                    yield inferred
+        except astroid.InferenceError:
+            pass
+
+
+def resolve_annotations(values):
+    """yield the given types, replacing type annotations by the classes
+    they reference
+    """
+    for value in values:
+        if is_annotation(value):
+            yield from infer_annotation_classes(value)
+        else:
+            yield value
+
+

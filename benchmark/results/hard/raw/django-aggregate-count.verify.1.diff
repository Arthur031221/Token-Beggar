--- a/tests/aggregation/tests.py
+++ b/tests/aggregation/tests.py
@@ -34,6 +34,7 @@ from django.db.models.functions import (
     Cast,
     Coalesce,
     Greatest,
+    Length,
     Now,
     Pi,
     TruncDate,
@@ -2084,3 +2085,55 @@ class AggregateTestCase(TestCase):
             exists=Exists(Author.objects.extra(where=["1=0"])),
         )
         self.assertEqual(len(qs), 6)
+
+    def test_unused_annotation_pruned_on_count(self):
+        with CaptureQueriesContext(connection) as ctx:
+            count = Book.objects.annotate(
+                name_len=Length("name"), double=F("pages") * 2
+            ).count()
+        self.assertEqual(count, Book.objects.count())
+        sql = ctx[0]["sql"].lower()
+        self.assertEqual(sql.count("select"), 1)
+        self.assertNotIn("length", sql)
+        self.assertNotIn("pages", sql)
+
+    def test_referenced_annotation_still_used(self):
+        qs = Book.objects.annotate(double=F("pages") * 2)
+        with CaptureQueriesContext(connection) as ctx:
+            result = qs.aggregate(total=Sum("double"))
+        self.assertEqual(
+            result["total"], Book.objects.aggregate(t=Sum("pages"))["t"] * 2
+        )
+        self.assertEqual(ctx[0]["sql"].lower().count("select"), 1)
+
+    def test_aggregate_over_subquery_annotation(self):
+        qs = Publisher.objects.annotate(
+            latest_pages=Subquery(
+                Book.objects.filter(publisher=OuterRef("pk"))
+                .order_by("-pubdate")
+                .values("pages")[:1]
+            )
+        )
+        expected = sum(p.latest_pages or 0 for p in qs)
+        self.assertEqual(
+            qs.aggregate(Sum("latest_pages"))["latest_pages__sum"], expected
+        )
+
+    def test_unreferenced_aggregate_annotation_pruned(self):
+        with CaptureQueriesContext(connection) as ctx:
+            count = Book.objects.annotate(authors_count=Count("authors")).count()
+        self.assertEqual(count, Book.objects.count())
+        sql = ctx[0]["sql"].lower()
+        self.assertEqual(sql.count("select"), 2, "Subquery wrapping required")
+        self.assertNotIn("authors_count", sql)
+
+    def test_referenced_aggregate_annotation_kept(self):
+        with CaptureQueriesContext(connection) as ctx:
+            Book.objects.annotate(
+                authors_count=Count("authors"),
+                contacts_count=Count("contact"),
+            ).aggregate(Avg("authors_count"))
+        sql = ctx[0]["sql"].lower()
+        self.assertEqual(sql.count("select"), 2, "Subquery wrapping required")
+        self.assertEqual(sql.count("authors_count"), 2)
+        self.assertNotIn("contacts_count", sql)

+
+
+def test_inspect_methods_docstring_control_codes():
+    class Thing:
+        def method(self):
+            """Docstring with ``\x08`` control code.
+
+            More text here.
+            """
+
+    console = Console(width=100, file=io.StringIO(), color_system=None)
+    inspect(Thing, console=console, all=True)
+    inspect(Thing, console=console, methods=True, help=True)
+    assert "control code" in console.file.getvalue()
diff --git a/tests/test_text.py b/tests/test_text.py
index 4f02fd4..3327185 100644
--- a/tests/test_text.py
+++ b/tests/test_text.py
@@ -747,3 +747,13 @@ def test_markup_property():
         == "[bold]foo [italic]bar[/bold] baz[/italic]"
     )
     assert Text("[bold]foo").markup == "\\[bold]foo"
+
+
+def test_text_init_control_codes_length():
+    text = Text("foo\x08bar")
+    assert text.plain == "foobar"
+    assert len(text) == 6
+    text.append(Text("baz", "bold"))
+    assert text.spans[-1] == Span(6, 9, "bold")
+    assert len(text.split("\n")) == 1
+    assert [t.plain for t in text.divide([3])] == ["foo", "barbaz"]

+    ) -> None:
+        """``a.b`` assignment targets are parsed as NSRefs and are only
+        valid on Namespace objects. Emit that check before the assignment
+        statement, as the ref may be an item of a tuple target.
+        """
+        if isinstance(node.target, nodes.NSRef):

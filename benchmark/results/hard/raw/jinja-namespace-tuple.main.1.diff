+    def test_namespace_set_tuple(self, env_trim):
+        tmpl = env_trim.from_string(
+            "{% set ns = namespace(a=12, b=36) %}"
+            "{% set ns.a, ns.b = ns.a + 1, ns.b + 1 %}"
+            "{{ ns.a }}|{{ ns.b }}"
+        )
+        assert tmpl.render() == "13|37"
+
+    def test_namespace_set_tuple_swap(self, env_trim):
+        tmpl = env_trim.from_string(
+            "{% set ns = namespace(a=1, b=2) %}"
+            "{% set ns.a, ns.b = ns.b, ns.a %}"
+            "{{ ns.a }}|{{ ns.b }}"
+        )
+        assert tmpl.render() == "2|1"
+
+    def test_namespace_set_tuple_mixed(self, env_trim):
+        tmpl = env_trim.from_string(
+            "{% set ns = namespace(id='', prev_id='') %}"
+            "{% for x in ['a', 'b'] %}"
+            "{% set prev, ns.prev_id, ns.id = ns.id, ns.id, ns.id ~ '/' ~ x %}"
+            "{% endfor %}"
+            "{{ ns.prev_id }}|{{ ns.id }}"
+        )
+        assert tmpl.render() == "/a|/a/b"
+
+    def test_namespace_set_tuple_multiple_namespaces(self, env_trim):
+        tmpl = env_trim.from_string(
+            "{% set ns1 = namespace() %}{% set ns2 = namespace() %}"
+            "{% set ns1.a, ns2.a, other = 1, 2, 3 %}"
+            "{{ ns1.a }}|{{ ns2.a }}|{{ other }}"
+        )
+        assert tmpl.render() == "1|2|3"
+
+    def test_namespace_set_tuple_non_namespace(self, env_trim):
+        tmpl = env_trim.from_string(
+            "{% set ns = namespace() %}{% set ns.a, foo.b = 1, 2 %}"
+        )
+        exc_info = pytest.raises(TemplateRuntimeError, tmpl.render, foo={})
+        assert "non-namespace object" in exc_info.value.message

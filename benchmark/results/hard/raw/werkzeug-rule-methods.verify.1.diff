+def test_no_duplicates_disjoint_methods() -> None:
+    """Rules with the same path but no shared methods are not duplicates."""
+    r.Map(
+        [
+            r.Rule("/", endpoint="a", methods=["GET"]),
+            r.Rule("/", endpoint="b", methods=["POST"]),
+        ]
+    )
+
+
+@pytest.mark.parametrize(
+    ("a", "b"),
+    [
+        (["GET", "POST"], ["POST"]),
+        (None, ["POST"]),
+        (["POST"], None),
+        (["GET"], ["HEAD"]),
+    ],
+)
+def test_duplicate_overlapping_methods(a, b) -> None:
+    """Rules that share any method are duplicates. No methods means all methods,
+    and ``GET`` implies ``HEAD``.
+    """
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/", endpoint="a", methods=a),
+                r.Rule("/", endpoint="b", methods=b),
+            ]
+        )
+
+
+def test_duplicate_merge_slashes() -> None:
+    """If merge_slashes is enabled, paths are compared after merging."""
+    with pytest.raises(DuplicateRuleError):
+        r.Map([r.Rule("/a//b", endpoint="a"), r.Rule("/a/b", endpoint="b")])
+
+
+def test_duplicate_strict_slashes_ignored() -> None:
+    """strict_slashes does not affect equality."""
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/a/", endpoint="a", strict_slashes=True),
+                r.Rule("/a/", endpoint="b", strict_slashes=False),
+            ]
+        )
+
+
+def test_no_duplicates_trailing_slash() -> None:
+    """A branch and a leaf with the same path are not duplicates."""
+    r.Map([r.Rule("/a", endpoint="a"), r.Rule("/a/", endpoint="b")])
+
+
+def test_no_duplicates_merge_slashes_disabled() -> None:
+    """If merge_slashes is disabled, repeated slashes are part of the path."""
+    r.Map(
+        [r.Rule("/a//b", endpoint="a"), r.Rule("/a/b", endpoint="b")],
+        merge_slashes=False,
+    )
+
+

diff --git a/src/werkzeug/routing/rules.py b/src/werkzeug/routing/rules.py
index 18cfba1b..16951002 100644
--- a/src/werkzeug/routing/rules.py
+++ b/src/werkzeug/routing/rules.py
@@ -914,6 +914,16 @@ class Rule(RuleFactory):
 
     __hash__ = None  # type: ignore
 
+    def _is_duplicate(self, other: Rule) -> bool:
+        """Whether this rule is equal to the other and their methods overlap.
+        A rule with no ``methods`` allows all methods, so it overlaps any rule.
+        """
+        return self == other and (
+            self.methods is None
+            or other.methods is None
+            or not self.methods.isdisjoint(other.methods)
+        )
+
     def __str__(self) -> str:
         out = self.rule
 

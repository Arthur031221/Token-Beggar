+        return self._trace == other._trace
 
     __hash__ = None  # type: ignore
 
+    def _is_duplicate(self, other: Rule) -> bool:
+        """Check if this rule would match the same requests as another rule,
+        which would make the rule added later unreachable.
+
+        Rules are duplicates if they have the same parts, which accounts for
+        subdomain or host, ``merge_slashes``, and converter types; have the
+        same websocket mode; and share at least one method. A rule without
+        ``methods`` matches any method, so it shares methods with every rule.
+
+        ``strict_slashes`` is not considered. It only affects how a request
+        path without a trailing slash is handled, and two otherwise duplicate
+        rules would still both match the path with the trailing slash.
+
+        :internal:
+        """
+        if self._parts != other._parts or self.websocket != other.websocket:
+            return False
+
+        if self.methods is None or other.methods is None:
+            return True
+
+        return not self.methods.isdisjoint(other.methods)
+

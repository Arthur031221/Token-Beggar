+def test_no_duplicate_different_methods() -> None:
+    """Rules with disjoint methods are not duplicates."""
+    m = r.Map(
+        [
+            r.Rule("/", endpoint="get", methods=["GET"]),
+            r.Rule("/", endpoint="post", methods=["POST"]),
+            r.Rule("/", endpoint="put", methods=["PUT", "PATCH"]),
+        ]
+    )
+    adapter = m.bind("localhost")
+    assert adapter.match("/", method="GET") == ("get", {})
+    assert adapter.match("/", method="POST") == ("post", {})
+    assert adapter.match("/", method="PATCH") == ("put", {})
+
+
+@pytest.mark.parametrize(
+    ("first", "second"),
+    [
+        pytest.param(["GET"], ["GET"], id="equal"),
+        pytest.param(["GET", "POST"], ["POST", "PUT"], id="intersect"),
+        pytest.param(["GET"], ["HEAD"], id="implicit head"),
+        pytest.param(None, ["POST"], id="any first"),
+        pytest.param(["POST"], None, id="any second"),
+        pytest.param(None, None, id="any both"),
+    ],
+)
+def test_duplicate_methods(first: list[str] | None, second: list[str] | None) -> None:
+    """Rules that share any method are duplicates. A rule without methods
+    matches any method.
+    """
+    with pytest.raises(DuplicateRuleError) as exc_info:
+        r.Map(
+            [
+                r.Rule("/", endpoint="a", methods=first),
+                r.Rule("/", endpoint="b", methods=second),
+            ]
+        )
+
+    assert exc_info.value.existing.endpoint == "a"
+    assert exc_info.value.duplicate.endpoint == "b"
+
+
+def test_duplicate_message_methods() -> None:
+    """The error message shows the existing rule's methods."""
+    with pytest.raises(DuplicateRuleError) as exc_info:
+        r.Map(
+            [
+                r.Rule("/", endpoint="a", methods=["GET", "POST"]),
+                r.Rule("/", endpoint="b", methods=["POST"]),
+            ]
+        )
+
+    assert str(exc_info.value) == "GET,HEAD,POST / → a"
+
+
+def test_duplicate_merge_slashes() -> None:
+    """If merge_slashes is enabled, a rule's path is compared after merging."""
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/a/b", endpoint="a"),
+                r.Rule("/a//b", endpoint="b"),
+            ]
+        )
+
+
+def test_no_duplicate_merge_slashes_disabled() -> None:
+    """If merge_slashes is disabled, repeated slashes are a different path."""
+    m = r.Map(
+        [
+            r.Rule("/a/b", endpoint="a"),
+            r.Rule("/a//b", endpoint="b", merge_slashes=False),
+        ]
+    )
+    adapter = m.bind("localhost")
+    assert adapter.match("/a/b") == ("a", {})
+    assert adapter.match("/a//b") == ("b", {})
+
+
+def test_duplicate_strict_slashes() -> None:
+    """strict_slashes doesn't prevent rules with the same path from being
+    duplicates.
+    """
+    with pytest.raises(DuplicateRuleError):
+        r.Map(
+            [
+                r.Rule("/a/", endpoint="a"),
+                r.Rule("/a/", endpoint="b", strict_slashes=False),
+            ]
+        )
+
+
+def test_no_duplicate_branch_leaf() -> None:
+    """A branch and leaf with the same path are not duplicates, regardless of
+    strict_slashes.
+    """
+    m = r.Map(
+        [
+            r.Rule("/a/", endpoint="branch", strict_slashes=False),
+            r.Rule("/a", endpoint="leaf"),
+        ]
+    )
+    adapter = m.bind("localhost")
+    assert adapter.match("/a/") == ("branch", {})
+    assert adapter.match("/a") == ("leaf", {})
+
+
+def test_rule_eq_not_duplicate() -> None:
+    """Rule equality is separate from duplicate detection. Equality ignores
+    methods, but compares variable names.
+    """
+    r.Map(
+        [
+            a := r.Rule("/<a>", endpoint="a", methods=["GET"]),
+            b := r.Rule("/<a>", endpoint="b", methods=["POST"]),
+            c := r.Rule("/x/<b>", endpoint="c", methods=["GET"]),
+            d := r.Rule("/x/<c>", endpoint="d", methods=["POST"]),
+        ]
+    )
+    assert a == b
+    assert c != d
+
+

+class PrefetchLimitTests(TestCase):
+    @classmethod
+    def setUpTestData(cls):
+        cls.fk_book1 = Book.objects.create(title="FK1")
+        cls.fk_book2 = Book.objects.create(title="FK2")
+        for name in "abcde":
+            Author.objects.create(name=f"fk-{name}", first_book=cls.fk_book1)
+        for name in "xyz":
+            Author.objects.create(name=f"fk-{name}", first_book=cls.fk_book2)
+        cls.authors = [
+            Author.objects.create(name=f"m2m-{i}", first_book=cls.fk_book2)
+            for i in range(5)
+        ]
+        cls.m2m_books = [Book.objects.create(title=f"m2m-{i}") for i in range(2)]
+        for book in cls.m2m_books:
+            book.authors.set(cls.authors)
+        cls.bookmarks = [
+            Bookmark.objects.create(url=f"http://{i}.test") for i in range(2)
+        ]
+        for bookmark in cls.bookmarks:
+            for tag in "abcde":
+                TaggedItem.objects.create(tag=tag, content_object=bookmark)
+
+
+@skipUnlessDBFeature("supports_over_clause")
+class PrefetchLimitSupportedTests(PrefetchLimitTests):
+    def test_reverse_foreign_key(self):
+        for slice_ in [slice(None, 3), slice(1, 3), slice(3, None)]:
+            with self.subTest(slice=slice_):
+                qs = Author.objects.filter(name__startswith="fk-").order_by("name")
+                books = Book.objects.filter(
+                    pk__in=[self.fk_book1.pk, self.fk_book2.pk]
+                ).prefetch_related(
+                    Prefetch("first_time_authors", qs[slice_], to_attr="limited")
+                )
+                with self.assertNumQueries(2):
+                    result = {b.title: b for b in books}
+                self.assertEqual(
+                    [a.name for a in result["FK1"].limited],
+                    ["fk-a", "fk-b", "fk-c", "fk-d", "fk-e"][slice_],
+                )
+                self.assertEqual(
+                    [a.name for a in result["FK2"].limited],
+                    ["fk-x", "fk-y", "fk-z"][slice_],
+                )
+
+    def test_reverse_foreign_key_ordering_desc(self):
+        qs = Author.objects.order_by("-name")[1:3]
+        book = Book.objects.prefetch_related(
+            Prefetch("first_time_authors", qs, to_attr="limited")
+        ).get(pk=self.fk_book1.pk)
+        self.assertEqual([a.name for a in book.limited], ["fk-d", "fk-c"])
+
+    def test_m2m_forward(self):
+        qs = Author.objects.filter(name__startswith="m2m-").order_by("-name")[1:3]
+        books = Book.objects.filter(
+            pk__in=[b.pk for b in self.m2m_books]
+        ).prefetch_related(Prefetch("authors", qs, to_attr="limited"))
+        for book in books:
+            self.assertEqual([a.name for a in book.limited], ["m2m-3", "m2m-2"])
+
+    def test_m2m_reverse(self):
+        qs = Book.objects.order_by("title")[:1]
+        authors = Author.objects.filter(
+            pk__in=[a.pk for a in self.authors]
+        ).prefetch_related(Prefetch("books", qs, to_attr="limited"))
+        for author in authors:
+            self.assertEqual([b.title for b in author.limited], ["m2m-0"])
+
+    def test_generic_relation(self):
+        for slice_ in [slice(None, 2), slice(1, 3), slice(3, None)]:
+            with self.subTest(slice=slice_):
+                qs = TaggedItem.objects.order_by("tag")[slice_]
+                bookmarks = Bookmark.objects.prefetch_related(
+                    Prefetch("tags", qs, to_attr="limited")
+                )
+                expected = list("abcde")[slice_]
+                for bookmark in bookmarks:
+                    self.assertEqual([t.tag for t in bookmark.limited], expected)
+
+    def test_generic_relation_ordering_desc(self):
+        qs = TaggedItem.objects.order_by("-tag")[:2]
+        for bookmark in Bookmark.objects.prefetch_related(
+            Prefetch("tags", qs, to_attr="limited")
+        ):
+            self.assertEqual([t.tag for t in bookmark.limited], ["e", "d"])
+

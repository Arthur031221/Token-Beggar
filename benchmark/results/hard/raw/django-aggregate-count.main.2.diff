diff --git a/tests/aggregation/tests.py b/tests/aggregation/tests.py
index 39c8a45707..3f88a7231d 100644
--- a/tests/aggregation/tests.py
+++ b/tests/aggregation/tests.py
@@ -2084,3 +2084,63 @@ class AggregateTestCase(TestCase):
             exists=Exists(Author.objects.extra(where=["1=0"])),
         )
         self.assertEqual(len(qs), 6)
+
+    def test_aggregation_unused_annotations_elided(self):
+        self.assertEqual(Book.objects.annotate(Count("authors")).count(), 6)
+        with CaptureQueriesContext(connection) as ctx:
+            self.assertEqual(
+                Book.objects.annotate(authors_count=Count("authors")).count(), 6
+            )
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertEqual(sql.count("count("), 1)
+        self.assertNotIn("authors_count", sql)
+
+    def test_aggregation_unused_non_aggregate_annotations_elided(self):
+        with CaptureQueriesContext(connection) as ctx:
+            self.assertEqual(
+                Book.objects.annotate(double_rating=F("rating") * 2).count(), 6
+            )
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertNotIn("double_rating", sql)
+        self.assertNotIn("select count(*) from (", sql)
+
+    def test_aggregation_unused_annotation_multivalued_join_count(self):
+        # The join introduced by an elided annotation must not affect results.
+        qs = Book.objects.annotate(author_name=F("authors__name"))
+        self.assertEqual(qs.count(), len(qs))
+        qs = Book.objects.annotate(
+            authors_count=Count("authors"), author_name=F("authors__name")
+        )
+        self.assertEqual(qs.count(), len(qs))
+
+    def test_aggregation_unused_annotation_filtered_against(self):
+        # Annotations referenced by filters are still applied.
+        qs = Book.objects.annotate(authors_count=Count("authors")).filter(
+            authors_count__gt=1
+        )
+        self.assertEqual(qs.count(), len(qs))
+        qs = Book.objects.alias(authors_count=Count("authors")).filter(
+            authors_count__gt=1
+        )
+        self.assertEqual(qs.count(), len(qs))
+
+    def test_aggregation_referenced_annotation_not_elided(self):
+        with CaptureQueriesContext(connection) as ctx:
+            result = Book.objects.annotate(
+                authors_count=Count("authors"),
+                unused_max=Max("authors__age"),
+            ).aggregate(Sum("authors_count"))
+        self.assertEqual(result["authors_count__sum"], 10)
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertIn("authors_count", sql)
+        self.assertNotIn("unused_max", sql)
+
+    def test_aggregation_values_annotation_grouping_preserved(self):
+        qs = (
+            Book.objects.values("publisher")
+            .annotate(books_count=Count("id"))
+            .annotate(contact_name=F("contact__name"))
+        )
+        self.assertEqual(qs.count(), len(qs))
+        qs = Book.objects.values("publisher").annotate(books_count=Count("id"))
+        self.assertEqual(qs.count(), len(qs))

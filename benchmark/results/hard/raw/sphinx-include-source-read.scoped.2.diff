+@pytest.mark.sphinx('html', testroot='directive-include')
+def test_include_source_read_event(app):
+    app.builder.build_all()
+    text = (app.outdir / 'index.html').read_text(encoding='utf8')
+    assert 'REPLACE_ME' not in text
+    assert '<p>included</p>\n<p>REPLACED</p>' in text  # include.rst
+    assert '<p>nested REPLACED</p>' in text  # nested.rst (included by include.rst)
+    assert text.count('REPLACED') == 3  # index.rst, include.rst, nested.rst

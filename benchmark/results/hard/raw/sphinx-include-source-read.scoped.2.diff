diff --git a/sphinx/directives/other.py b/sphinx/directives/other.py
index 19f7c0a8d..fbd6411cb 100644
--- a/sphinx/directives/other.py
+++ b/sphinx/directives/other.py
@@ -8,6 +8,7 @@ from docutils.parsers.rst import directives
 from docutils.parsers.rst.directives.admonitions import BaseAdmonition
 from docutils.parsers.rst.directives.misc import Class
 from docutils.parsers.rst.directives.misc import Include as BaseInclude
+from docutils.statemachine import StateMachine
 
 from sphinx import addnodes
 from sphinx.domains.changeset import VersionChange  # noqa: F401  # for compatibility
@@ -376,7 +377,35 @@ class Include(BaseInclude, SphinxDirective):
         rel_filename, filename = self.env.relfn2path(self.arguments[0])
         self.arguments[0] = filename
         self.env.note_included(filename)
-        return super().run()
+
+        if not self.env.app.events.listeners.get('source-read'):
+            return super().run()
+
+        # docutils re-reads the included file and inserts its raw lines via
+        # ``StateMachine.insert_input()``, so emit "source-read" for the
+        # included text here to let extensions modify it.
+        def _insert_input(include_lines: list[str], source: str) -> None:
+            # keep the end-of-inclusion marker appended by docutils
+            # out of the text passed to the event
+            marker: list[str] = []
+            if (len(include_lines) >= 2 and
+                    include_lines[-1].startswith('.. end of inclusion from')):
+                marker = include_lines[-2:]
+                include_lines = include_lines[:-2]
+
+            # included files that are not source documents (e.g. ``*.txt``)
+            # have no docname; use their path instead
+            docname = self.env.path2doc(source) or source
+            arg = ['\n'.join(include_lines)]
+            self.env.events.emit('source-read', docname, arg)
+            include_lines = arg[0].splitlines() + marker
+            StateMachine.insert_input(self.state_machine, include_lines, source)
+
+        self.state_machine.insert_input = _insert_input  # type: ignore[method-assign]
+        try:
+            return super().run()
+        finally:
+            del self.state_machine.insert_input
 
 

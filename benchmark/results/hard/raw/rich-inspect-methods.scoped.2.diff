         "╰──────────────────────────────────────────╯\n"
     )
     assert render(module, methods=True) == expected
+
+
+def test_inspect_methods_docstring_with_control_codes():
+    """Docstrings containing control codes must not break rendering."""
+
+    class Foo:
+        def method(self):
+            pass
+
+    Foo.method.__doc__ = "\x0b\x08bell " + "word \x0c" * 40 + "more words here to wrap"
+    console = Console(file=io.StringIO(), width=40, color_system=None)
+    inspect(Foo, methods=True, console=console)
+    assert "\x0c" not in console.file.getvalue()

     )
     assert Text("[bold]foo").markup == "\\[bold]foo"
+
+
+def test_text_length_with_control_codes():
+    text = Text("a\x0bb\x08c")
+    assert text.plain == "abc"
+    assert len(text) == 3
+    text.append("x")
+    text.stylize("bold", 0, 4)
+    assert [str(line) for line in text.wrap(Console(width=10), 10)] == ["abcx"]

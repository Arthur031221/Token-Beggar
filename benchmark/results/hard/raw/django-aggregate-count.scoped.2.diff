diff --git a/django/db/models/sql/where.py b/django/db/models/sql/where.py
index 1928ba91b8..12f689195d 100644
--- a/django/db/models/sql/where.py
+++ b/django/db/models/sql/where.py
@@ -190,6 +190,12 @@ class WhereNode(tree.Node):
     def get_source_expressions(self):
         return self.children[:]
 
+    def get_refs(self):
+        refs = set()
+        for child in self.children:
+            refs |= child.get_refs()
+        return refs
+
     def set_source_expressions(self, children):
         assert len(children) == len(self.children)
         self.children = children
diff --git a/docs/releases/4.2.txt b/docs/releases/4.2.txt
index 39cf05f23b..6cc816f322 100644
--- a/docs/releases/4.2.txt
+++ b/docs/releases/4.2.txt
@@ -219,6 +219,9 @@ Models
   :ref:`window-functions` with the exception of disjunctive filter lookups
   against window functions when performing aggregation.
 
+* ``QuerySet.count()`` and ``aggregate()`` now strip annotations that aren't
+  referenced by the computed aggregates from the generated query.
+
 * :meth:`~.QuerySet.prefetch_related` now supports
   :class:`~django.db.models.Prefetch` objects with sliced querysets.
 

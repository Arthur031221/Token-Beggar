@@ -28,6 +28,7 @@ from django.db.models import (
     Value,
     Variance,
     When,
+    Window,
 )
 from django.db.models.expressions import Func, RawSQL
 from django.db.models.functions import (
@@ -36,6 +37,7 @@ from django.db.models.functions import (
     Greatest,
     Now,
     Pi,
+    Rank,
     TruncDate,
     TruncHour,
 )
@@ -2084,3 +2086,55 @@ class AggregateTestCase(TestCase):
             exists=Exists(Author.objects.extra(where=["1=0"])),
         )
         self.assertEqual(len(qs), 6)
+
+    def test_unused_annotation_pruned_from_count(self):
+        with CaptureQueriesContext(connection) as ctx:
+            cnt = Book.objects.annotate(Count("authors")).count()
+        self.assertEqual(cnt, Book.objects.count())
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertEqual(sql.count("count("), 1)
+        self.assertNotIn("authors__count", sql)
+
+    def test_unused_multivalued_annotation_pruned_from_count(self):
+        qs = Book.objects.annotate(author_name=F("authors__name"))
+        with CaptureQueriesContext(connection) as ctx:
+            cnt = qs.count()
+        self.assertEqual(cnt, len(qs))
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertNotIn("author_name", sql)
+
+    def test_unused_annotation_pruned_from_aggregate(self):
+        with CaptureQueriesContext(connection) as ctx:
+            result = Book.objects.annotate(
+                authors_count=Count("authors"),
+            ).aggregate(Sum("pages"))
+        self.assertEqual(result, Book.objects.aggregate(Sum("pages")))
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertNotIn("authors_count", sql)
+
+    def test_referenced_annotation_kept_in_aggregate(self):
+        with CaptureQueriesContext(connection) as ctx:
+            result = Book.objects.annotate(
+                authors_count=Count("authors", distinct=True),
+                stores_count=Count("store", distinct=True),
+            ).aggregate(Sum("authors_count"))
+        expected = sum(book.authors.count() for book in Book.objects.all())
+        self.assertEqual(result, {"authors_count__sum": expected})
+        sql = ctx.captured_queries[0]["sql"].lower()
+        self.assertIn("authors_count", sql)
+        self.assertNotIn("stores_count", sql)
+
+    def test_referenced_aggregate_annotation_kept_in_count_filter(self):
+        qs = Book.objects.annotate(authors_count=Count("authors")).filter(
+            authors_count__gt=1
+        )
+        expected = sum(1 for book in Book.objects.all() if book.authors.count() > 1)
+        self.assertGreater(expected, 0)
+        self.assertEqual(qs.count(), expected)
+
+    @skipUnlessDBFeature("supports_over_clause")
+    def test_referenced_window_annotation_kept_in_count_filter(self):
+        qs = Book.objects.annotate(
+            rank=Window(Rank(), order_by=F("pages").asc()),
+        ).filter(rank__lte=2)
+        self.assertEqual(qs.count(), len(qs))

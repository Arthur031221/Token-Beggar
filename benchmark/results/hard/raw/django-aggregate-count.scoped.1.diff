diff --git a/tests/aggregation/tests.py b/tests/aggregation/tests.py
index 39c8a45707..20010a42db 100644
--- a/tests/aggregation/tests.py
+++ b/tests/aggregation/tests.py
@@ -2084,3 +2084,61 @@ class AggregateTestCase(TestCase):
             exists=Exists(Author.objects.extra(where=["1=0"])),
         )
         self.assertEqual(len(qs), 6)
+
+    def test_unreferenced_aggregate_annotation_pruned(self):
+        with CaptureQueriesContext(connection) as ctx:
+            count = Book.objects.annotate(n=Count("authors")).count()
+        self.assertEqual(count, Book.objects.count())
+        sql = ctx.captured_queries[0]["sql"].upper()
+        self.assertEqual(sql.count("COUNT("), 1)
+
+    def test_non_aggregate_annotation_pruned(self):
+        with CaptureQueriesContext(connection) as ctx:
+            count = Book.objects.annotate(x=F("pages") + 1).count()
+        self.assertEqual(count, Book.objects.count())
+        sql = ctx.captured_queries[0]["sql"]
+        self.assertNotIn("SELECT COUNT(*) FROM (", sql.upper())
+        self.assertNotIn("pages", sql)
+
+    def test_unused_aliased_aggregate_pruned(self):
+        with CaptureQueriesContext(connection) as ctx:
+            result = Book.objects.annotate(n=Count("authors")).aggregate(
+                total=Count("*")
+            )
+        self.assertEqual(result, {"total": Book.objects.count()})
+        self.assertEqual(ctx.captured_queries[0]["sql"].upper().count("COUNT("), 1)
+
+    def test_referenced_aggregate_annotation_kept(self):
+        qs = Book.objects.annotate(authors_count=Count("authors"))
+        expected = [b.authors.count() for b in Book.objects.all()]
+        self.assertEqual(
+            qs.aggregate(avg=Avg("authors_count"))["avg"],
+            sum(expected) / len(expected),
+        )
+
+    def test_filter_on_aggregate_annotation_count(self):
+        qs = Book.objects.annotate(n=Count("authors")).filter(n__gt=1)
+        expected = len([b for b in Book.objects.all() if b.authors.count() > 1])
+        self.assertEqual(qs.count(), expected)
+
+    def test_annotation_referenced_by_group_by_kept(self):
+        qs = (
+            Book.objects.annotate(rating_int=F("rating") * 10)
+            .values("rating_int")
+            .annotate(n=Count("id"))
+        )
+        self.assertEqual(qs.count(), len(qs))
+
+    def test_aggregate_over_subquery_annotation(self):
+        subquery = (
+            Book.objects.filter(publisher=OuterRef("pk"))
+            .order_by()
+            .values("publisher")
+            .annotate(total=Sum("pages"))
+            .values("total")
+        )
+        publishers = Publisher.objects.annotate(pages=Subquery(subquery))
+        self.assertEqual(
+            publishers.aggregate(total=Sum("pages"))["total"],
+            sum(publisher.pages or 0 for publisher in publishers),
+        )

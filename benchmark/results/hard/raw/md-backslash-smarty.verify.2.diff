+class TestUnescape(unittest.TestCase):
+    """ Tests restoring escaped characters. """
+
+    def testUnescapeTreeprocessorAttributes(self):
+        """ Test that escaped chars in attributes are restored before serialization. """
+        md = markdown.Markdown()
+        el = etree.Element('img')
+        el.set('alt', 'x{}34{}x'.format(markdown.util.STX, markdown.util.ETX))
+        el.tail = 'a{}60{}b'.format(markdown.util.STX, markdown.util.ETX)
+        markdown.treeprocessors.UnescapeTreeprocessor(md).run(el)
+        self.assertEqual(el.get('alt'), 'x"x')
+        self.assertEqual(el.tail, 'a<b')
+        self.assertEqual(md.serializer(el), '<img alt="x&quot;x" />a&lt;b')
+
+    def testUnescapePostprocessorDeprecated(self):
+        """ Test that UnescapePostprocessor raises a DeprecationWarning. """
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter('always')
+            p = markdown.postprocessors.UnescapePostprocessor()
+            self.assertEqual(len(w), 1)
+            self.assertTrue(issubclass(w[-1].category, DeprecationWarning))
+        self.assertEqual(p.run('x{}34{}x'.format(markdown.util.STX, markdown.util.ETX)), 'x"x')
+
+

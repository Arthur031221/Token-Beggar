--- a/tests/test_syntax/extensions/test_footnotes.py
+++ b/tests/test_syntax/extensions/test_footnotes.py
@@ -336,3 +336,80 @@ class TestFootnotes(TestCase):
             '</div>',
             extension_configs={'footnotes': {'SUPERSCRIPT_TEXT': '[{}]'}}
         )
+
+    def _fn(self, id, n, body, refs=('',), nested=''):
+        return (
+            '<li id="fn:%s">\n<p>%s%s&#160;' % (id, body, nested)
+            + ''.join(
+                '<a class="footnote-backref" href="#fnref%s:%s" title="Jump back to footnote %d in the text">'
+                '&#8617;</a>' % (r, id, n) for r in refs
+            )
+            + '</p>\n</li>\n'
+        )
+
+    def test_reference_order(self):
+        """Footnotes are numbered and listed by order of first reference."""
+        text = (
+            'It seems defined[^definedsecond] rather than occurrence[^definedfirst].\n\n'
+            '[^definedfirst]: blah\n[^definedsecond]: blurb\n'
+        )
+        self.assertMarkdownRenders(
+            text,
+            '<p>It seems defined<sup id="fnref:definedsecond"><a class="footnote-ref" href="#fn:definedsecond">1</a>'
+            '</sup> rather than occurrence<sup id="fnref:definedfirst"><a class="footnote-ref" '
+            'href="#fn:definedfirst">2</a></sup>.</p>\n'
+            '<div class="footnote">\n<hr />\n<ol>\n'
+            + self._fn('definedsecond', 1, 'blurb') + self._fn('definedfirst', 2, 'blah')
+            + '</ol>\n</div>'
+        )
+
+    def test_use_definition_order(self):
+        """USE_DEFINITION_ORDER restores definition order."""
+        text = (
+            'It seems defined[^definedsecond] rather than occurrence[^definedfirst].\n\n'
+            '[^definedfirst]: blah\n[^definedsecond]: blurb\n'
+        )
+        self.assertMarkdownRenders(
+            text,
+            '<p>It seems defined<sup id="fnref:definedsecond"><a class="footnote-ref" href="#fn:definedsecond">2</a>'
+            '</sup> rather than occurrence<sup id="fnref:definedfirst"><a class="footnote-ref" '
+            'href="#fn:definedfirst">1</a></sup>.</p>\n'
+            '<div class="footnote">\n<hr />\n<ol>\n'
+            + self._fn('definedfirst', 1, 'blah') + self._fn('definedsecond', 2, 'blurb')
+            + '</ol>\n</div>',
+            extension_configs={'footnotes': {'USE_DEFINITION_ORDER': True}}
+        )
+
+    def test_reference_order_multiple_refs(self):
+        """Multiple references to one footnote keep its first-reference number."""
+        self.assertMarkdownRenders(
+            'a[^b] c[^a] d[^b]\n\n[^a]: A\n[^b]: B\n',
+            '<p>a<sup id="fnref:b"><a class="footnote-ref" href="#fn:b">1</a></sup> '
+            'c<sup id="fnref:a"><a class="footnote-ref" href="#fn:a">2</a></sup> '
+            'd<sup id="fnref2:b"><a class="footnote-ref" href="#fn:b">1</a></sup></p>\n'
+            '<div class="footnote">\n<hr />\n<ol>\n'
+            + self._fn('b', 1, 'B', refs=('', '2')) + self._fn('a', 2, 'A')
+            + '</ol>\n</div>'
+        )
+
+    def test_reference_order_unreferenced(self):
+        """Unreferenced footnotes are listed last, in definition order."""
+        self.assertMarkdownRenders(
+            'a[^c]\n\n[^a]: A\n[^b]: B\n[^c]: C\n',
+            '<p>a<sup id="fnref:c"><a class="footnote-ref" href="#fn:c">1</a></sup></p>\n'
+            '<div class="footnote">\n<hr />\n<ol>\n'
+            + self._fn('c', 1, 'C') + self._fn('a', 2, 'A') + self._fn('b', 3, 'B')
+            + '</ol>\n</div>'
+        )
+
+    def test_reference_order_nested(self):
+        """References inside footnotes are numbered after the containing footnote."""
+        self.assertMarkdownRenders(
+            'a[^b] c[^a]\n\n[^a]: A\n[^b]: B[^d]\n[^d]: D\n',
+            '<p>a<sup id="fnref:b"><a class="footnote-ref" href="#fn:b">1</a></sup> '
+            'c<sup id="fnref:a"><a class="footnote-ref" href="#fn:a">2</a></sup></p>\n'
+            '<div class="footnote">\n<hr />\n<ol>\n'
+            + self._fn('b', 1, 'B', nested='<sup id="fnref:d"><a class="footnote-ref" href="#fn:d">3</a></sup>')
+            + self._fn('a', 2, 'A') + self._fn('d', 3, 'D')
+            + '</ol>\n</div>'
+        )

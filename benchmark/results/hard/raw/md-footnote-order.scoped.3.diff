+class FootnoteReorderingProcessor(Treeprocessor):
+    """ Number and order footnotes by the order of their first reference. """
+
+    def __init__(self, footnotes: FootnoteExtension):
+        self.footnotes = footnotes
+
+    def run(self, root: etree.Element) -> None:
+        fn = self.footnotes
+        div = fn.footnotes_div
+        if fn.getConfig('USE_DEFINITION_ORDER') or div is None:
+            return
+        ol = div.find('ol')
+        if ol is None:
+            return
+
+        # Map footnote ids to their `li` and to their link target.
+        items = {li.get('id'): li for li in ol}
+        lis = {}
+        hrefs = {}
+        for id in fn.footnotes.keys():
+            fid = fn.makeFootnoteId(id)
+            hrefs['#' + fid] = id
+            if fid in items:
+                lis[id] = items[fid]
+
+        order: list[str] = []
+        refs: list[tuple[etree.Element, str]] = []
+
+        def scan(el: etree.Element, skip: etree.Element | None = None) -> None:
+            for child in el:
+                if child is skip:
+                    continue
+                if (
+                    child.tag == 'a' and child.get('class') == 'footnote-ref'
+                    and child.get('href') in hrefs
+                ):
+                    id = hrefs[child.get('href')]
+                    refs.append((child, id))
+                    if id not in order:
+                        order.append(id)
+                scan(child, skip)
+
+        # References in the body come first, in document order.
+        scan(root, div)
+        # References within footnotes follow, in footnote order. Unreferenced
+        # footnotes are appended in definition order.
+        pending = [id for id in fn.footnotes.keys() if id in lis]
+        i = 0
+        while True:
+            while i < len(order):
+                if order[i] in lis:
+                    scan(lis[order[i]])
+                i += 1
+            rest = [id for id in pending if id not in order]
+            if not rest:
+                break
+            order.append(rest[0])
+
+        numbers = {id: n for n, id in enumerate(order, start=1)}
+        for a, id in refs:
+            a.text = fn.getConfig("SUPERSCRIPT_TEXT").format(numbers[id])
+
+        backlink_title = fn.getConfig("BACKLINK_TITLE").replace("%d", "{}")
+        for id in order:
+            if id in lis:
+                for a in lis[id].iter('a'):
+                    if a.get('class') == 'footnote-backref':
+                        a.set('title', backlink_title.format(numbers[id]))
+                        break
+        for li in list(ol):
+            ol.remove(li)
+        for id in order:
+            if id in lis:
+                ol.append(lis[id])
+
+
 class FootnotePostTreeprocessor(Treeprocessor):
     """ Amend footnote div with duplicates. """
 
diff --git a/tests/test_syntax/extensions/test_footnotes.py b/tests/test_syntax/extensions/test_footnotes.py

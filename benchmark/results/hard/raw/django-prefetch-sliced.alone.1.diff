+def _filter_prefetch_queryset(queryset, predicate, partition_by):
+    """
+    Filter a prefetch queryset by the given predicate. If the queryset is
+    sliced, the slice is applied to each group of related objects (identified
+    by the partition_by expressions) using a ROW_NUMBER() window function
+    instead of to the queryset as a whole.
+    """
+    if not isinstance(partition_by, (list, tuple)):
+        partition_by = [partition_by]
+    db = queryset._db or DEFAULT_DB_ALIAS
+    if queryset.query.is_sliced:
+        if not connections[db].features.supports_over_clause:
+            raise NotSupportedError(
+                "Prefetching from a limited queryset is only supported on backends "
+                "that support window functions."
+            )
+        low_mark, high_mark = queryset.query.low_mark, queryset.query.high_mark
+        order_by = [
+            expr for expr, _ in queryset.query.get_compiler(using=db).get_order_by()
+        ]
+        window = Window(RowNumber(), partition_by=partition_by, order_by=order_by)
+        predicate &= GreaterThan(window, low_mark)
+        if high_mark is not None:
+            predicate &= LessThanOrEqual(window, high_mark)
+        queryset.query.clear_limits()
+    return queryset.filter(predicate)
+

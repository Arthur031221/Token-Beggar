+
+
+@pytest.mark.parametrize("exc_info", [True, (None, None, None)])
+def test_dict_tracebacks_outside_exception_handler(exc_info: Any) -> None:
+    """
+    Using dict_tracebacks outside of an exception handler -- e.g., when
+    calling log.exception() without an active exception -- results in an
+    empty list of stacks instead of an error.
+    """
+    assert sys.exc_info() == (None, None, None)
+
+    ed = dict_tracebacks(None, "exception", {"exc_info": exc_info})
+
+    assert {"exception": []} == ed
+
+
+def test_stdlib_exception_outside_exception_handler() -> None:
+    """
+    A stdlib logger that uses ProcessorFormatter with dict_tracebacks can log
+    using exception() outside of an exception handler.
+    """
+    sio = io.StringIO()
+    handler = logging.StreamHandler(sio)
+    handler.setFormatter(
+        ProcessorFormatter(processors=[dict_tracebacks, JSONRenderer()])
+    )
+    logger = logging.Logger(
+        "test_stdlib_exception_outside_exception_handler", logging.DEBUG
+    )
+    logger.addHandler(handler)
+
+    logger.exception("oh no")  # noqa: LOG004
+
+    out = json.loads(sio.getvalue())
+
+    assert "oh no" == out["event"]
+    assert [] == out["exception"]

 from io import BufferedReader, BytesIO
 from typing import (
     TYPE_CHECKING,
@@ -253,6 +253,36 @@ def _check_csv(value: list[str] | tuple[str] | str) -> Sequence[str]:
     return _splitstrip(value)
 
 
+def _check_regexp_csv(value: list[str] | tuple[str] | str) -> Iterable[str]:
+    r"""Split a comma-separated list of regexps, ignoring commas inside braces.
+
+    Lists and tuples are returned as is. Pieces are stripped, empty ones skipped.
+
+    >>> list(_check_regexp_csv("(foo{1,3}), bar"))
+    ['(foo{1,3})', 'bar']
+    """
+    if isinstance(value, (list, tuple)):
+        yield from value
+        return
+    depth = 0
+    current: list[str] = []
+    for char in value:
+        if char == "{":
+            depth += 1
+        elif char == "}" and depth:
+            depth -= 1
+        if char == "," and depth == 0:
+            piece = "".join(current).strip()
+            if piece:
+                yield piece
+            current = []
+        else:
+            current.append(char)
+    piece = "".join(current).strip()
+    if piece:
+        yield piece
+
+
 def _comment(string: str) -> str:
     """Return string as a comment."""
     lines = [line.strip() for line in string.splitlines()]

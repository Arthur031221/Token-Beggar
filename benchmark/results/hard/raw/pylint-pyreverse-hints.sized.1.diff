+# Type annotations (PEP 484) ##################################################
+
+
+def _annotated_arguments(arguments):
+    """return (argument, annotation) pairs of an astroid.Arguments node"""
+    return zip(
+        (arguments.posonlyargs or [])
+        + (arguments.args or [])
+        + (arguments.kwonlyargs or []),
+        (arguments.posonlyargs_annotations or [])
+        + (arguments.annotations or [])
+        + (arguments.kwonlyargs_annotations or []),
+    )
+
+
+def _get_argument_annotation(arguments, name):
+    """return the annotation of the argument `name`, or None"""
+    for arg, annotation in _annotated_arguments(arguments):
+        if arg.name == name:
+            return annotation
+    return None
+
+
+def is_annotation(node):
+    """return true if the given node is the type annotation of a variable,
+    attribute or function argument
+    """
+    parent = getattr(node, "parent", None)
+    if isinstance(parent, astroid.AnnAssign):
+        return parent.annotation is node
+    if isinstance(parent, astroid.Arguments):
+        return any(ann is node for _, ann in _annotated_arguments(parent))
+    return False
+
+
+def _get_annotation_default(annotation):
+    """return the value assigned to the name annotated by `annotation`, or None"""
+    parent = annotation.parent
+    if isinstance(parent, astroid.AnnAssign):
+        return parent.value
+    if isinstance(parent, astroid.Arguments):
+        for arg, ann in _annotated_arguments(parent):
+            if ann is annotation:
+                try:
+                    return parent.default_value(arg.name)
+                except astroid.NoDefault:
+                    return None
+    return None
+
+
+def get_annotation_label(annotation):
+    """return the text used to display a type annotation
+
+    An annotation whose default value is None is shown as ``Optional[...]``.
+    """
+    if isinstance(annotation, astroid.Const) and isinstance(annotation.value, str):
+        # string annotation, used for forward references
+        label = annotation.value
+    else:
+        label = annotation.as_string()
+    default = _get_annotation_default(annotation)
+    if (
+        isinstance(default, astroid.Const)
+        and default.value is None
+        and not label.startswith("Optional[")
+        and not re.search(r"\bNone\b", label)
+    ):
+        label = f"Optional[{label}]"
+    return label
+
+
+def get_annotation(node):
+    """return the type annotation of an astroid.AssignName or astroid.AssignAttr
+    node, or None if it has none
+
+    Besides explicit variable annotations (``x: int = 0``), an attribute
+    assigned from an annotated argument of the enclosing method
+    (``def __init__(self, x: int): self.x = x``) uses the argument annotation.
+    """
+    parent = node.parent
+    if isinstance(parent, astroid.AnnAssign):
+        return parent.annotation
+    if isinstance(parent, astroid.Arguments):
+        return _get_argument_annotation(parent, node.name)
+    if (
+        isinstance(node, astroid.AssignAttr)
+        and isinstance(parent, astroid.Assign)
+        and isinstance(parent.value, astroid.Name)
+    ):
+        frame = node.frame()
+        if isinstance(frame, astroid.FunctionDef):
+            return _get_argument_annotation(frame.args, parent.value.name)
+    return None
+
+
+def infer_annotation(annotation):
+    """return the class node a simple type annotation refers to, or None"""
+    if not isinstance(annotation, (astroid.Name, astroid.Attribute)):
+        return None
+    try:
+        inferred = next(annotation.infer())
+    except (astroid.InferenceError, StopIteration):
+        return None
+    if isinstance(inferred, astroid.ClassDef):
+        return inferred
+    return None
+
+
+def infer_node(node):
+    """return the set of types of an astroid.AssignName or astroid.AssignAttr
+    node: its type annotation if it has one, else the inferred values
+    """
+    annotation = get_annotation(node)
+    if annotation is not None:
+        return {annotation}
+    try:
+        return set(node.infer())
+    except astroid.InferenceError:
+        return set()
+
+
 # Helpers #####################################################################
 
 _CONSTRUCTOR = 1

@@ -0,0 +1,165 @@
+# Licensed under the GPL: https://www.gnu.org/licenses/old-licenses/gpl-2.0.html
+# For details: https://github.com/PyCQA/pylint/blob/master/LICENSE
+
+"""Tests for the use of type annotations (PEP 484) by pyreverse"""
+
+import astroid
+import pytest
+from unittest_pyreverse_writer import Config
+
+from pylint.pyreverse import utils
+from pylint.pyreverse.diagrams import ClassDiagram, DiagramEntity
+from pylint.pyreverse.inspector import Linker
+from pylint.pyreverse.writer import DotWriter
+
+CODE = '''
+from typing import List, Optional, Union
+
+
+class Other:
+    pass
+
+
+class C:
+    cls_attr: int = 3
+    forward: "Other"
+
+    def __init__(
+        self,
+        a: str = None,
+        b: Other = None,
+        c: List[int] = None,
+        d=0,
+        e: Optional[int] = None,
+        f: Union[int, None] = None,
+        g: int = 1,
+    ):
+        self.a = a
+        self.b = b
+        self.c = c
+        self.d = d
+        self.e = e
+        self.f = f
+        self.g = g
+        self.h: Other = Other()
+
+    def method(self, x: int, y, z: "int | str" = None) -> List[str]:
+        return []
+'''
+
+
+@pytest.fixture
+def module():
+    module = astroid.parse(CODE)
+    Linker(None).visit(module)
+    return module
+
+
+def test_get_annotation_label():
+    assign_name = astroid.extract_node("a: str = None")
+    assert utils.get_annotation_label(assign_name.annotation) == "Optional[str]"
+    assign_name = astroid.extract_node("a: Optional[str] = None")
+    assert utils.get_annotation_label(assign_name.annotation) == "Optional[str]"
+    assign_name = astroid.extract_node("a: Union[str, None] = None")
+    assert utils.get_annotation_label(assign_name.annotation) == "Union[str, None]"
+    assign_name = astroid.extract_node("a: List[str] = []")
+    assert utils.get_annotation_label(assign_name.annotation) == "List[str]"
+    assign_name = astroid.extract_node("a: 'Foo'")
+    assert utils.get_annotation_label(assign_name.annotation) == "Foo"
+    func = astroid.extract_node("def f(a: int, b: str = None) -> bool: pass")
+    first, second = func.args.annotations
+    assert utils.get_annotation_label(first) == "int"
+    assert utils.get_annotation_label(second) == "Optional[str]"
+    assert utils.get_annotation_label(func.returns) == "bool"
+
+
+def test_get_annotation():
+    func = astroid.extract_node(
+        """
+    def __init__(self, a: int, /, b: str, *, c: bool, d):
+        self.a = a
+        self.b = b
+        self.c = c
+        self.d = d
+        self.e: float = d
+        self.f = a + 1
+    """
+    )
+    assign_attrs = {
+        node.attrname: node for node in func.nodes_of_class(astroid.AssignAttr)
+    }
+    labels = {
+        name: utils.get_annotation(node) and utils.get_annotation(node).as_string()
+        for name, node in assign_attrs.items()
+    }
+    assert labels == {
+        "a": "int",
+        "b": "str",
+        "c": "bool",
+        "d": None,
+        "e": "float",
+        "f": None,
+    }
+
+
+def test_infer_node_without_annotation():
+    assign_name = astroid.extract_node("a = 1 #@").targets[0]
+    (inferred,) = utils.infer_node(assign_name)
+    assert isinstance(inferred, astroid.Const)
+    assert inferred.value == 1
+
+
+def test_annotations_in_locals_and_instance_attrs(module):
+    klass = module["C"]
+    instance_attrs = {
+        name: [node.as_string() for node in nodes]
+        for name, nodes in klass.instance_attrs_type.items()
+    }
+    assert instance_attrs["a"] == ["str"]
+    assert instance_attrs["c"] == ["List[int]"]
+    assert instance_attrs["h"] == ["Other"]
+    # d is not annotated, its type is inferred
+    assert "builtins.int" in [
+        node.pytype()
+        for node in klass.instance_attrs_type["d"]
+        if node is not astroid.Uninferable
+    ]
+    assert [node.as_string() for node in klass.locals_type["cls_attr"]] == ["int"]
+
+
+def test_class_diagram_attributes(module):
+    diagram = ClassDiagram("classes", "ALL")
+    diagram.add_object("C", module["C"])
+    diagram.add_object("Other", module["Other"])
+    diagram.extract_relationships()
+    assert diagram.get_attrs(module["C"]) == [
+        # b and h are shown as associations with the Other class
+        "a : Optional[str]",
+        "b",
+        "c : Optional[List[int]]",
+        "cls_attr : int",
+        "d : int",
+        "e : Optional[int]",
+        "f : Union[int, None]",
+        "forward : Other",
+        "g : int",
+        "h",
+    ]
+    associations = {
+        rel.name
+        for rel in diagram.relationships["association"]
+        if rel.from_object.node is module["Other"]
+    }
+    assert associations == {"b", "h"}
+
+
+def test_dot_writer_method_signature(module):
+    klass = module["C"]
+    entity = DiagramEntity("C", klass)
+    entity.shape = "class"
+    entity.attrs = ["g : int | str"]
+    entity.methods = [klass["method"]]
+    values = DotWriter(Config()).get_values(entity)
+    assert values["label"] == (
+        r"{C|g : int \| str\l|method(x: int, y, z: Optional[int \| str]): List[str]\l}"
+    )

+def test_pyproperty_classmethod(app):
+    text = (".. py:class:: Class\n"
+            "\n"
+            "   .. py:property:: prop\n"
+            "      :abstractmethod:\n"
+            "      :classmethod:\n"
+            "      :type: str\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    assert_node(doctree[1][1][1], ([desc_signature, ([desc_annotation,
+                                                      "abstract class property "],
+                                                     [desc_name, "prop"],
+                                                     [desc_annotation, ": str"])],
+                                   [desc_content, ()]))
+    assert domain.objects['Class.prop'] == ('index', 'Class.prop', 'property', False)
+
+

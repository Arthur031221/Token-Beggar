+def get_classmethod_property(cls: Any, name: str) -> Optional[property]:
+    """Get the property wrapped by a classmethod (``@classmethod`` + ``@property``).
+
+    Since Python 3.9, a classmethod can wrap other descriptors.  In that case,
+    ``getattr(cls, name)`` returns the value of the property, so the property
+    object itself is looked up from ``__dict__`` of the class and its bases.
+    """
+    if not name:
+        return None
+
+    placeholder = object()
+    for basecls in inspect.getmro(cls):
+        obj = safe_getattr(basecls, '__dict__', {}).get(name, placeholder)
+        if obj is not placeholder:
+            if isinstance(obj, classmethod) and inspect.isproperty(obj.__func__):
+                return obj.__func__
+            else:
+                return None
+
+    return None
+
+

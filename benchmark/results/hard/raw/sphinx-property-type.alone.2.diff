diff --git a/tests/roots/test-ext-autodoc/target/classproperties.py b/tests/roots/test-ext-autodoc/target/classproperties.py
new file mode 100644
index 000000000..e8171457a
--- /dev/null
+++ b/tests/roots/test-ext-autodoc/target/classproperties.py
@@ -0,0 +1,25 @@
+# NOTE: classmethods wrapping properties are available since Python 3.9.
+
+
+class Foo:
+    """docstring"""
+
+    @property
+    def prop(self) -> int:
+        """docstring"""
+
+    @classmethod
+    @property
+    def class_prop(cls) -> int:
+        """class property docstring"""
+        return 1
+
+
+class Bar(Foo):
+    """docstring"""
+
+    @classmethod
+    @property
+    def bar_prop(cls) -> str:
+        """bar class property docstring"""
+        return 'bar'

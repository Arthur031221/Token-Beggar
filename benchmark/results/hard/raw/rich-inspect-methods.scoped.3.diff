         "╰──────────────────────────────────────────╯\n"
     )
     assert render(module, methods=True) == expected
+
+
+def test_inspect_method_docstring_with_control_codes():
+    """Regression test: control codes in docstrings should not break rendering."""
+
+    class Thing:
+        def method(self):
+            pass
+
+    Thing.method.__doc__ = "First line\x0c\r\n\x0bsecond\x08 line\n\n\tindented"
+    output = render(Thing, methods=True)
+    assert "First line" in output
+    assert "second line" in output
+    assert "\x0c" not in output and "\x0b" not in output
+    console = Console(file=io.StringIO(), width=40, legacy_windows=False)
+    inspect(Thing, console=console, all=True, help=True)
+    assert "indented" in console.file.getvalue()
diff --git a/tests/test_text.py b/tests/test_text.py
index 4f02fd4..46d5638 100644
--- a/tests/test_text.py
+++ b/tests/test_text.py
@@ -747,3 +747,13 @@ def test_markup_property():
         == "[bold]foo [italic]bar[/bold] baz[/italic]"
     )
     assert Text("[bold]foo").markup == "\\[bold]foo"
+
+
+def test_control_codes_length():
+    text = Text("a\x0cb\rc\x08d")
+    assert text.plain == "abcd"
+    assert len(text) == 4
+    text.stylize("bold")
+    assert text.spans == [Span(0, 4, "bold")]
+    lines = text.divide([2])
+    assert [line.plain for line in lines] == ["ab", "cd"]

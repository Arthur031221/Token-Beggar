+
+def test_integer_implies_finite():
+    for kw in ('integer', 'even', 'odd', 'prime', 'composite'):
+        m = Symbol('m', **{kw: True})
+        assert m.is_finite is True
+        assert m.is_infinite is False
+    # an infinite symbol cannot be an integer
+    x = Symbol('x', infinite=True)
+    assert x.is_integer is False
+    assert x.is_even is False
+    assert x.is_odd is False
+    assert x.is_prime is False
+    assert x.is_composite is False

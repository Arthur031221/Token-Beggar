Output assets/demo.gif
Set Shell "bash"
Set FontSize 17
Set Width 1180
Set Height 700
Set Padding 24
Set Theme { "name": "beggar", "background": "#2b2118", "foreground": "#fbf3e4", "cursor": "#c8742b", "black": "#2b2118", "red": "#d9534f", "green": "#9bbf6a", "yellow": "#e0a84f", "blue": "#7aa6c2", "magenta": "#b88ab0", "cyan": "#7fbfb0", "white": "#fbf3e4", "brightBlack": "#7a6a58", "brightRed": "#e8786f", "brightGreen": "#b3d68a", "brightYellow": "#f0c070", "brightBlue": "#9bc0d6", "brightMagenta": "#cfa4c8", "brightCyan": "#9fd4c8", "brightWhite": "#ffffff" }
Set TypingSpeed 35ms
Set PlaybackSpeed 1.0
Hide
Type "export PS1='$ ' && clear"
Enter
Hide
Show
Type "sh demo/demo.sh 1"
Enter
Sleep 3.5s
Type "clear"
Enter
Type "sh demo/demo.sh 2"
Enter
Sleep 5s
Type "clear"
Enter
Type "sh demo/demo.sh 3"
Enter
Sleep 5s
Type "clear"
Enter
Type "sh demo/demo.sh 4"
Enter
Sleep 7s
